---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageContainer from "@/components/layout/PageContainer.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import Icon from "@/components/Icon.astro";
import { siteConfig } from "@/config/site";

const path = "/iletisim/";
---

<BaseLayout
  title="İletişim"
  description="illerilceler.com ile iletişime geçin."
  path={path}
>
  <PageContainer class="py-4">
    <Breadcrumbs items={[{ label: "İletişim", href: path }]} />
  </PageContainer>

  <PageContainer class="pb-16">
    <div class="mx-auto max-w-2xl">
      <h1 class="text-3xl font-extrabold text-text-primary sm:text-4xl">
        İletişim
      </h1>
      <p class="prose-content mt-3">
        Sorularınız, geri bildirimleriniz veya veri düzeltme talepleriniz için
        bize aşağıdaki formdan ya da doğrudan e-posta yoluyla ulaşabilirsiniz.
      </p>

      <div
        class="mt-6 flex items-center gap-3 rounded-2xl border border-border bg-surface-muted p-4"
      >
        <span
          class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-brand-purple-soft text-brand-primary"
        >
          <Icon name="mail" size={20} />
        </span>
        <div>
          <p class="text-xs text-text-muted">E-posta</p>
          <a
            href={`mailto:${siteConfig.contactEmail}`}
            class="text-sm font-bold text-text-primary hover:text-brand-primary"
          >
            {siteConfig.contactEmail}
          </a>
        </div>
      </div>

      <form id="contact-form" class="mt-8 flex flex-col gap-4">
        <div>
          <label
            for="contact-name"
            class="mb-1.5 block text-xs font-semibold text-text-muted"
            >Ad Soyad</label
          >
          <input
            id="contact-name"
            name="name"
            type="text"
            required
            class="h-11 w-full rounded-xl border border-border bg-surface px-3.5 text-sm text-text-primary outline-none focus:border-brand-primary"
          />
        </div>
        <div>
          <label
            for="contact-email"
            class="mb-1.5 block text-xs font-semibold text-text-muted"
            >E-posta</label
          >
          <input
            id="contact-email"
            name="email"
            type="email"
            required
            class="h-11 w-full rounded-xl border border-border bg-surface px-3.5 text-sm text-text-primary outline-none focus:border-brand-primary"
          />
        </div>
        <div>
          <label
            for="contact-message"
            class="mb-1.5 block text-xs font-semibold text-text-muted"
            >Mesajınız</label
          >
          <textarea
            id="contact-message"
            name="message"
            rows="5"
            required
            class="w-full rounded-xl border border-border bg-surface px-3.5 py-2.5 text-sm text-text-primary outline-none focus:border-brand-primary"
          ></textarea>
        </div>
        <p
          id="contact-form-error"
          class="hidden text-sm font-medium text-brand-red"
        >
          Lütfen tüm alanları doldurun.
        </p>
        <button type="submit" class="btn btn-primary self-start">
          <Icon name="send" size={15} />
          Gönder
        </button>
        <p class="text-xs text-text-muted">
          Gönder butonuna bastığınızda varsayılan e-posta uygulamanız
          mesajınızla birlikte açılır.
        </p>
      </form>
    </div>
  </PageContainer>
</BaseLayout>

<script define:vars={{ contactEmail: siteConfig.contactEmail }} is:inline>
  window.__contactEmail = contactEmail;
</script>
<script>
  const form = document.getElementById(
    "contact-form",
  ) as HTMLFormElement | null;
  const errorEl = document.getElementById("contact-form-error");
  const email = (window as unknown as { __contactEmail: string })
    .__contactEmail;

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const name = (
      document.getElementById("contact-name") as HTMLInputElement
    )?.value.trim();
    const from = (
      document.getElementById("contact-email") as HTMLInputElement
    )?.value.trim();
    const message = (
      document.getElementById("contact-message") as HTMLTextAreaElement
    )?.value.trim();

    if (!name || !from || !message) {
      errorEl?.classList.remove("hidden");
      return;
    }
    errorEl?.classList.add("hidden");

    const subject = encodeURIComponent(`illerilceler.com İletişim — ${name}`);
    const body = encodeURIComponent(
      `${message}\n\nGönderen: ${name} (${from})`,
    );
    window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
  });
</script>
