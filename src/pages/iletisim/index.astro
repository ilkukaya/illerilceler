---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import { siteConfig } from "@/config/site";
import { webPageSchema } from "@/utils/seo";

const path = "/iletisim/";
const title = "İletişim";
const description = "İller İlçeler ile iletişime geçin: veri düzeltme talepleri, öneriler, reklam ve iş birliği.";
const field = "mt-1.5 w-full rounded-lg border border-border-strong bg-surface px-3 py-2.5 text-base outline-none focus:border-text-primary";
---

<BaseLayout title={title} description={description} path={path} schema={{ ...webPageSchema({ name: title, path, description }), "@type": "ContactPage" }}>
  <div class="container-page max-w-2xl pt-4 sm:pt-6">
    <Breadcrumbs items={[{ label: "İletişim", href: path }]} />
    <h1 class="mt-5 text-4xl leading-[1.1] sm:text-5xl">İletişim</h1>
    <p class="mt-4 text-lg text-text-secondary">
      Bir bilginin hatalı ya da eksik olduğunu mu düşünüyorsunuz? Öneri, reklam veya iş birliği için mi
      yazıyorsunuz? Formu doldurun ya da <a class="link" href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a> adresine yazın.
    </p>

    <form
      name="iletisim"
      method="POST"
      action="/iletisim/tesekkurler/"
      data-netlify="true"
      netlify-honeypot="web-sitesi"
      class="mt-8 space-y-5"
    >
      <input type="hidden" name="form-name" value="iletisim" />
      <p class="hidden">
        <label>Bu alanı boş bırakın <input name="web-sitesi" /></label>
      </p>
      <div>
        <label for="c-name" class="text-sm font-medium">Adınız</label>
        <input id="c-name" name="ad" required autocomplete="name" class={field} />
      </div>
      <div>
        <label for="c-email" class="text-sm font-medium">E-posta</label>
        <input id="c-email" name="eposta" type="email" required autocomplete="email" class={field} />
      </div>
      <div>
        <label for="c-topic" class="text-sm font-medium">Konu</label>
        <select id="c-topic" name="konu" class={field}>
          <option>Veri düzeltme</option>
          <option>Öneri / geri bildirim</option>
          <option>Reklam ve iş birliği</option>
          <option>Diğer</option>
        </select>
      </div>
      <div>
        <label for="c-page" class="text-sm font-medium">İlgili sayfa (isteğe bağlı)</label>
        <input id="c-page" name="sayfa" type="url" placeholder="https://" class={field} />
      </div>
      <div>
        <label for="c-msg" class="text-sm font-medium">Mesajınız</label>
        <textarea id="c-msg" name="mesaj" rows="6" required class={field}></textarea>
      </div>
      <button type="submit" class="btn btn-primary w-full sm:w-auto">Gönder</button>
      <p class="text-xs text-text-muted">
        Gönderdiğiniz bilgiler yalnızca size yanıt vermek için kullanılır. Ayrıntılar: <a class="link" href="/gizlilik/">Gizlilik politikası</a>.
      </p>
    </form>
  </div>
</BaseLayout>

<script>
  const ref = document.getElementById("c-page") as HTMLInputElement | null;
  if (ref && document.referrer.startsWith(location.origin)) ref.value = document.referrer;
</script>
