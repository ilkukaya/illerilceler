---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import InfoBox from "@/components/content/InfoBox.astro";
import FAQAccordion from "@/components/content/FAQAccordion.astro";
import AdSlot from "@/components/content/AdSlot.astro";
import { areaCodes } from "@/data/areaCodes";
import { getProvinceBySlug, getNeighborProvinces } from "@/data/provinces";
import { getRegion } from "@/data/regions";
import { getDistrictsForProvince } from "@/data/districts";
import { districtAreaCodes } from "@/utils/content";
import { formatNumber, formatArea } from "@/utils/format";
import { genitive, copula } from "@/utils/turkish";
import { provincePath, platePath, areaCodePath, districtPath } from "@/utils/links";
import { faqPageSchema, webPageSchema } from "@/utils/seo";

export function getStaticPaths() {
  return areaCodes.map((ac) => ({
    params: { code: ac.code },
    props: { code: ac.code, provinceSlug: ac.provinceSlug, label: ac.label },
  }));
}

const { code, provinceSlug, label } = Astro.props as {
  code: string;
  provinceSlug: string;
  label?: string;
};
const province = getProvinceBySlug(provinceSlug)!;
const region = getRegion(province.region);
const neighbors = getNeighborProvinces(province);
const districts = [...getDistrictsForProvince(province.slug)]
  .filter((d) => districtAreaCodes(d, province).includes(code))
  .sort((a, b) => a.name.localeCompare(b.name, "tr"));
const path = areaCodePath(code);
const where = label ?? province.name;
const full = `0${code}`;

const answer =
  province.slug === "istanbul"
    ? `${full}, İstanbul'un ${code === "212" ? "Avrupa" : "Anadolu"} Yakası'nın sabit telefon alan kodudur. İstanbul'da iki alan kodu kullanılır: Avrupa Yakası için 0212, Anadolu Yakası için 0216.`
    : `${full}, ${province.name} ilinin sabit telefon alan kodudur. ${genitive(province.name)} tüm ilçelerinde aynı alan kodu kullanılır.`;

const faqs = [
  { question: `${full} nerenin alan kodu?`, answer },
  {
    question: `${where} nasıl aranır?`,
    answer: `Türkiye içinden başka bir ilden ararken ${full} ve ardından 7 haneli numara çevrilir (${full} XXX XX XX). Yurt dışından ararken +90 ${code} XXX XX XX biçimi kullanılır. Aynı il içinden yapılan aramalarda alan kodu gerekmez.`,
  },
  {
    question: `${genitive(province.name)} plaka kodu kaçtır?`,
    answer: `${genitive(province.name)} plaka kodu ${copula(province.plateCode)}.`,
  },
  {
    question: `${full} cep telefonu numarası mıdır?`,
    answer: `Hayır. ${full} sabit hat alan kodudur. Türkiye'de cep telefonu numaraları 05 ile başlar (ör. 0532, 0542, 0555) ve operatöre göre değişir, bulunulan ile göre değil.`,
  },
];
const title = `${full} Nerenin Alan Kodu? ${code} Hangi İlin Telefon Kodu — ${where}`;
const description = `${full} ${where} sabit telefon alan kodudur. Nasıl aranır, hangi ilçelerde kullanılır; ${province.name} plaka kodu ${province.plateCode}, nüfus ${province.population ? formatNumber(province.population) : ""}.`;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  image={`/og/provinces/${province.slug}.jpg`}
  schema={[webPageSchema({ name: title, path, description }), faqPageSchema(faqs)]}
>
  <div class="container-page pt-4 sm:pt-6">
    <Breadcrumbs
      items={[
        { label: "Alan kodları", href: "/alan-kodlari/" },
        { label: full, href: path },
      ]}
    />
    <div class="mt-5 grid gap-10 lg:grid-cols-[minmax(0,1fr)_320px] xl:gap-14">
      <article class="min-w-0">
        <p class="section-eyebrow">Telefon alan kodu</p>
        <h1 class="mt-2 text-4xl leading-[1.1] sm:text-5xl">{full} nerenin alan kodu?</h1>
        <p class="answer-box mt-6">{answer}</p>

        <div class="mt-6 inline-flex items-baseline gap-3 rounded-xl border border-border bg-surface px-5 py-4">
          <span class="text-sm text-text-secondary">Arama biçimi</span>
          <span class="tabular font-serif text-2xl font-semibold">({full}) XXX XX XX</span>
        </div>

        <AdSlot variant="in-article" />

        <section class="mt-10">
          <h2 class="text-2xl sm:text-[1.75rem]">
            {full} alan kodunu kullanan ilçeler ({districts.length})
          </h2>
          <ul class="mt-4 flex flex-wrap gap-2">
            {
              districts.map((d) => (
                <li>
                  <a class="pill" href={districtPath(province.slug, d.slug)}>
                    {d.name}
                  </a>
                </li>
              ))
            }
          </ul>
          {
            neighbors.length > 0 && (
              <>
                <h3 class="mt-6 text-base">Komşu illerin alan kodları</h3>
                <ul class="mt-2 flex flex-wrap gap-2">
                  {neighbors.flatMap((x) =>
                    x.areaCodes.map((c) => (
                      <li>
                        <a class="pill" href={areaCodePath(c)}>
                          <b class="tabular text-text-primary">0{c}</b> {x.name}
                        </a>
                      </li>
                    )),
                  )}
                </ul>
              </>
            )
          }
        </section>

        <div class="mt-12"><FAQAccordion faqs={faqs} /></div>
      </article>
      <aside>
        <div class="lg:sticky lg:top-24">
          <InfoBox
            title={province.name}
            subtitle={region?.name}
            map={{ highlight: [province.slug], label: `${genitive(province.name)} konumu` }}
            rows={[
              { label: "Alan kodu", value: province.areaCodes.map((c) => `0${c}`).join(" / ") },
              { label: "Plaka kodu", value: province.plateCode, href: platePath(province.plateCode) },
              { label: "Nüfus", value: province.population ? formatNumber(province.population) : "" },
              { label: "Yüzölçümü", value: formatArea(province.areaKm2) },
            ]}
          />
          <a href={provincePath(province.slug)} class="btn btn-secondary mt-4 w-full">
            {province.name} il sayfası
          </a>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
