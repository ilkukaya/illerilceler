---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import FAQAccordion from "@/components/content/FAQAccordion.astro";
import AdSlot from "@/components/content/AdSlot.astro";
import { areaCodes } from "@/data/areaCodes";
import { getProvinceBySlug } from "@/data/provinces";
import { areaCodePath } from "@/utils/links";
import { itemListSchema, webPageSchema, faqPageSchema } from "@/utils/seo";

const path = "/alan-kodlari/";
const sorted = [...areaCodes].sort((a, b) => Number(a.code) - Number(b.code));
const groups = [2, 3, 4].map((first) => ({
  first,
  items: sorted.filter((a) => a.code.startsWith(String(first))),
}));
const faqs = [
  { question: "Türkiye'de kaç telefon alan kodu var?", answer: `Türkiye'de ${areaCodes.length} sabit hat alan kodu vardır. İstanbul'da iki kod (0212 Avrupa, 0216 Anadolu) kullanılır, diğer illerin her birinin bir kodu vardır.` },
  { question: "Alan kodları neye göre belirlenmiştir?", answer: "Alan kodları coğrafi olarak gruplanmıştır: 02xx kodları çoğunlukla Marmara, Ege ve batı illerine; 03xx kodları İç Anadolu, doğu Akdeniz ile batı ve orta Karadeniz illerine; 04xx kodları Doğu ve Güneydoğu Anadolu ile doğu Karadeniz illerine aittir." },
  { question: "Yurt dışından Türkiye'de sabit hat nasıl aranır?", answer: "+90, ardından başında 0 olmadan alan kodu ve 7 haneli numara çevrilir. Örnek: +90 312 XXX XX XX." },
];
const title = "Telefon Alan Kodları: Türkiye İl Alan Kodları Listesi (0212–0488)";
const description = `Türkiye'deki ${areaCodes.length} sabit telefon alan kodunun hangi ile ait olduğu: 0212 İstanbul Avrupa, 0216 İstanbul Anadolu, 0312 Ankara, 0232 İzmir ve tüm iller.`;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  schema={[
    webPageSchema({ name: title, path, description }),
    itemListSchema(sorted.map((a) => ({ name: `0${a.code} ${getProvinceBySlug(a.provinceSlug)?.name}`, href: areaCodePath(a.code) }))),
    faqPageSchema(faqs),
  ]}
>
  <div class="container-page pt-4 sm:pt-6">
    <Breadcrumbs items={[{ label: "Alan kodları", href: path }]} />
    <header class="mt-5 max-w-3xl">
      <h1 class="text-4xl leading-[1.1] sm:text-5xl">Telefon alan kodları</h1>
      <p class="answer-box mt-6">
        Türkiye'de {areaCodes.length} sabit hat alan kodu vardır. Kodlar 02, 03 ve 04 ile başlayan üç
        grupta toplanır. Bir koda dokunarak hangi ile ait olduğunu, nasıl arandığını ve kullanıldığı
        ilçeleri görebilirsiniz.
      </p>
    </header>
    <div class="mt-10 grid gap-8 lg:grid-cols-3">
      {groups.map((g) => (
        <section>
          <h2 class="font-sans text-base font-semibold">0{g.first}xx kodları</h2>
          <ul class="mt-2 divide-y divide-border rounded-xl border border-border bg-surface">
            {g.items.map((a) => (
              <li>
                <a href={areaCodePath(a.code)} class="flex items-baseline justify-between gap-3 px-4 py-2.5 hover:bg-surface-muted">
                  <span class="tabular font-semibold">0{a.code}</span>
                  <span class="text-right text-text-secondary">{a.label ?? getProvinceBySlug(a.provinceSlug)?.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
    <AdSlot variant="leaderboard" />
    <div class="mt-12 max-w-3xl"><FAQAccordion faqs={faqs} /></div>
  </div>
</BaseLayout>
