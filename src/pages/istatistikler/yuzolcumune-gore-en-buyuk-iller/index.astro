---
import ProvinceRanking from "@/components/content/ProvinceRanking.astro";
import { formatNumber } from "@/utils/format";
import { provincesByArea as r, TOTAL_AREA } from "@/utils/rankings";
import { copula, possessive } from "@/utils/turkish";

const last = r[r.length - 1];
const intro = `Yüzölçümü en büyük il ${formatNumber(r[0].areaKm2!)} km² ile ${copula(r[0].name)}; ülke topraklarının yaklaşık ${possessive(`%${((r[0].areaKm2! / TOTAL_AREA) * 100).toFixed(1).replace(".", ",")}`)} bu ilin sınırları içindedir. Onu ${r[1].name} (${formatNumber(r[1].areaKm2!)} km²) ve ${r[2].name} (${formatNumber(r[2].areaKm2!)} km²) izler. En küçük il ise ${formatNumber(last.areaKm2!)} km² ile ${copula(last.name)}.`;
const faqs = [
  { question: "Türkiye'nin yüzölçümü en büyük ili hangisidir?", answer: `${formatNumber(r[0].areaKm2!)} km² ile ${copula(r[0].name)}.` },
  { question: "Türkiye'nin en küçük ili hangisidir?", answer: `Yüzölçümü bakımından en küçük il ${formatNumber(last.areaKm2!)} km² ile ${copula(last.name)}.` },
  { question: "Yüzölçümü en büyük 5 il hangileridir?", answer: `${r.slice(0, 5).map((p) => `${p.name} (${formatNumber(p.areaKm2!)} km²)`).join(", ")}.` },
];
---

<ProvinceRanking
  metric="area"
  path="/istatistikler/yuzolcumune-gore-en-buyuk-iller/"
  title="Yüzölçümüne Göre İller — Türkiye'nin En Büyük ve En Küçük İlleri"
  h1="Yüzölçümüne göre iller"
  description={`81 ilin yüzölçümü sıralaması: en büyük il ${r[0].name} (${formatNumber(r[0].areaKm2!)} km²), en küçük il ${last.name}. Tam tablo ve harita.`}
  intro={intro}
  faqs={faqs}
/>
