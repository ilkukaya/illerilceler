---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import AdSlot from "@/components/content/AdSlot.astro";
import { provinces } from "@/data/provinces";
import { districts } from "@/data/districts";
import { formatNumber } from "@/utils/format";
import {
  TOTAL_POPULATION, TOTAL_AREA, NATIONAL_DENSITY, POPULATION_YEAR,
  provincesByPopulation, provincesByArea, provincesByDensity, provincesByElevation,
  provincesByDistrictCount, districtsByPopulation, density,
} from "@/utils/rankings";
import { provincePath } from "@/utils/links";
import { webPageSchema } from "@/utils/seo";

const path = "/istatistikler/";
const last = <T,>(a: T[]) => a[a.length - 1];
const cards = [
  { title: "Nüfusa göre iller", href: "/istatistikler/en-kalabalik-iller/", top: provincesByPopulation[0], value: formatNumber(provincesByPopulation[0].population ?? 0), bottom: last(provincesByPopulation) },
  { title: "Yüzölçümüne göre iller", href: "/istatistikler/yuzolcumune-gore-en-buyuk-iller/", top: provincesByArea[0], value: `${formatNumber(provincesByArea[0].areaKm2 ?? 0)} km²`, bottom: last(provincesByArea) },
  { title: "Nüfus yoğunluğuna göre iller", href: "/istatistikler/nufus-yogunluguna-gore-iller/", top: provincesByDensity[0], value: `${formatNumber(Math.round(density(provincesByDensity[0].population, provincesByDensity[0].areaKm2) ?? 0))} kişi/km²`, bottom: last(provincesByDensity) },
  { title: "Rakıma göre iller", href: "/istatistikler/rakima-gore-iller/", top: provincesByElevation[0], value: `${formatNumber(provincesByElevation[0].elevationM ?? 0)} m`, bottom: last(provincesByElevation) },
  { title: "İlçe sayısına göre iller", href: "/istatistikler/en-cok-ilcesi-olan-iller/", top: provincesByDistrictCount[0], value: `${provincesByDistrictCount[0].districtCount} ilçe`, bottom: last(provincesByDistrictCount) },
];
const title = `Türkiye İstatistikleri ${POPULATION_YEAR}: İl ve İlçe Sıralamaları`;
const description = `Türkiye nüfusu ${formatNumber(TOTAL_POPULATION)} (TÜİK ${POPULATION_YEAR}). İllerin nüfus, yüzölçümü, yoğunluk, rakım ve ilçe sayısı sıralamaları; en kalabalık ilçeler.`;
---

<BaseLayout title={title} description={description} path={path} schema={webPageSchema({ name: title, path, description })}>
  <div class="container-page pt-4 sm:pt-6">
    <Breadcrumbs items={[{ label: "İstatistikler", href: path }]} />
    <h1 class="mt-5 text-4xl leading-[1.1] sm:text-5xl">İstatistikler</h1>
    <dl class="tabular mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-border bg-border lg:grid-cols-4">
      {[
        ["Nüfus", formatNumber(TOTAL_POPULATION)],
        ["İl yüzölçümleri toplamı", `${formatNumber(TOTAL_AREA)} km²`],
        ["Nüfus yoğunluğu", `${formatNumber(Math.round(NATIONAL_DENSITY))} kişi/km²`],
        ["İl / ilçe", `${provinces.length} / ${districts.length}`],
      ].map(([k, v]) => (
        <div class="bg-surface p-5"><dt class="text-sm text-text-muted">{k}</dt><dd class="mt-1 font-serif text-2xl font-semibold sm:text-3xl">{v}</dd></div>
      ))}
    </dl>
    <p class="mt-2 text-xs text-text-muted">Kaynak: TÜİK ADNKS {POPULATION_YEAR}, Harita Genel Müdürlüğü.</p>

    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {cards.map((c) => (
        <li>
          <a href={c.href} class="card card-hover flex h-full flex-col p-5">
            <span class="font-serif text-xl font-semibold">{c.title}</span>
            <span class="mt-3 text-sm text-text-secondary">En yüksek</span>
            <span class="font-medium">{c.top.name} · <span class="tabular">{c.value}</span></span>
            <span class="mt-2 text-sm text-text-secondary">En düşük</span>
            <span class="font-medium">{c.bottom.name}</span>
            <span class="link mt-auto pt-4 text-sm">Tam sıralama →</span>
          </a>
        </li>
      ))}
      <li>
        <a href="/istatistikler/en-kalabalik-ilceler/" class="card card-hover flex h-full flex-col p-5">
          <span class="font-serif text-xl font-semibold">Nüfusa göre ilçeler</span>
          <span class="mt-3 text-sm text-text-secondary">En kalabalık</span>
          <span class="font-medium">{districtsByPopulation[0].name} · <span class="tabular">{formatNumber(districtsByPopulation[0].population ?? 0)}</span></span>
          <span class="mt-2 text-sm text-text-secondary">973 ilçenin tamamı</span>
          <span class="link mt-auto pt-4 text-sm">Tam sıralama →</span>
        </a>
      </li>
    </ul>
    <AdSlot variant="leaderboard" />
    <section class="mt-12">
      <h2 class="text-2xl">Mahalle ve mesafe verileri</h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        <li><a class="pill" href="/mahalleler/">İllere göre mahalle sayıları</a></li>
        <li><a class="pill" href="/mesafe/">İller arası mesafe tablosu</a></li>
        <li><a class="pill" href="/acik-veri/">Açık veri (CSV/JSON)</a></li>
        <li><a class="pill" href={provincePath("istanbul")}>İstanbul</a></li>
      </ul>
    </section>
  </div>
</BaseLayout>
