---
import ProvinceRanking from "@/components/content/ProvinceRanking.astro";
import { formatNumber } from "@/utils/format";
import { provincesByPopulation as r, TOTAL_POPULATION, POPULATION_YEAR } from "@/utils/rankings";
import { copula, possessive } from "@/utils/turkish";

const top5 = r.slice(0, 5).reduce((s, p) => s + (p.population ?? 0), 0);
const last = r[r.length - 1];
const intro = `TÜİK ${POPULATION_YEAR} verilerine göre Türkiye'nin en kalabalık ili ${formatNumber(r[0].population!)} kişiyle ${copula(r[0].name)}. Onu ${r[1].name} (${formatNumber(r[1].population!)}) ve ${r[2].name} (${formatNumber(r[2].population!)}) izler. Ülke nüfusunun ${possessive(`%${Math.round((top5 / TOTAL_POPULATION) * 100)}`)} bu beş ilde yaşar. En az nüfuslu il ise ${formatNumber(last.population!)} kişiyle ${copula(last.name)}.`;
const faqs = [
  { question: "Türkiye'nin en kalabalık ili hangisidir?", answer: `${formatNumber(r[0].population!)} kişiyle ${copula(r[0].name)}.` },
  { question: "Türkiye'nin en kalabalık 5 ili hangileridir?", answer: `${r.slice(0, 5).map((p) => `${p.name} (${formatNumber(p.population!)})`).join(", ")}.` },
  { question: "Türkiye'nin en az nüfuslu ili hangisidir?", answer: `${formatNumber(last.population!)} kişiyle ${copula(last.name)}.` },
  { question: "Türkiye'nin toplam nüfusu kaçtır?", answer: `TÜİK ${POPULATION_YEAR} sonuçlarına göre ${formatNumber(TOTAL_POPULATION)} kişidir.` },
];
---

<ProvinceRanking
  metric="population"
  path="/istatistikler/en-kalabalik-iller/"
  title={`Türkiye'nin En Kalabalık İlleri ${POPULATION_YEAR} — 81 İl Nüfus Sıralaması`}
  h1="Nüfusa göre iller"
  description={`81 ilin TÜİK ${POPULATION_YEAR} nüfusuna göre sıralaması: en kalabalık il ${r[0].name}, en az nüfuslu il ${last.name}. Harita, yoğunluk ve tam tablo.`}
  intro={intro}
  faqs={faqs}
/>
