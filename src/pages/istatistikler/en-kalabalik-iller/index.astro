---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageContainer from "@/components/layout/PageContainer.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import FAQAccordion from "@/components/content/FAQAccordion.astro";
import { provinces } from "@/data/provinces";
import { getRegion } from "@/data/regions";
import { formatNumber } from "@/utils/format";

const path = "/istatistikler/en-kalabalik-iller/";
const ranked = [...provinces].sort(
  (a, b) => (b.population ?? 0) - (a.population ?? 0),
);

const faqs = [
  {
    question: "Türkiye'nin en kalabalık ili hangisidir?",
    answer: `${ranked[0]?.name}, ${formatNumber(ranked[0]?.population)} nüfusuyla Türkiye'nin en kalabalık ilidir.`,
  },
  {
    question: "Türkiye'nin en az nüfuslu ili hangisidir?",
    answer: `${ranked[ranked.length - 1]?.name}, Türkiye'nin en az nüfuslu ilidir.`,
  },
];
---

<BaseLayout
  title="Nüfusa Göre En Kalabalık İller — Türkiye İl Sıralaması"
  description="Türkiye'deki 81 ilin nüfusa göre sıralı listesi."
  path={path}
>
  <PageContainer class="py-4">
    <Breadcrumbs
      items={[
        { label: "İstatistikler", href: "/istatistikler/" },
        { label: "En Kalabalık İller", href: path },
      ]}
    />
  </PageContainer>

  <PageContainer class="pb-16">
    <h1 class="text-3xl font-extrabold text-text-primary sm:text-4xl">
      Nüfusa Göre En Kalabalık İller
    </h1>
    <div
      class="mt-4 rounded-2xl border border-brand-primary/20 bg-brand-purple-soft p-4 sm:p-5"
    >
      <p class="text-base font-semibold text-text-primary">
        <strong>
          {ranked[0]?.name}, {formatNumber(ranked[0]?.population)} kişilik nüfusuyla
          Türkiye'nin en kalabalık ilidir.
        </strong>
      </p>
    </div>

    <div class="mt-8 overflow-hidden rounded-2xl border border-border">
      <table class="w-full text-sm">
        <thead>
          <tr
            class="bg-surface-muted text-left text-xs font-bold uppercase tracking-wide text-text-muted"
          >
            <th class="px-4 py-3">#</th>
            <th class="px-4 py-3">İl</th>
            <th class="px-4 py-3">Bölge</th>
            <th class="px-4 py-3 text-right">Nüfus (2024)</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          {
            ranked.map((p, i) => (
              <tr class="bg-surface hover:bg-surface-muted">
                <td class="px-4 py-3 font-bold text-text-muted">{i + 1}</td>
                <td class="px-4 py-3">
                  <a
                    href={`/iller/${p.slug}/`}
                    class="font-semibold text-text-primary hover:text-brand-primary"
                  >
                    {p.name}
                  </a>
                </td>
                <td class="px-4 py-3 text-text-secondary">
                  {getRegion(p.region)?.name.replace(" Bölgesi", "")}
                </td>
                <td class="px-4 py-3 text-right font-bold text-text-primary">
                  {formatNumber(p.population)}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="mt-12">
      <FAQAccordion faqs={faqs} />
    </div>
  </PageContainer>
</BaseLayout>
