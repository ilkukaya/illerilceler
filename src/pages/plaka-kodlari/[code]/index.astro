---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import PlateVisual from "@/components/code-pages/PlateVisual.astro";
import InfoBox from "@/components/content/InfoBox.astro";
import FAQAccordion from "@/components/content/FAQAccordion.astro";
import AdSlot from "@/components/content/AdSlot.astro";
import { plateCodes } from "@/data/plateCodes";
import { provinces, getProvinceBySlug, getNeighborProvinces } from "@/data/provinces";
import { getRegion } from "@/data/regions";
import { getDistrictsForProvince } from "@/data/districts";
import { formatNumber, formatArea } from "@/utils/format";
import { genitive, copula } from "@/utils/turkish";
import { provinceLead } from "@/utils/content";
import { provincePath, platePath, districtPath, districtListPath } from "@/utils/links";
import { faqPageSchema, webPageSchema } from "@/utils/seo";

export function getStaticPaths() {
  return plateCodes.map((pc) => ({
    params: { code: pc.code },
    props: { code: pc.code, provinceSlug: pc.provinceSlug },
  }));
}

const { code, provinceSlug } = Astro.props as { code: string; provinceSlug: string };
const province = getProvinceBySlug(provinceSlug)!;
const region = getRegion(province.region);
const neighbors = getNeighborProvinces(province);
const districts = [...getDistrictsForProvince(province.slug)].sort((a, b) =>
  a.name.localeCompare(b.name, "tr"),
);
const path = platePath(code);
const n = Number(code);
const prev = provinces.find((p) => Number(p.plateCode) === n - 1);
const next = provinces.find((p) => Number(p.plateCode) === n + 1);
const answerRest = `${province.name}, ${region?.name ?? ""}'nde yer alır; telefon alan kodu ${copula(province.areaCodes.map((c) => `0${c}`).join(" ve "))}.`;

const faqs = [
  { question: `${code} nerenin plakası?`, answer: `${code} plaka kodu ${province.name} iline aittir.` },
  {
    question: `${genitive(province.name)} plaka kodu kaçtır?`,
    answer: `${genitive(province.name)} plaka kodu ${copula(code)}.`,
  },
  {
    question: `${code} plakalı araç ${province.name} dışında kullanılabilir mi?`,
    answer: `Evet. Plaka kodu yalnızca aracın tescil edildiği ili gösterir; araç Türkiye'nin her yerinde trafiğe çıkabilir.`,
  },
  {
    question: "Türkiye'de plaka kodları nasıl belirlenmiştir?",
    answer: "İl plaka kodları, illerin adlarının alfabetik sırasına göre 1'den 67'ye kadar verilmiştir. Sonradan il olan yerler (68 Aksaray'dan 81 Düzce'ye) kuruluş sırasına göre numaralandırılmıştır.",
  },
  ...(neighbors.length
    ? [
        {
          question: `${genitive(province.name)} komşu illerinin plaka kodları nelerdir?`,
          answer: `${neighbors.map((x) => `${x.name} ${x.plateCode}`).join(", ")}.`,
        },
      ]
    : []),
];
const title = `${code} Nerenin Plakası? ${code} Plaka Kodu Hangi İlin — ${province.name}`;
const description = `${code} plaka kodu ${province.name} iline aittir. ${province.name}: ${region?.name ?? ""}, alan kodu ${province.areaCodes.map((c) => `0${c}`).join(" / ")}, nüfus ${province.population ? formatNumber(province.population) : ""}, ${districts.length} ilçe.`;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  image={`/og/provinces/${province.slug}.jpg`}
  schema={[webPageSchema({ name: title, path, description }), faqPageSchema(faqs)]}
>
  <div class="container-page pt-4 sm:pt-6">
    <Breadcrumbs
      items={[
        { label: "Plaka kodları", href: "/plaka-kodlari/" },
        { label: code, href: path },
      ]}
    />
    <div class="mt-5 grid gap-10 lg:grid-cols-[minmax(0,1fr)_320px] xl:gap-14">
      <article class="min-w-0">
        <p class="section-eyebrow">Plaka kodu</p>
        <h1 class="mt-2 text-4xl leading-[1.1] sm:text-5xl">{code} nerenin plakası?</h1>
        <p class="answer-box mt-6">
          <strong>{code}</strong> plaka kodu <strong>{province.name}</strong> iline aittir.
          {" "}{answerRest}
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-6">
          <PlateVisual code={code} class="w-full max-w-[340px]" />
          <a href={provincePath(province.slug)} class="btn btn-primary">
            {province.name} il sayfası →
          </a>
        </div>

        <AdSlot variant="in-article" />

        <section class="mt-10">
          <h2 class="text-2xl sm:text-[1.75rem]">{province.name} hakkında</h2>
          <p class="prose-content mt-3 max-w-3xl">{provinceLead(province)}</p>
          <h3 class="mt-6 text-base">
            {code} plakalı ilin {districts.length} ilçesi
          </h3>
          <ul class="mt-2 flex flex-wrap gap-2">
            {
              districts.map((d) => (
                <li>
                  <a class="pill" href={districtPath(province.slug, d.slug)}>
                    {d.name}
                  </a>
                </li>
              ))
            }
          </ul>
          {
            neighbors.length > 0 && (
              <>
                <h3 class="mt-6 text-base">Komşu illerin plaka kodları</h3>
                <ul class="mt-2 flex flex-wrap gap-2">
                  {neighbors.map((x) => (
                    <li>
                      <a class="pill" href={platePath(x.plateCode)}>
                        <b class="tabular text-text-primary">{x.plateCode}</b> {x.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            )
          }
        </section>

        <div class="mt-12">
          <FAQAccordion faqs={faqs} />
        </div>

        <nav class="mt-10 flex justify-between gap-4 border-t border-border pt-6 text-sm" aria-label="Önceki ve sonraki plaka">
          {prev ? (
            <a href={platePath(prev.plateCode)} class="link">← {prev.plateCode} {prev.name}</a>
          ) : <span />}
          {next ? (
            <a href={platePath(next.plateCode)} class="link">{next.plateCode} {next.name} →</a>
          ) : <span />}
        </nav>
      </article>
      <aside>
        <div class="lg:sticky lg:top-24">
          <InfoBox
            title={province.name}
            subtitle={`Plaka ${code} · ${region?.name ?? ""}`}
            map={{ highlight: [province.slug], label: `${genitive(province.name)} konumu` }}
            rows={[
              { label: "Plaka kodu", value: code },
              { label: "Alan kodu", value: province.areaCodes.map((c) => `0${c}`).join(" / ") },
              { label: "Nüfus", value: province.population ? formatNumber(province.population) : "" },
              { label: "Yüzölçümü", value: formatArea(province.areaKm2) },
              { label: "İlçe sayısı", value: String(districts.length), href: districtListPath(province.slug) },
            ]}
          />
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
