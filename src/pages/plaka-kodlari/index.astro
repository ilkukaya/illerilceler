---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import ProvinceMap from "@/components/geography/ProvinceMap.astro";
import FAQAccordion from "@/components/content/FAQAccordion.astro";
import AdSlot from "@/components/content/AdSlot.astro";
import { provinces } from "@/data/provinces";
import { getRegion } from "@/data/regions";
import { platePath } from "@/utils/links";
import { itemListSchema, webPageSchema, faqPageSchema } from "@/utils/seo";

const path = "/plaka-kodlari/";
const byCode = [...provinces].sort((a, b) => Number(a.plateCode) - Number(b.plateCode));
const faqs = [
  { question: "Türkiye'de kaç plaka kodu var?", answer: "Türkiye'de her ile bir tane olmak üzere 01'den 81'e kadar 81 il plaka kodu vardır." },
  { question: "Plaka kodları nasıl sıralanır?", answer: "01–67 arası kodlar, 1960'lardaki 67 ilin alfabetik sırasına göre verilmiştir (ör. 01 Adana, 06 Ankara, 34 İstanbul). 68 Aksaray'dan 81 Düzce'ye kadar olan kodlar sonradan kurulan illere kuruluş sırasıyla verilmiştir." },
  { question: "En son plaka kodu hangi ile aittir?", answer: "81 plaka kodu, 1999'da il olan Düzce'ye aittir." },
  { question: "Mersin'in plaka kodu neden 33?", answer: "Mersin, plaka kodlarının dağıtıldığı dönemde İçel adıyla anıldığı için alfabetik sırada 33. sıraya yerleşmiştir." },
];
const title = "Plaka Kodları: 01'den 81'e Tüm İllerin Plaka Kodu Listesi";
const description = "Türkiye il plaka kodları tam listesi: 01 Adana'dan 81 Düzce'ye 81 ilin plaka kodu, haritası ve bölgesi. Plaka kodu hangi ile ait, hemen öğrenin.";
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  schema={[
    webPageSchema({ name: title, path, description }),
    itemListSchema(byCode.map((p) => ({ name: `${p.plateCode} ${p.name}`, href: platePath(p.plateCode) }))),
    faqPageSchema(faqs),
  ]}
>
  <div class="container-page pt-4 sm:pt-6">
    <Breadcrumbs items={[{ label: "Plaka kodları", href: path }]} />
    <div class="mt-5 grid items-start gap-10 lg:grid-cols-2">
      <header>
        <h1 class="text-4xl leading-[1.1] sm:text-5xl">İl plaka kodları</h1>
        <p class="answer-box mt-6">
          Türkiye'de 01 (Adana) ile 81 (Düzce) arasında 81 il plaka kodu vardır. Kodlar 67 ile kadar
          alfabetik, sonrasında illerin kuruluş sırasına göre verilmiştir. Bir koda dokunarak ilin
          bilgilerine ulaşabilirsiniz.
        </p>
      </header>
      <ProvinceMap labels controls={false} id="plaka-map" />
    </div>

    <ol class="mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6">
      {byCode.map((p) => (
        <li class="bg-surface">
          <a href={platePath(p.plateCode)} class="flex items-center gap-3 px-3 py-3 hover:bg-surface-muted">
            <span class="tabular w-9 font-serif text-2xl font-semibold text-brand-primary">{p.plateCode}</span>
            <span class="min-w-0">
              <span class="block truncate font-medium">{p.name}</span>
              <span class="block truncate text-xs text-text-muted">{getRegion(p.region)?.name.replace(" Bölgesi", "")}</span>
            </span>
          </a>
        </li>
      ))}
    </ol>

    <AdSlot variant="leaderboard" />
    <div class="mt-12 max-w-3xl"><FAQAccordion faqs={faqs} /></div>
  </div>
</BaseLayout>
