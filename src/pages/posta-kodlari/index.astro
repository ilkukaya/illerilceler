---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import FAQAccordion from "@/components/content/FAQAccordion.astro";
import AdSlot from "@/components/content/AdSlot.astro";
import { postalCodes } from "@/data/postalCodes";
import { provinces, getProvinceBySlug } from "@/data/provinces";
import { getDistrictBySlug } from "@/data/districts";
import { getNeighborhoodBySlug } from "@/data/neighborhoods";
import { provincePath } from "@/utils/links";
import { webPageSchema, faqPageSchema } from "@/utils/seo";

const path = "/posta-kodlari/";
const PTT = "https://postakodu.ptt.gov.tr/";
const byCode = [...provinces].sort((a, b) => Number(a.plateCode) - Number(b.plateCode));
const samples = [...postalCodes].sort((a, b) => a.code.localeCompare(b.code));
const faqs = [
  { question: "Posta kodu kaç hanedir?", answer: "Türkiye'de posta kodları 5 hanelidir. İlk iki hane ili gösterir ve ilin plaka koduyla aynıdır (ör. 34xxx İstanbul, 06xxx Ankara)." },
  { question: "Mahallemin posta kodunu nasıl bulurum?", answer: "Posta kodları mahalle ve köy düzeyinde verilir. Güncel ve resmî posta kodunu PTT'nin posta kodu sorgulama sayfasından il, ilçe ve mahalle seçerek bulabilirsiniz." },
  { question: "İlin posta kodu nedir?", answer: "Tek bir 'il posta kodu' yoktur; her mahalle ve köyün kendi kodu vardır. Ancak bir ildeki tüm posta kodları, o ilin plaka koduyla başlar." },
];
const title = "Posta Kodları: İllerin Posta Kodu Önekleri ve Sorgulama Rehberi";
const description = "Türkiye posta kodları nasıl çalışır? 81 ilin posta kodu öneki (plaka koduyla aynı), mahalle posta kodu nasıl bulunur ve resmî PTT sorgulama bağlantısı.";
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  schema={[webPageSchema({ name: title, path, description }), faqPageSchema(faqs)]}
>
  <div class="container-page pt-4 sm:pt-6">
    <Breadcrumbs items={[{ label: "Posta kodları", href: path }]} />
    <header class="mt-5 max-w-3xl">
      <h1 class="text-4xl leading-[1.1] sm:text-5xl">Posta kodları</h1>
      <p class="answer-box mt-6">
        Türkiye'de posta kodları 5 hanelidir ve ilk iki hanesi ilin plaka koduyla aynıdır: İstanbul'daki
        tüm posta kodları 34, Ankara'dakiler 06 ile başlar. Kodlar mahalle ve köy düzeyinde verilir;
        adresinizin kesin kodu için PTT'nin resmî sorgulama sayfasını kullanın.
      </p>
      <a href={PTT} target="_blank" rel="noopener" class="btn btn-primary mt-5">PTT posta kodu sorgula ↗</a>
    </header>

    <section class="mt-12">
      <h2 class="text-2xl sm:text-3xl">İllere göre posta kodu önekleri</h2>
      <ul class="mt-4 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-3 lg:grid-cols-5">
        {byCode.map((p) => (
          <li class="bg-surface">
            <a href={provincePath(p.slug)} class="flex items-baseline justify-between gap-2 px-3 py-2.5 hover:bg-surface-muted">
              <span class="font-medium">{p.name}</span>
              <span class="tabular text-sm text-text-secondary">{p.plateCode}xxx</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <AdSlot variant="leaderboard" />

    <section class="mt-12">
      <h2 class="text-2xl sm:text-3xl">Örnek posta kodları</h2>
      <p class="mt-1 text-sm text-text-secondary">
        Sitemizdeki posta kodu kapsamı şimdilik sınırlıdır. Kesin bilgi için PTT'yi esas alın.
      </p>
      <ul class="mt-4 grid gap-x-8 sm:grid-cols-2 lg:grid-cols-3">
        {samples.map((pc) => {
          const p = getProvinceBySlug(pc.provinceSlug);
          const d = pc.districtSlug ? getDistrictBySlug(pc.provinceSlug, pc.districtSlug) : undefined;
          const n = pc.districtSlug && pc.neighborhoodSlug ? getNeighborhoodBySlug(pc.provinceSlug, pc.districtSlug, pc.neighborhoodSlug) : undefined;
          return (
            <li class="flex justify-between gap-3 border-b border-border py-2 text-sm">
              <a href={`/posta-kodlari/${pc.code}/`} class="tabular font-semibold hover:text-brand-primary">{pc.code}</a>
              <span class="text-right text-text-secondary">{[n?.name, d?.name, p?.name].filter(Boolean).join(", ")}</span>
            </li>
          );
        })}
      </ul>
    </section>

    <div class="mt-12 max-w-3xl"><FAQAccordion faqs={faqs} /></div>
  </div>
</BaseLayout>
