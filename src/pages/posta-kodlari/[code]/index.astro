---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import InfoBox from "@/components/content/InfoBox.astro";
import FAQAccordion from "@/components/content/FAQAccordion.astro";
import AdSlot from "@/components/content/AdSlot.astro";
import { postalCodes, getNearbyPostalCodes } from "@/data/postalCodes";
import { getProvinceBySlug } from "@/data/provinces";
import { getDistrictBySlug } from "@/data/districts";
import { getNeighborhoodBySlug } from "@/data/neighborhoods";
import { formatNumber } from "@/utils/format";
import { genitive } from "@/utils/turkish";
import { provincePath, districtPath, platePath } from "@/utils/links";
import { faqPageSchema, webPageSchema } from "@/utils/seo";

export function getStaticPaths() {
  return postalCodes.map((pc) => ({ params: { code: pc.code }, props: { postalCode: pc } }));
}

const { postalCode } = Astro.props as { postalCode: (typeof postalCodes)[number] };
const code = postalCode.code;
const province = getProvinceBySlug(postalCode.provinceSlug)!;
const district = postalCode.districtSlug ? getDistrictBySlug(postalCode.provinceSlug, postalCode.districtSlug) : undefined;
const neighborhood =
  postalCode.districtSlug && postalCode.neighborhoodSlug
    ? getNeighborhoodBySlug(postalCode.provinceSlug, postalCode.districtSlug, postalCode.neighborhoodSlug)
    : undefined;
const nearby = getNearbyPostalCodes(code);
const path = `/posta-kodlari/${code}/`;
const place = [neighborhood ? `${neighborhood.name} Mahallesi` : undefined, district?.name, province.name].filter(Boolean).join(", ");
const answer = neighborhood
  ? `${code} posta kodu ${province.name} ili, ${district?.name} ilçesi, ${neighborhood.name} Mahallesi'ne aittir.`
  : district
    ? `${code} posta kodu ${province.name} ili ${district.name} ilçesinde kullanılır.`
    : `${code} posta kodu ${province.name} iline aittir.`;
const faqs = [
  { question: `${code} posta kodu nereye ait?`, answer },
  { question: `${code} posta kodunun ilk iki hanesi neyi gösterir?`, answer: `İlk iki hane (${code.slice(0, 2)}), ${genitive(province.name)} plaka koduyla aynıdır ve kodun ${province.name} iline ait olduğunu gösterir.` },
  { question: "Posta kodu bilgisi güncel mi?", answer: "Posta kodları PTT tarafından belirlenir ve zaman zaman güncellenir. Resmî gönderilerde PTT'nin posta kodu sorgulama hizmetini esas alın." },
];
const title = `${code} Posta Kodu Nereye Ait? — ${place}`;
const description = `${answer} Posta kodunun yapısı, bağlı olduğu ilçe ve il bilgileri.`;
---

<BaseLayout title={title} description={description} path={path} schema={[webPageSchema({ name: title, path, description }), faqPageSchema(faqs)]}>
  <div class="container-page pt-4 sm:pt-6">
    <Breadcrumbs items={[{ label: "Posta kodları", href: "/posta-kodlari/" }, { label: code, href: path }]} />
    <div class="mt-5 grid gap-10 lg:grid-cols-[minmax(0,1fr)_320px] xl:gap-14">
      <article class="min-w-0">
        <p class="section-eyebrow">Posta kodu</p>
        <h1 class="mt-2 text-4xl leading-[1.1] sm:text-5xl">{code} posta kodu</h1>
        <p class="answer-box mt-6">{answer}</p>
        <p class="mt-3 text-xs text-text-muted">
          Resmî ve güncel bilgi için <a href="https://postakodu.ptt.gov.tr/" target="_blank" rel="noopener" class="link">PTT posta kodu sorgulama</a> sayfasını kullanın.
        </p>
        <AdSlot variant="in-article" />
        {nearby.length > 0 && (
          <section class="mt-10">
            <h2 class="text-2xl">Yakın posta kodları</h2>
            <ul class="mt-3 flex flex-wrap gap-2">
              {nearby.map((pc) => <li><a class="pill tabular" href={`/posta-kodlari/${pc.code}/`}>{pc.code}</a></li>)}
            </ul>
          </section>
        )}
        <div class="mt-12"><FAQAccordion faqs={faqs} /></div>
      </article>
      <aside>
        <div class="lg:sticky lg:top-24">
          <InfoBox
            title={district ? district.name : province.name}
            subtitle={district ? `${province.name} ilçesi` : province.name}
            map={{ highlight: [province.slug], label: `${genitive(province.name)} konumu` }}
            rows={[
              { label: "İl", value: province.name, href: provincePath(province.slug) },
              { label: "İlçe", value: district?.name ?? "", href: district ? districtPath(province.slug, district.slug) : undefined },
              { label: "Mahalle", value: neighborhood?.name ?? "" },
              { label: "Plaka kodu", value: province.plateCode, href: platePath(province.plateCode) },
              { label: "İlçe nüfusu", value: district?.population ? formatNumber(district.population) : "" },
            ]}
          />
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
