---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";

/** Village-level data is not in the dataset yet — kept out of the index until it is. */
const path = "/koyler/";
---

<BaseLayout
  title="Köyler"
  description="Türkiye'deki köy bilgileri hazırlanıyor. İlçe sayfalarından mahalle ve nüfus bilgilerine ulaşabilirsiniz."
  path={path}
  noindex
>
  <div class="container-page max-w-3xl pt-4 sm:pt-6">
    <Breadcrumbs items={[{ label: "Köyler", href: path }]} />
    <h1 class="mt-5 text-4xl sm:text-5xl">Köyler</h1>
    <p class="prose-content mt-4">
      Köy düzeyindeki verileri resmî kaynaklarla doğruladıktan sonra yayınlayacağız. Şimdilik
      <a href="/ilceler/">973 ilçenin</a> nüfus ve mahalle bilgilerine, <a href="/mahalleler/">mahalle sayılarına</a>
      göz atabilirsiniz.
    </p>
  </div>
</BaseLayout>
