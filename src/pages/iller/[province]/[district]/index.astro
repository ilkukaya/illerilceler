---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageContainer from "@/components/layout/PageContainer.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import SectionHeader from "@/components/layout/SectionHeader.astro";
import TableOfContents from "@/components/content/TableOfContents.astro";
import InfoTable from "@/components/content/InfoTable.astro";
import QuickFacts from "@/components/content/QuickFacts.astro";
import LocationMapCard from "@/components/geography/LocationMapCard.astro";
import FAQAccordion from "@/components/content/FAQAccordion.astro";
import RelatedSearches from "@/components/content/RelatedSearches.astro";
import SourcesCard from "@/components/content/SourcesCard.astro";
import QuickToolCard from "@/components/cards/QuickToolCard.astro";
import LocationHero from "@/components/geography/LocationHero.astro";
import AdSlot from "@/components/content/AdSlot.astro";
import Icon from "@/components/Icon.astro";
import { getProvinceBySlug } from "@/data/provinces";
import {
  districtNamesByProvince,
  getDistrictsForProvince,
  getNeighborDistricts,
} from "@/data/districts";
import { getPostalCodesForDistrict } from "@/data/postalCodes";
import { getDistrictImage } from "@/generated/locationImageManifest";
import { formatNumber, formatArea, formatElevation } from "@/utils/format";
import { districtFaqs } from "@/utils/content";
import { webPageSchema, faqPageSchema } from "@/utils/seo";
import StructuredData from "@/components/seo/StructuredData.astro";

export function getStaticPaths() {
  const paths: {
    params: { province: string; district: string };
    props: { provinceSlug: string; districtSlug: string };
  }[] = [];
  for (const provinceSlug of Object.keys(districtNamesByProvince)) {
    for (const d of getDistrictsForProvince(provinceSlug)) {
      paths.push({
        params: { province: provinceSlug, district: d.slug },
        props: { provinceSlug, districtSlug: d.slug },
      });
    }
  }
  return paths;
}

const { provinceSlug, districtSlug } = Astro.props as {
  provinceSlug: string;
  districtSlug: string;
};
const province = getProvinceBySlug(provinceSlug)!;
const district = getDistrictsForProvince(provinceSlug).find(
  (d) => d.slug === districtSlug,
)!;
const neighborDistricts = getNeighborDistricts(district);
const postalCodes = getPostalCodesForDistrict(provinceSlug, districtSlug);
const faqs = districtFaqs(district, province.name);
const path = `/iller/${provinceSlug}/${districtSlug}/`;
const image = getDistrictImage(district.id)!;

const summaryStats = [
  { label: "İl", value: province.name },
  { label: "Plaka", value: province.plateCode },
  {
    label: "Alan Kodu",
    value: province.areaCodes.map((c) => `0${c}`).join(" / "),
  },
  {
    label: "Nüfus",
    value: district.population ? formatNumber(district.population) : "—",
  },
  {
    label: "Mahalle",
    value: district.neighborhoodCount
      ? String(district.neighborhoodCount)
      : "—",
  },
  { label: "Yüzölçümü", value: formatArea(district.areaKm2) },
  { label: "Rakım", value: formatElevation(district.elevationM) },
].filter((s) => s.value && s.value !== "—");

const tocCandidates = [
  { id: "genel-bakis", label: "Genel Bakış", show: true },
  {
    id: "mahalleler",
    label: "Mahalleler",
    show: Boolean(district.neighborhoods?.length),
  },
  { id: "posta-kodlari", label: "Posta Kodları", show: postalCodes.length > 0 },
  {
    id: "yasam",
    label: "Yaşam",
    show: Boolean(
      district.transportation ||
      district.education ||
      district.health ||
      district.socialLife,
    ),
  },
  {
    id: "yerler",
    label: "Popüler Yerler",
    show: Boolean(
      district.popularPlaces?.length || district.historicalPlaces?.length,
    ),
  },
  { id: "sss", label: "SSS", show: faqs.length > 0 },
];
const toc = tocCandidates.filter((t) => t.show);

const relatedSearches = [
  { label: `${district.name} hangi ile bağlı?`, href: path },
  {
    label: `${province.name} ilçeleri`,
    href: `/iller/${provinceSlug}/ilceler/`,
  },
  ...postalCodes
    .slice(0, 2)
    .map((p) => ({
      label: `${p.code} posta kodu`,
      href: `/posta-kodlari/${p.code}/`,
    })),
  { label: `${province.name} ili`, href: `/iller/${provinceSlug}/` },
  {
    label: `${province.plateCode} nerenin plakası?`,
    href: `/plaka-kodlari/${province.plateCode}/`,
  },
];

const breadcrumbItems = [
  { label: "İller", href: "/iller/" },
  { label: province.name, href: `/iller/${provinceSlug}/` },
  { label: district.name, href: path },
];
---

<BaseLayout
  title={`${district.name} — ${province.name} İlçesi Hakkında Bilgiler`}
  description={district.summary ??
    `${district.name}, ${province.name} iline bağlı bir ilçedir. Nüfus, mahalle, posta kodu ve daha fazla bilgi.`}
  path={path}
  image={image.openGraph}
>
  <StructuredData
    schema={[
      webPageSchema({
        name: `${district.name} İlçesi`,
        path,
        description:
          district.summary ?? `${district.name} ilçesi hakkında bilgiler`,
      }),
      ...(faqs.length > 0 ? [faqPageSchema(faqs)] : []),
    ]}
  />
  <PageContainer class="py-4">
    <Breadcrumbs items={breadcrumbItems.slice(0)} />
  </PageContainer>

  <PageContainer>
    <div class="relative overflow-hidden rounded-3xl">
      <LocationHero
        image={image}
        priority={true}
        class="absolute inset-0 h-full w-full"
      />
      <div
        class="relative flex min-h-56 flex-col justify-end bg-gradient-to-t from-black/70 via-black/15 to-transparent p-6 sm:min-h-56 sm:p-8 lg:min-h-64"
      >
        <a
          href={`/iller/${provinceSlug}/`}
          class="inline-flex w-fit items-center gap-1 rounded-full bg-white/15 px-3 py-1 text-xs font-semibold text-white backdrop-blur hover:bg-white/25"
        >
          <Icon name="map-pin" size={12} />
          {province.name}
        </a>
        <h1 class="mt-3 text-3xl font-extrabold text-white sm:text-4xl">
          {district.name}
        </h1>
        {
          district.summary && (
            <p class="mt-1.5 max-w-2xl text-sm text-white/90 sm:text-base">
              {district.summary}
            </p>
          )
        }
      </div>
    </div>

    <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-7">
      {
        summaryStats.map((s) => (
          <div class="card p-3 text-center">
            <p class="break-words text-lg font-extrabold text-text-primary">
              {s.value}
            </p>
            <p class="text-xs text-text-secondary">{s.label}</p>
          </div>
        ))
      }
    </div>
  </PageContainer>

  <PageContainer class="mt-6">
    <TableOfContents items={toc} />
  </PageContainer>

  <PageContainer class="grid grid-cols-1 gap-8 py-8 lg:grid-cols-[1fr_320px]">
    <div class="flex flex-col gap-12">
      <section
        id="genel-bakis"
        aria-labelledby="genel-bakis-heading"
        class="scroll-mt-32"
      >
        <h2
          id="genel-bakis-heading"
          class="text-2xl font-extrabold text-text-primary"
        >
          Genel Bakış
        </h2>
        {
          district.summary && (
            <div class="mt-4 rounded-2xl border border-brand-primary/20 bg-brand-purple-soft p-4">
              <p class="text-sm font-semibold text-text-primary">
                <strong>{district.summary}</strong>
              </p>
            </div>
          )
        }
        {
          district.overview && (
            <p class="prose-content mt-4">{district.overview}</p>
          )
        }
        {
          !district.overview && !district.summary && (
            <p class="prose-content mt-4">
              {district.name}, {province.name} iline bağlı bir ilçedir.
              Nüfus, yüzölçümü ve mahalle sayısı gibi temel bilgilere
              yukarıdaki kartlardan ulaşabilirsiniz.
            </p>
          )
        }

        <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2">
          <InfoTable
            title="Genel Bilgiler"
            rows={[
              { label: "Bağlı Olduğu İl", value: province.name },
              {
                label: "Komşu İlçeler",
                value: neighborDistricts.map((d) => d.name).join(", "),
              },
              {
                label: "Kıyısı Olan Denizler",
                value: district.coastline?.join(", ") ?? "",
              },
              { label: "İklim", value: district.climate?.join(", ") ?? "" },
              {
                label: "Merkeze Uzaklık",
                value: district.distanceToCenterKm
                  ? `${district.distanceToCenterKm} km`
                  : "",
              },
            ]}
          />
          <QuickFacts
            title="Hızlı Bilgiler"
            facts={[
              { icon: "car", label: "Plaka Kodu", value: province.plateCode },
              {
                icon: "phone",
                label: "Alan Kodu",
                value: province.areaCodes.map((c) => `0${c}`).join(" / "),
              },
              {
                icon: "mail",
                label: "Posta Kodu",
                value: postalCodes[0]?.code ?? "",
              },
              {
                icon: "users",
                label: "Mahalle Sayısı",
                value: district.neighborhoodCount
                  ? `${district.neighborhoodCount} mahalle`
                  : "",
              },
            ]}
          />
        </div>

        {
          neighborDistricts.length > 0 && (
            <div class="mt-5">
              <h3 class="text-sm font-bold text-text-primary">Komşu İlçeler</h3>
              <div class="mt-2.5 flex flex-wrap gap-2">
                {neighborDistricts.map((d) => (
                  <a href={`/iller/${provinceSlug}/${d.slug}/`} class="pill">
                    {d.name}
                  </a>
                ))}
              </div>
            </div>
          )
        }

        <div class="mt-5">
          <LocationMapCard
            regionSlug={province.region}
            placeName={`${district.name}, ${province.name}`}
            title="Türkiye'deki Konumu"
          />
        </div>
      </section>

      {
        district.neighborhoods && district.neighborhoods.length > 0 && (
          <section
            id="mahalleler"
            aria-labelledby="mahalleler-heading"
            class="scroll-mt-32"
          >
            <SectionHeader
              as="h2"
              id="mahalleler-heading"
              title={`${district.name} Mahalleleri`}
              description={`${district.name} ilçesi ${district.neighborhoods.length} mahalleden oluşur.`}
            />
            <div class="mt-4 flex flex-wrap gap-2">
              {district.neighborhoods.map((n) => (
                <span class="pill cursor-default hover:border-border hover:text-text-secondary hover:bg-surface">
                  {n}
                </span>
              ))}
            </div>
          </section>
        )
      }

      {
        postalCodes.length > 0 && (
          <section
            id="posta-kodlari"
            aria-labelledby="posta-kodlari-heading"
            class="scroll-mt-32"
          >
            <h2
              id="posta-kodlari-heading"
              class="text-2xl font-extrabold text-text-primary"
            >
              Posta Kodları
            </h2>
            <p class="prose-content mt-3">
              {district.name} ilçesindeki bazı mahallelerin posta kodları:
            </p>
            <div class="mt-4 flex flex-wrap gap-2">
              {postalCodes.map((p) => (
                <a href={`/posta-kodlari/${p.code}/`} class="pill font-mono">
                  {p.code}
                </a>
              ))}
            </div>
          </section>
        )
      }

      {
        (district.transportation ||
          district.education ||
          district.health ||
          district.socialLife) && (
          <section
            id="yasam"
            aria-labelledby="yasam-heading"
            class="scroll-mt-32 flex flex-col gap-6"
          >
            <h2
              id="yasam-heading"
              class="text-2xl font-extrabold text-text-primary"
            >
              Yaşam
            </h2>
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
              {district.transportation && (
                <div class="card p-4">
                  <h3 class="flex items-center gap-2 text-sm font-bold text-text-primary">
                    <Icon name="bus" size={16} class="text-brand-primary" />{" "}
                    Ulaşım
                  </h3>
                  <p class="prose-content mt-2 text-sm">
                    {district.transportation}
                  </p>
                </div>
              )}
              {district.education && (
                <div class="card p-4">
                  <h3 class="flex items-center gap-2 text-sm font-bold text-text-primary">
                    <Icon
                      name="graduation-cap"
                      size={16}
                      class="text-brand-primary"
                    />{" "}
                    Eğitim
                  </h3>
                  <p class="prose-content mt-2 text-sm">{district.education}</p>
                </div>
              )}
              {district.health && (
                <div class="card p-4">
                  <h3 class="flex items-center gap-2 text-sm font-bold text-text-primary">
                    <Icon
                      name="heart-pulse"
                      size={16}
                      class="text-brand-primary"
                    />{" "}
                    Sağlık
                  </h3>
                  <p class="prose-content mt-2 text-sm">{district.health}</p>
                </div>
              )}
              {district.socialLife && (
                <div class="card p-4">
                  <h3 class="flex items-center gap-2 text-sm font-bold text-text-primary">
                    <Icon name="users" size={16} class="text-brand-primary" />{" "}
                    Sosyal Yaşam
                  </h3>
                  <p class="prose-content mt-2 text-sm">
                    {district.socialLife}
                  </p>
                </div>
              )}
            </div>
          </section>
        )
      }

      {
        (district.popularPlaces?.length ||
          district.historicalPlaces?.length) && (
          <section
            id="yerler"
            aria-labelledby="yerler-heading"
            class="scroll-mt-32"
          >
            <h2
              id="yerler-heading"
              class="text-2xl font-extrabold text-text-primary"
            >
              Popüler Yerler
            </h2>
            <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
              {[
                ...(district.historicalPlaces ?? []),
                ...(district.popularPlaces ?? []),
              ].map((p, i) => (
                <QuickToolCard
                  icon={p.icon ?? "map-pin"}
                  label={p.label}
                  meta={p.meta}
                  color={
                    ["blue", "green", "purple", "orange", "pink", "cyan"][
                      i % 6
                    ] as never
                  }
                />
              ))}
            </div>
          </section>
        )
      }

      <AdSlot variant="in-article" />

      <div id="sss" class="scroll-mt-32">
        <FAQAccordion faqs={faqs} />
      </div>

      <RelatedSearches items={relatedSearches} />
    </div>

    <aside class="flex flex-col gap-5 lg:sticky lg:top-32 lg:self-start">
      <AdSlot variant="sidebar" />
      <SourcesCard
        sources={district.sources}
        lastReviewed={district.lastReviewed}
      />
    </aside>
  </PageContainer>
</BaseLayout>
