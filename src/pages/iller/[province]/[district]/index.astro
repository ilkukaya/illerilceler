---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import TableOfContents from "@/components/content/TableOfContents.astro";
import FAQAccordion from "@/components/content/FAQAccordion.astro";
import SourcesCard from "@/components/content/SourcesCard.astro";
import InfoBox from "@/components/content/InfoBox.astro";
import TravelLinks from "@/components/content/TravelLinks.astro";
import LocationHero from "@/components/geography/LocationHero.astro";
import AdSlot from "@/components/content/AdSlot.astro";
import { getProvinceBySlug } from "@/data/provinces";
import {
  districts as allDistricts,
  getDistrictsForProvince,
  getNeighborDistricts,
} from "@/data/districts";
import { neighborhoods } from "@/data/neighborhoods";
import { getDistrictImage } from "@/generated/locationImageManifest";
import { formatNumber, formatArea, formatElevation } from "@/utils/format";
import {
  districtFaqs,
  districtLead,
  districtParagraphs,
  districtAreaCodes,
} from "@/utils/content";
import { districtRanks, density, POPULATION_YEAR } from "@/utils/rankings";
import { genitive } from "@/utils/turkish";
import {
  districtPath,
  districtListPath,
  provincePath,
  platePath,
  areaCodePath,
} from "@/utils/links";
import {
  administrativeAreaSchema,
  faqPageSchema,
  webPageSchema,
  absoluteUrl,
} from "@/utils/seo";

export function getStaticPaths() {
  return allDistricts.map((d) => ({
    params: { province: d.provinceSlug, district: d.slug },
    props: { districtId: d.id },
  }));
}

const { districtId } = Astro.props as { districtId: string };
const district = allDistricts.find((d) => d.id === districtId)!;
const province = getProvinceBySlug(district.provinceSlug)!;
const siblings = getDistrictsForProvince(province.slug);
const neighborDistricts = getNeighborDistricts(district);
const postalByName = new Map(
  neighborhoods
    .filter((n) => n.provinceSlug === province.slug && n.districtSlug === district.slug)
    .map((n) => [n.name, n.postalCode]),
);
const faqs = districtFaqs(district, province.name);
const lead = districtLead(district, province);
const paragraphs = districtParagraphs(district, province);
const ranks = districtRanks(district);
const path = districtPath(province.slug, district.slug);
const image = getDistrictImage(district.id)!;
const hasPhoto =
  image.type === "real-photo" || image.type === "ai-photorealistic";
const dens = density(district.population, district.areaKm2);
const areaCodes = districtAreaCodes(district, province);
const areaCodeText = areaCodes.map((c) => `0${c}`).join(" / ");
const modified = district.lastReviewed;

const byPop = [...siblings].sort(
  (a, b) => (b.population ?? 0) - (a.population ?? 0),
);
const idx = byPop.findIndex((d) => d.id === district.id);
const nearbyInRanking = byPop
  .slice(Math.max(0, idx - 3), idx + 4)
  .filter((d) => d.id !== district.id);

const editorialSections = [
  { id: "ulasim", title: "Ulaşım", body: district.transportation },
  { id: "egitim", title: "Eğitim", body: district.education },
  { id: "saglik", title: "Sağlık", body: district.health },
  { id: "sosyal-yasam", title: "Sosyal yaşam", body: district.socialLife },
].filter((s) => s.body);

const places = [
  ...(district.historicalPlaces ?? []),
  ...(district.popularPlaces ?? []),
].filter((p) => !/\d\+/.test(p.meta ?? ""));

const toc = [
  { id: "genel-bakis", label: "Genel bakış" },
  ...(district.neighborhoods?.length
    ? [{ id: "mahalleler", label: "Mahalleler" }]
    : []),
  ...editorialSections.map((s) => ({ id: s.id, label: s.title })),
  { id: "il-icindeki-yeri", label: `${province.name} içindeki yeri` },
  { id: "sss", label: "Sık sorulanlar" },
];

const title = `${district.name} (${province.name}) Nüfusu, Mahalleleri ve Bilgileri — ${POPULATION_YEAR}`;
const description = `${district.name}, ${province.name}: nüfus ${district.population ? formatNumber(district.population) : "—"} (TÜİK ${POPULATION_YEAR}), yüzölçümü ${formatArea(district.areaKm2)}, ${district.neighborhoodCount ?? "—"} mahalle. Plaka ${province.plateCode}, alan kodu ${areaCodeText}.`;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  image={image.openGraph}
  type="article"
  modified={modified}
  schema={[
    administrativeAreaSchema({
      name: `${district.name}, ${province.name}`,
      path,
      description: lead,
      containedIn: province.name,
      containedInPath: provincePath(province.slug),
      population: district.population,
      populationYear: district.populationYear,
      areaKm2: district.areaKm2,
      plateCode: province.plateCode,
      areaCodes,
      image: image.openGraph,
    }),
    webPageSchema({
      name: title,
      path,
      description,
      modified,
      aboutId: `${absoluteUrl(path)}#place`,
    }),
    faqPageSchema(faqs),
  ]}
>
  <div class="container-page pt-4 sm:pt-6">
    <Breadcrumbs
      items={[
        { label: "İller", href: "/iller/" },
        { label: province.name, href: provincePath(province.slug) },
        { label: "İlçeler", href: districtListPath(province.slug) },
        { label: district.name, href: path },
      ]}
    />

    <header class="mt-5 max-w-3xl">
      <p class="section-eyebrow">
        <a href={provincePath(province.slug)} class="hover:text-text-primary"
          >{province.name}</a
        > ilçesi
      </p>
      <h1 class="mt-2 text-4xl leading-[1.1] sm:text-5xl">{district.name}</h1>
      <ul class="mt-4 flex flex-wrap gap-2 text-sm">
        {
          district.population && (
            <li class="pill">
              Nüfus{" "}
              <b class="text-text-primary">
                {formatNumber(district.population)}
              </b>
            </li>
          )
        }
        {
          district.neighborhoodCount && (
            <li class="pill">
              <b class="text-text-primary">{district.neighborhoodCount}</b>{" "}
              mahalle
            </li>
          )
        }
        <li>
          <a class="pill" href={platePath(province.plateCode)}
            >Plaka <b class="text-text-primary">{province.plateCode}</b></a
          >
        </li>
        {
          areaCodes.map((c) => (
            <li>
              <a class="pill" href={areaCodePath(c)}>
                Alan kodu <b class="text-text-primary">0{c}</b>
              </a>
            </li>
          ))
        }
      </ul>
    </header>

    <div
      class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,1fr)_320px] xl:gap-14"
    >
      <article class="min-w-0">
        {
          hasPhoto && (
            <div class="relative mb-8 aspect-[16/7] overflow-hidden rounded-xl">
              <LocationHero
                image={image}
                priority={true}
                class="absolute inset-0 h-full w-full"
              />
            </div>
          )
        }

        <p class="answer-box">{lead}</p>

        <section id="genel-bakis" class="mt-10 scroll-mt-24">
          <h2 class="text-2xl sm:text-[1.75rem]">Genel bakış</h2>
          <div class="prose-content mt-4 max-w-3xl">
            {district.overview && <p>{district.overview}</p>}
            {paragraphs.map((p) => <p>{p}</p>)}
          </div>
          {
            places.length > 0 && (
              <div class="mt-5">
                <p class="section-eyebrow">Öne çıkan yerler</p>
                <ul class="mt-2 flex flex-wrap gap-2">
                  {places.map((p) => (
                    <li class="chip">{p.label}</li>
                  ))}
                </ul>
              </div>
            )
          }
        </section>

        <AdSlot variant="in-article" />

        {
          district.neighborhoods && district.neighborhoods.length > 0 && (
            <section id="mahalleler" class="mt-10 scroll-mt-24">
              <h2 class="text-2xl sm:text-[1.75rem]">
                {district.name} mahalleleri
              </h2>
              <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-1.5 text-[15px] sm:grid-cols-3">
                {[...district.neighborhoods]
                  .sort((a, b) => a.localeCompare(b, "tr"))
                  .map((n) => {
                    const pc = postalByName.get(n);
                    return (
                      <li class="flex justify-between gap-2 border-b border-border py-1.5">
                        <span>{n}</span>
                        {pc && (
                          <a
                            href={`/posta-kodlari/${pc}/`}
                            class="tabular text-sm text-text-muted hover:text-text-primary"
                          >
                            {pc}
                          </a>
                        )}
                      </li>
                    );
                  })}
              </ul>
            </section>
          )
        }

        {
          editorialSections.map((s) => (
            <section id={s.id} class="mt-12 scroll-mt-24">
              <h2 class="text-2xl sm:text-[1.75rem]">{s.title}</h2>
              <div class="prose-content mt-4 max-w-3xl">
                <p>{s.body}</p>
              </div>
            </section>
          ))
        }

        <TravelLinks
          place={district.name}
          province={province.name}
          class="mt-12"
        />

        <section id="il-icindeki-yeri" class="mt-12 scroll-mt-24">
          <h2 class="text-2xl sm:text-[1.75rem]">
            {genitive(province.name)} ilçeleri arasında {district.name}
          </h2>
          <p class="mt-2 text-sm text-text-secondary">
            Nüfusa göre sıralamada {district.name} ve çevresindeki ilçeler.
          </p>
          <div
            class="mt-4 overflow-x-auto rounded-xl border border-border bg-surface"
          >
            <table class="data-table">
              <thead>
                <tr>
                  <th scope="col" class="num w-10">#</th>
                  <th scope="col">İlçe</th>
                  <th scope="col" class="num">Nüfus</th>
                  <th scope="col" class="num">km²</th>
                </tr>
              </thead>
              <tbody>
                {
                  [...nearbyInRanking, district]
                    .sort((a, b) => (b.population ?? 0) - (a.population ?? 0))
                    .map((d) => (
                      <tr class:list={[d.id === district.id && "font-semibold"]}>
                        <td class="num text-text-muted">
                          {byPop.findIndex((x) => x.id === d.id) + 1}
                        </td>
                        <td>
                          {d.id === district.id ? (
                            d.name
                          ) : (
                            <a
                              href={districtPath(province.slug, d.slug)}
                              class="hover:text-brand-primary hover:underline"
                            >
                              {d.name}
                            </a>
                          )}
                        </td>
                        <td class="num">
                          {d.population ? formatNumber(d.population) : "—"}
                        </td>
                        <td class="num">
                          {d.areaKm2 ? formatNumber(d.areaKm2) : "—"}
                        </td>
                      </tr>
                    ))
                }
              </tbody>
            </table>
          </div>
          <a
            href={districtListPath(province.slug)}
            class="link mt-3 inline-block text-sm"
            >{genitive(province.name)} tüm {siblings.length} ilçesi →</a
          >
          {
            neighborDistricts.length > 0 && (
              <>
                <h3 class="mt-6 text-base">Komşu ilçeler</h3>
                <ul class="mt-2 flex flex-wrap gap-2">
                  {neighborDistricts.map((n) => (
                    <li>
                      <a class="pill" href={districtPath(province.slug, n.slug)}>
                        {n.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            )
          }
        </section>

        <AdSlot variant="in-article" />

        <div class="mt-12">
          <FAQAccordion
            faqs={faqs}
            title={`${district.name} hakkında sık sorulanlar`}
          />
        </div>

        <div class="mt-10">
          <SourcesCard
            sources={district.sources ?? [
              { name: "TÜİK ADNKS", url: "https://data.tuik.gov.tr" },
              { name: "Harita Genel Müdürlüğü", url: "https://www.harita.gov.tr" },
            ]}
            lastReviewed={district.lastReviewed}
          />
        </div>
      </article>

      <aside class="lg:block">
        <div class="space-y-6 lg:sticky lg:top-24">
          <InfoBox
            title={district.name}
            subtitle={`${province.name} ilçesi`}
            map={{
              highlight: [province.slug],
              label: `${genitive(district.name)} bağlı olduğu ${province.name} ilinin konumu`,
            }}
            rows={[
              { label: "İl", value: province.name, href: provincePath(province.slug) },
              { label: `Nüfus (${district.populationYear ?? POPULATION_YEAR})`, value: district.population ? formatNumber(district.population) : "" },
              { label: "Yüzölçümü", value: formatArea(district.areaKm2) },
              { label: "Yoğunluk", value: dens ? `${formatNumber(Math.round(dens))} kişi/km²` : "" },
              { label: "Mahalle sayısı", value: district.neighborhoodCount ? String(district.neighborhoodCount) : "" },
              { label: "İl içi nüfus sırası", value: ranks.provincePopulation ? `${ranks.provincePopulation} / ${ranks.siblings}` : "" },
              { label: "Türkiye sırası", value: ranks.nationalPopulation ? `${ranks.nationalPopulation} / ${ranks.total}` : "" },
              { label: "Plaka kodu", value: province.plateCode, href: platePath(province.plateCode) },
              { label: "Alan kodu", value: areaCodeText },
              { label: "Rakım", value: district.elevationM !== undefined ? formatElevation(district.elevationM) : "" },
            ]}
          />
          <div class="hidden lg:block">
            <TableOfContents items={toc} />
          </div>
          <AdSlot variant="sidebar" class="!my-0 hidden lg:block" />
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
