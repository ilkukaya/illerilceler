---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import TableOfContents from "@/components/content/TableOfContents.astro";
import FAQAccordion from "@/components/content/FAQAccordion.astro";
import SourcesCard from "@/components/content/SourcesCard.astro";
import InfoBox from "@/components/content/InfoBox.astro";
import SortableTable from "@/components/content/SortableTable.astro";
import TravelLinks from "@/components/content/TravelLinks.astro";
import LocationHero from "@/components/geography/LocationHero.astro";
import AdSlot from "@/components/content/AdSlot.astro";
import { provinces, getNeighborProvinces } from "@/data/provinces";
import { getRegion } from "@/data/regions";
import { getDistrictsForProvince } from "@/data/districts";
import { getProvinceImage } from "@/generated/locationImageManifest";
import { formatNumber, formatArea, formatElevation } from "@/utils/format";
import {
  provinceFaqs,
  provinceLead,
  provinceParagraphs,
} from "@/utils/content";
import {
  provinceRanks,
  density,
  nearestProvinces,
  POPULATION_YEAR,
} from "@/utils/rankings";
import { genitive } from "@/utils/turkish";
import {
  distancePath,
  districtListPath,
  districtPath,
  platePath,
  areaCodePath,
  provincePath,
} from "@/utils/links";
import {
  administrativeAreaSchema,
  faqPageSchema,
  webPageSchema,
  absoluteUrl,
} from "@/utils/seo";

export function getStaticPaths() {
  return provinces.map((p) => ({
    params: { province: p.slug },
    props: { province: p },
  }));
}

const { province } = Astro.props as { province: (typeof provinces)[number] };
const region = getRegion(province.region);
const neighbors = getNeighborProvinces(province);
const districts = getDistrictsForProvince(province.slug);
const faqs = provinceFaqs(province);
const lead = provinceLead(province);
const paragraphs = provinceParagraphs(province);
const ranks = provinceRanks(province);
const nearest = nearestProvinces(province, 8);
const path = provincePath(province.slug);
const image = getProvinceImage(province.slug)!;
const hasPhoto =
  image.type === "real-photo" || image.type === "ai-photorealistic";
const dens = density(province.population, province.areaKm2);
const sameRegion = provinces
  .filter((p) => p.region === province.region && p.slug !== province.slug)
  .sort((a, b) => a.name.localeCompare(b.name, "tr"));
const areaCodes = province.areaCodes.map((c) => `0${c}`).join(" / ");
const modified = province.lastReviewed;

const districtRows = [...districts]
  .sort((a, b) => (b.population ?? 0) - (a.population ?? 0))
  .map((d) => {
    const dd = density(d.population, d.areaKm2);
    return {
      name: {
        text: d.name,
        sort: d.name,
        href: districtPath(province.slug, d.slug),
      },
      population: {
        text: d.population ? formatNumber(d.population) : "—",
        sort: d.population ?? 0,
      },
      area: {
        text: d.areaKm2 ? formatNumber(d.areaKm2) : "—",
        sort: d.areaKm2 ?? 0,
      },
      density: { text: dd ? formatNumber(Math.round(dd)) : "—", sort: dd ?? 0 },
      mahalle: {
        text: d.neighborhoodCount ? String(d.neighborhoodCount) : "—",
        sort: d.neighborhoodCount ?? 0,
      },
    };
  });

const editorialSections = [
  { id: "tarihce", title: "Tarihçe", body: province.history },
  { id: "ekonomi", title: "Ekonomi", body: province.economy },
  { id: "turizm", title: "Turizm ve gezilecek yerler", body: province.tourism },
  { id: "ulasim", title: "Ulaşım", body: province.transportation },
  { id: "egitim", title: "Eğitim", body: province.education },
].filter((s) => s.body);

const toc = [
  { id: "genel-bakis", label: "Genel bakış" },
  { id: "ilceler", label: `İlçeler (${districts.length})` },
  { id: "cografya", label: "Coğrafya ve komşular" },
  ...editorialSections.map((s) => ({ id: s.id, label: s.title })),
  { id: "siralamalar", label: "Sıralamalar" },
  { id: "sss", label: "Sık sorulanlar" },
];

const rankRows = [
  {
    label: "Nüfus",
    rank: ranks.population,
    value: province.population ? formatNumber(province.population) : "",
    href: "/istatistikler/en-kalabalik-iller/",
  },
  {
    label: "Yüzölçümü",
    rank: ranks.area,
    value: province.areaKm2 ? formatArea(province.areaKm2) : "",
    href: "/istatistikler/yuzolcumune-gore-en-buyuk-iller/",
  },
  {
    label: "Nüfus yoğunluğu",
    rank: ranks.density,
    value: dens ? `${formatNumber(Math.round(dens))} kişi/km²` : "",
    href: "/istatistikler/nufus-yogunluguna-gore-iller/",
  },
  {
    label: "Rakım (il merkezi)",
    rank: ranks.elevation,
    value: formatElevation(province.elevationM),
    href: "/istatistikler/rakima-gore-iller/",
  },
].filter((r) => r.rank && r.value);

const title = `${province.name} İli: Nüfusu, İlçeleri, Plaka ve Alan Kodu (${POPULATION_YEAR})`;
const description = `${province.name} nüfusu ${province.population ? formatNumber(province.population) : ""} (TÜİK ${POPULATION_YEAR}). Plaka kodu ${province.plateCode}, alan kodu ${areaCodes}. ${districts.length} ilçenin nüfusu, yüzölçümü, komşu iller, harita ve mesafeler.`;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  image={image.openGraph}
  type="article"
  modified={modified}
  schema={[
    administrativeAreaSchema({
      name: province.name,
      path,
      description: lead,
      containedIn: "Türkiye",
      latitude: province.coordinates?.lat,
      longitude: province.coordinates?.lng,
      population: province.population,
      populationYear: province.populationYear,
      areaKm2: province.areaKm2,
      plateCode: province.plateCode,
      areaCodes: province.areaCodes,
      image: image.openGraph,
    }),
    webPageSchema({
      name: title,
      path,
      description,
      modified,
      aboutId: `${absoluteUrl(path)}#place`,
    }),
    faqPageSchema(faqs),
  ]}
>
  <div class="container-page pt-4 sm:pt-6">
    <Breadcrumbs
      items={[
        { label: "İller", href: "/iller/" },
        { label: province.name, href: path },
      ]}
    />

    <header class="mt-5 max-w-3xl">
      <p class="section-eyebrow">
        {region?.name ?? "İl"} · Plaka {province.plateCode}
      </p>
      <h1 class="mt-2 text-4xl leading-[1.1] sm:text-5xl">{province.name}</h1>
      <ul class="mt-4 flex flex-wrap gap-2 text-sm">
        <li>
          <a class="pill" href={platePath(province.plateCode)}
            >Plaka <b class="text-text-primary">{province.plateCode}</b></a
          >
        </li>
        {
          province.areaCodes.map((c) => (
            <li>
              <a class="pill" href={areaCodePath(c)}>
                Alan kodu <b class="text-text-primary">0{c}</b>
              </a>
            </li>
          ))
        }
        {
          province.population && (
            <li class="pill">
              Nüfus{" "}
              <b class="text-text-primary">
                {formatNumber(province.population)}
              </b>
            </li>
          )
        }
        <li>
          <a class="pill" href={districtListPath(province.slug)}>
            <b class="text-text-primary">{districts.length}</b> ilçe
          </a>
        </li>
      </ul>
    </header>

    <div
      class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,1fr)_320px] xl:gap-14"
    >
      <article class="min-w-0">
        {
          hasPhoto && (
            <div class="relative mb-8 aspect-[16/7] overflow-hidden rounded-xl">
              <LocationHero
                image={image}
                priority={true}
                class="absolute inset-0 h-full w-full"
              />
            </div>
          )
        }

        <p class="answer-box">{lead}</p>

        <!-- Mobile infobox: facts first on small screens -->
        <div class="mt-6 lg:hidden">
          <InfoBox
            title={province.name}
            subtitle={region?.name}
            map={{
              highlight: [province.slug],
              secondary: neighbors.map((n) => n.slug),
              label: `${genitive(province.name)} Türkiye haritasındaki konumu`,
            }}
            rows={[
              { label: "Plaka kodu", value: province.plateCode, href: platePath(province.plateCode) },
              { label: "Alan kodu", value: areaCodes },
              { label: "Nüfus", value: province.population ? formatNumber(province.population) : "" },
              { label: "Yüzölçümü", value: formatArea(province.areaKm2) },
              { label: "İlçe / mahalle", value: `${districts.length} / ${province.neighborhoodCount ? formatNumber(province.neighborhoodCount) : "—"}` },
            ]}
          />
        </div>

        <section id="genel-bakis" class="mt-10 scroll-mt-24">
          <h2 class="text-2xl sm:text-[1.75rem]">Genel bakış</h2>
          <div class="prose-content mt-4 max-w-3xl">
            {province.overview && <p>{province.overview}</p>}
            {paragraphs.map((p) => <p>{p}</p>)}
          </div>
          {
            province.famousFor && province.famousFor.length > 0 && (
              <div class="mt-5">
                <p class="section-eyebrow">Neyiyle ünlü?</p>
                <ul class="mt-2 flex flex-wrap gap-2">
                  {province.famousFor.map((f) => (
                    <li class="chip">{f.label}</li>
                  ))}
                </ul>
              </div>
            )
          }
        </section>

        <AdSlot variant="in-article" />

        <section id="ilceler" class="mt-10 scroll-mt-24">
          <div class="flex flex-wrap items-end justify-between gap-3">
            <h2 class="text-2xl sm:text-[1.75rem]">
              {province.name} ilçeleri
            </h2>
            <a href={districtListPath(province.slug)} class="link text-sm"
              >İlçe listesi sayfası →</a
            >
          </div>
          <p class="mt-2 text-sm text-text-secondary">
            {genitive(province.name)}
            {districts.length} ilçesi nüfusa göre sıralanmıştır. Sütun
            başlıklarına dokunarak sıralamayı değiştirebilirsiniz.
          </p>
          <SortableTable
            class="mt-4"
            id="ilce-tablosu"
            rank
            caption={`${province.name} ilçeleri nüfus, yüzölçümü ve mahalle sayısı`}
            columns={[
              { key: "name", label: "İlçe" },
              { key: "population", label: "Nüfus", numeric: true },
              { key: "area", label: "km²", numeric: true },
              { key: "density", label: "Kişi/km²", numeric: true },
              { key: "mahalle", label: "Mahalle", numeric: true },
            ]}
            rows={districtRows}
          />
          <p class="mt-2 text-xs text-text-muted">
            Kaynak: TÜİK ADNKS {POPULATION_YEAR}, Harita Genel Müdürlüğü.
          </p>
        </section>

        <section id="cografya" class="mt-12 scroll-mt-24">
          <h2 class="text-2xl sm:text-[1.75rem]">Coğrafya ve komşular</h2>
          {
            neighbors.length > 0 && (
              <>
                <h3 class="mt-5 text-base">Komşu iller</h3>
                <ul class="mt-2 flex flex-wrap gap-2">
                  {neighbors.map((n) => (
                    <li>
                      <a class="pill" href={provincePath(n.slug)}>
                        {n.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            )
          }
          {
            nearest.length > 0 && (
              <>
                <h3 class="mt-6 text-base">
                  En yakın il merkezleri (kuş uçuşu)
                </h3>
                <div class="mt-2 overflow-x-auto rounded-xl border border-border bg-surface">
                  <table class="data-table">
                    <thead>
                      <tr>
                        <th scope="col">İl</th>
                        <th scope="col" class="num">
                          Kuş uçuşu
                        </th>
                        <th scope="col" class="num">
                          Detay
                        </th>
                      </tr>
                    </thead>
                    <tbody>
                      {nearest.map((x) => (
                        <tr>
                          <td>
                            <a
                              href={provincePath(x.province.slug)}
                              class="font-medium hover:text-brand-primary hover:underline"
                            >
                              {x.province.name}
                            </a>
                          </td>
                          <td class="num">{formatNumber(Math.round(x.km))} km</td>
                          <td class="num">
                            <a
                              class="link text-sm"
                              href={distancePath(province.slug, x.province.slug)}
                            >
                              {province.name}–{x.province.name}
                            </a>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </>
            )
          }
        </section>

        {
          editorialSections.map((s, i) => (
            <>
              <section id={s.id} class="mt-12 scroll-mt-24">
                <h2 class="text-2xl sm:text-[1.75rem]">{s.title}</h2>
                <div class="prose-content mt-4 max-w-3xl">
                  <p>{s.body}</p>
                </div>
                {s.id === "egitim" &&
                  province.universities &&
                  province.universities.length > 0 && (
                    <ul class="mt-4 flex flex-wrap gap-2">
                      {province.universities.map((u) => (
                        <li class="chip">{u}</li>
                      ))}
                    </ul>
                  )}
              </section>
              {i === 1 && <AdSlot variant="in-article" />}
            </>
          ))
        }

        <TravelLinks place={province.name} province={province.name} class="mt-12" />

        <section id="siralamalar" class="mt-12 scroll-mt-24">
          <h2 class="text-2xl sm:text-[1.75rem]">
            {province.name} Türkiye sıralamasında
          </h2>
          <div class="mt-4 grid gap-3 sm:grid-cols-2">
            {
              rankRows.map((r) => (
                <a
                  href={r.href}
                  class="card card-hover flex items-center justify-between gap-4 p-4"
                >
                  <span>
                    <span class="block text-sm text-text-secondary">
                      {r.label}
                    </span>
                    <span class="tabular block font-medium">{r.value}</span>
                  </span>
                  <span class="tabular text-right">
                    <span class="block font-serif text-3xl font-semibold leading-none">
                      {r.rank}.
                    </span>
                    <span class="text-xs text-text-muted">81 il içinde</span>
                  </span>
                </a>
              ))
            }
          </div>
        </section>

        <div class="mt-12">
          <FAQAccordion faqs={faqs} title={`${province.name} hakkında sık sorulanlar`} />
        </div>

        {
          region && sameRegion.length > 0 && (
            <section class="mt-12" aria-labelledby="bolge-heading">
              <h2 id="bolge-heading" class="font-sans text-base font-semibold">
                {region.name} illeri
              </h2>
              <ul class="mt-3 flex flex-wrap gap-2">
                {sameRegion.map((p) => (
                  <li>
                    <a class="pill" href={provincePath(p.slug)}>
                      {p.name}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <div class="mt-10">
          <SourcesCard
            sources={province.sources ?? [
              { name: "TÜİK ADNKS", url: "https://data.tuik.gov.tr" },
              { name: "Harita Genel Müdürlüğü", url: "https://www.harita.gov.tr" },
            ]}
            lastReviewed={province.lastReviewed}
          />
        </div>
      </article>

      <aside class="hidden lg:block">
        <div class="sticky top-24 space-y-6">
          <InfoBox
            title={province.name}
            subtitle={region?.name}
            map={{
              highlight: [province.slug],
              secondary: neighbors.map((n) => n.slug),
              label: `${genitive(province.name)} Türkiye haritasındaki konumu`,
            }}
            rows={[
              { label: "Plaka kodu", value: province.plateCode, href: platePath(province.plateCode) },
              { label: "Alan kodu", value: areaCodes },
              { label: `Nüfus (${province.populationYear ?? POPULATION_YEAR})`, value: province.population ? formatNumber(province.population) : "" },
              { label: "Yüzölçümü", value: formatArea(province.areaKm2) },
              { label: "Yoğunluk", value: dens ? `${formatNumber(Math.round(dens))} kişi/km²` : "" },
              { label: "İlçe sayısı", value: String(districts.length), href: districtListPath(province.slug) },
              { label: "Mahalle sayısı", value: province.neighborhoodCount ? formatNumber(province.neighborhoodCount) : "" },
              { label: "Rakım", value: formatElevation(province.elevationM) },
              { label: "Merkez", value: province.administrativeCenter ?? "" },
            ]}
          />
          <TableOfContents items={toc} />
          <AdSlot variant="sidebar" class="!my-0" />
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
