---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageContainer from "@/components/layout/PageContainer.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import DistrictCard from "@/components/cards/DistrictCard.astro";
import Icon from "@/components/Icon.astro";
import { getProvinceBySlug } from "@/data/provinces";
import {
  districtNamesByProvince,
  getDistrictsForProvince,
} from "@/data/districts";
import { formatNumber } from "@/utils/format";

export function getStaticPaths() {
  return Object.keys(districtNamesByProvince).map((provinceSlug) => ({
    params: { province: provinceSlug },
  }));
}

const { province: provinceSlug } = Astro.params;
const province = getProvinceBySlug(provinceSlug!)!;
const districts = getDistrictsForProvince(provinceSlug!);
const totalPopulation = districts.reduce(
  (sum, d) => sum + (d.population ?? 0),
  0,
);
const totalNeighborhoods = districts.reduce(
  (sum, d) => sum + (d.neighborhoodCount ?? 0),
  0,
);
const path = `/iller/${provinceSlug}/ilceler/`;
---

<BaseLayout
  title={`${province.name} İlçeleri — Tüm İlçeler Listesi`}
  description={`${province.name} iline bağlı ${districts.length} ilçenin listesi, nüfus ve mahalle bilgileriyle birlikte.`}
  path={path}
>
  <PageContainer class="py-4">
    <Breadcrumbs
      items={[
        { label: "İller", href: "/iller/" },
        { label: province.name, href: `/iller/${provinceSlug}/` },
        { label: "İlçeler", href: path },
      ]}
    />
  </PageContainer>

  <PageContainer class="pb-16">
    <h1 class="text-3xl font-extrabold text-text-primary sm:text-4xl">
      {province.name} İlçeleri
    </h1>
    <p class="prose-content mt-3 max-w-2xl">
      {province.name} iline bağlı {districts.length} ilçe bulunmaktadır.
    </p>

    <div class="mt-6 grid grid-cols-3 gap-3 sm:max-w-lg">
      <div class="card p-3 text-center">
        <p class="text-xl font-extrabold text-text-primary">
          {districts.length}
        </p>
        <p class="text-xs text-text-secondary">İlçe Sayısı</p>
      </div>
      <div class="card p-3 text-center">
        <p class="text-xl font-extrabold text-text-primary">
          {totalNeighborhoods ? formatNumber(totalNeighborhoods) : "—"}
        </p>
        <p class="text-xs text-text-secondary">Toplam Mahalle</p>
      </div>
      <div class="card p-3 text-center">
        <p class="text-xl font-extrabold text-text-primary">
          {totalPopulation ? formatNumber(totalPopulation) : "—"}
        </p>
        <p class="text-xs text-text-secondary">Toplam Nüfus</p>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
      <div class="relative max-w-xs flex-1">
        <Icon
          name="search"
          size={17}
          class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-text-muted"
        />
        <input
          id="district-search"
          type="text"
          placeholder="İlçe ara..."
          class="h-11 w-full rounded-xl border border-border bg-surface pl-10 pr-4 text-sm text-text-primary placeholder:text-text-muted outline-none focus:border-brand-primary"
        />
      </div>
      <div class="flex items-center gap-2">
        <select
          id="district-sort"
          class="h-11 rounded-xl border border-border bg-surface px-3 text-sm text-text-primary outline-none focus:border-brand-primary"
        >
          <option value="name-asc">Alfabetik (A-Z)</option>
          <option value="population-desc">Nüfusa Göre</option>
        </select>
        <div
          class="flex items-center rounded-xl border border-border p-0.5"
          role="group"
          aria-label="Görünüm"
        >
          <button
            type="button"
            id="view-grid"
            class="view-toggle-btn rounded-lg p-2"
            aria-pressed="true"
            aria-label="Izgara görünümü"
          >
            <Icon name="layout-grid" size={16} />
          </button>
          <button
            type="button"
            id="view-list"
            class="view-toggle-btn rounded-lg p-2"
            aria-pressed="false"
            aria-label="Liste görünümü"
          >
            <Icon name="list" size={16} />
          </button>
        </div>
      </div>
    </div>

    <div
      class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4"
      id="district-grid"
    >
      {
        districts.map((d) => (
          <div
            class="district-grid-item"
            data-name={d.name}
            data-population={d.population ?? 0}
          >
            <DistrictCard district={d} provinceSlug={provinceSlug!} />
          </div>
        ))
      }
    </div>
    <p
      id="district-empty"
      class="hidden py-16 text-center text-sm text-text-secondary"
    >
      Aramanızla eşleşen ilçe bulunamadı.
    </p>
  </PageContainer>
</BaseLayout>

<script>
  const searchInput = document.getElementById(
    "district-search",
  ) as HTMLInputElement | null;
  const sortSelect = document.getElementById(
    "district-sort",
  ) as HTMLSelectElement | null;
  const grid = document.getElementById("district-grid");
  const emptyState = document.getElementById("district-empty");
  const items = Array.from(
    document.querySelectorAll<HTMLElement>(".district-grid-item"),
  );
  const gridBtn = document.getElementById("view-grid");
  const listBtn = document.getElementById("view-list");

  function applyFilter() {
    const q = (searchInput?.value ?? "").trim().toLocaleLowerCase("tr-TR");
    let visible = 0;
    items.forEach((el) => {
      const match =
        !q || (el.dataset.name ?? "").toLocaleLowerCase("tr-TR").includes(q);
      el.classList.toggle("hidden", !match);
      if (match) visible++;
    });
    emptyState?.classList.toggle("hidden", visible !== 0);
  }

  function applySort() {
    const value = sortSelect?.value ?? "name-asc";
    const sortedItems = [...items].sort((a, b) => {
      if (value === "population-desc")
        return Number(b.dataset.population) - Number(a.dataset.population);
      return (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "", "tr");
    });
    sortedItems.forEach((el) => grid?.appendChild(el));
  }

  searchInput?.addEventListener("input", applyFilter);
  sortSelect?.addEventListener("change", applySort);

  gridBtn?.addEventListener("click", () => {
    grid?.classList.remove("district-grid--list");
    gridBtn.setAttribute("aria-pressed", "true");
    listBtn?.setAttribute("aria-pressed", "false");
  });
  listBtn?.addEventListener("click", () => {
    grid?.classList.add("district-grid--list");
    listBtn.setAttribute("aria-pressed", "true");
    gridBtn?.setAttribute("aria-pressed", "false");
  });
</script>

<style>
  .view-toggle-btn[aria-pressed="true"] {
    background-color: var(--brand-purple-soft);
    color: var(--brand-primary);
  }
  .view-toggle-btn[aria-pressed="false"] {
    color: var(--color-text-muted);
  }
  #district-grid.district-grid--list {
    grid-template-columns: 1fr;
  }
  #district-grid.district-grid--list .card {
    flex-direction: row;
    align-items: center;
  }
  #district-grid.district-grid--list .card > div:first-child {
    width: 96px;
    height: 72px;
    flex-shrink: 0;
  }
</style>
