---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import SortableTable from "@/components/content/SortableTable.astro";
import FAQAccordion from "@/components/content/FAQAccordion.astro";
import LocatorMap from "@/components/geography/LocatorMap.astro";
import AdSlot from "@/components/content/AdSlot.astro";
import { provinces } from "@/data/provinces";
import { getDistrictsForProvince } from "@/data/districts";
import { formatNumber } from "@/utils/format";
import { density, POPULATION_YEAR } from "@/utils/rankings";
import { genitive, copula, withAnd } from "@/utils/turkish";
import { provincePath, districtPath, districtListPath } from "@/utils/links";
import { itemListSchema, webPageSchema, faqPageSchema } from "@/utils/seo";

export function getStaticPaths() {
  return provinces.map((p) => ({ params: { province: p.slug }, props: { province: p } }));
}

const { province } = Astro.props as { province: (typeof provinces)[number] };
const districts = getDistrictsForProvince(province.slug);
const byPop = [...districts].sort((a, b) => (b.population ?? 0) - (a.population ?? 0));
const byArea = [...districts].sort((a, b) => (b.areaKm2 ?? 0) - (a.areaKm2 ?? 0));
const alpha = [...districts].sort((a, b) => a.name.localeCompare(b.name, "tr"));
const path = districtListPath(province.slug);
const totalMahalle = districts.reduce((s, d) => s + (d.neighborhoodCount ?? 0), 0);

const rows = byPop.map((d) => {
  const dd = density(d.population, d.areaKm2);
  return {
    name: { text: d.name, sort: d.name, href: districtPath(province.slug, d.slug) },
    population: { text: d.population ? formatNumber(d.population) : "—", sort: d.population ?? 0 },
    area: { text: d.areaKm2 ? formatNumber(d.areaKm2) : "—", sort: d.areaKm2 ?? 0 },
    density: { text: dd ? formatNumber(Math.round(dd)) : "—", sort: dd ?? 0 },
    mahalle: { text: d.neighborhoodCount ? String(d.neighborhoodCount) : "—", sort: d.neighborhoodCount ?? 0 },
  };
});

const lead = `${genitive(province.name)} ${districts.length} ilçesi vardır: ${withAnd(alpha.map((d) => d.name))}.${
  byPop.length > 1
    ? ` En kalabalık ilçe ${formatNumber(byPop[0].population ?? 0)} kişiyle ${byPop[0].name}, yüzölçümü en büyük ilçe ${formatNumber(byArea[0].areaKm2 ?? 0)} km² ile ${copula(byArea[0].name)}.`
    : ""
}`;

const faqs = [
  { question: `${province.name} kaç ilçe var?`, answer: `${genitive(province.name)} ${districts.length} ilçesi vardır.` },
  { question: `${genitive(province.name)} ilçeleri nelerdir?`, answer: `${withAnd(alpha.map((d) => d.name))}.` },
  ...(byPop.length > 1
    ? [
        { question: `${genitive(province.name)} en kalabalık ilçesi hangisidir?`, answer: `TÜİK ${POPULATION_YEAR} verilerine göre ${formatNumber(byPop[0].population ?? 0)} kişiyle ${copula(byPop[0].name)}.` },
        { question: `${genitive(province.name)} en az nüfuslu ilçesi hangisidir?`, answer: `${formatNumber(byPop[byPop.length - 1].population ?? 0)} kişiyle ${copula(byPop[byPop.length - 1].name)}.` },
      ]
    : []),
  { question: `${province.name} kaç mahalle var?`, answer: `${genitive(province.name)} ilçelerinde toplam ${formatNumber(totalMahalle)} mahalle bulunur.` },
];

const title = `${province.name} İlçeleri: ${districts.length} İlçe, Nüfusları ve Mahalle Sayıları (${POPULATION_YEAR})`;
const description = `${genitive(province.name)} ${districts.length} ilçesi nüfusa göre sıralı: ${byPop.slice(0, 4).map((d) => d.name).join(", ")}… TÜİK ${POPULATION_YEAR} nüfusu, yüzölçümü, yoğunluk ve mahalle sayısı.`;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  image={`/og/provinces/${province.slug}.jpg`}
  schema={[
    webPageSchema({ name: title, path, description }),
    itemListSchema(byPop.map((d) => ({ name: d.name, href: districtPath(province.slug, d.slug) }))),
    faqPageSchema(faqs),
  ]}
>
  <div class="container-page pt-4 sm:pt-6">
    <Breadcrumbs
      items={[
        { label: "İller", href: "/iller/" },
        { label: province.name, href: provincePath(province.slug) },
        { label: "İlçeler", href: path },
      ]}
    />
    <div class="mt-5 grid gap-10 lg:grid-cols-[minmax(0,1fr)_300px]">
      <article class="min-w-0">
        <p class="section-eyebrow">Plaka {province.plateCode}</p>
        <h1 class="mt-2 text-4xl leading-[1.1] sm:text-5xl">{province.name} ilçeleri</h1>
        <p class="answer-box mt-6">{lead}</p>
        <SortableTable
          class="mt-8"
          id="ilceler"
          rank
          caption={`${province.name} ilçeleri`}
          columns={[
            { key: "name", label: "İlçe" },
            { key: "population", label: "Nüfus", numeric: true },
            { key: "area", label: "km²", numeric: true },
            { key: "density", label: "Kişi/km²", numeric: true },
            { key: "mahalle", label: "Mahalle", numeric: true },
          ]}
          rows={rows}
        />
        <p class="mt-2 text-xs text-text-muted">Kaynak: TÜİK ADNKS {POPULATION_YEAR}, Harita Genel Müdürlüğü.</p>
        <AdSlot variant="in-article" />
        <div class="mt-10"><FAQAccordion faqs={faqs} /></div>
      </article>
      <aside>
        <div class="card p-4 lg:sticky lg:top-24">
          <LocatorMap highlight={[province.slug]} label={`${genitive(province.name)} konumu`} />
          <a href={provincePath(province.slug)} class="link mt-3 inline-block text-sm">{province.name} il sayfası →</a>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
