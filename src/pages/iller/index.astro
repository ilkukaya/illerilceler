---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import SortableTable from "@/components/content/SortableTable.astro";
import ProvinceMap from "@/components/geography/ProvinceMap.astro";
import FAQAccordion from "@/components/content/FAQAccordion.astro";
import AdSlot from "@/components/content/AdSlot.astro";
import { provinces } from "@/data/provinces";
import { getRegion, regions } from "@/data/regions";
import { formatNumber } from "@/utils/format";
import { density, POPULATION_YEAR, TOTAL_POPULATION } from "@/utils/rankings";
import { provincePath } from "@/utils/links";
import { itemListSchema, webPageSchema, faqPageSchema } from "@/utils/seo";

const path = "/iller/";
const sorted = [...provinces].sort((a, b) => Number(a.plateCode) - Number(b.plateCode));
const rows = sorted.map((p) => {
  const d = density(p.population, p.areaKm2);
  return {
    plaka: { text: p.plateCode, sort: Number(p.plateCode) },
    il: { text: p.name, sort: p.name, href: provincePath(p.slug) },
    bolge: { text: getRegion(p.region)?.name.replace(" Bölgesi", "") ?? "", sort: p.region },
    alan: { text: p.areaCodes.map((c) => `0${c}`).join(", "), sort: Number(p.areaCodes[0]) },
    nufus: { text: p.population ? formatNumber(p.population) : "—", sort: p.population ?? 0 },
    km2: { text: p.areaKm2 ? formatNumber(p.areaKm2) : "—", sort: p.areaKm2 ?? 0 },
    yog: { text: d ? formatNumber(Math.round(d)) : "—", sort: d ?? 0 },
    ilce: { text: String(p.districtCount ?? "—"), sort: p.districtCount ?? 0 },
  };
});
const faqs = [
  { question: "Türkiye'de kaç il var?", answer: `Türkiye'de ${provinces.length} il vardır. İller 7 coğrafi bölgeye ayrılır.` },
  { question: "81 ilin nüfusu toplam kaç?", answer: `TÜİK ${POPULATION_YEAR} verilerine göre 81 ilin toplam nüfusu ${formatNumber(TOTAL_POPULATION)} kişidir.` },
  { question: "Hangi bölgede kaç il var?", answer: regions.map((r) => `${r.name}: ${provinces.filter((p) => p.region === r.slug).length}`).join(", ") + "." },
  { question: "Türkiye'nin en son kurulan ili hangisidir?", answer: "En son kurulan il, 1999'da il statüsü kazanan ve 81 plaka kodunu alan Düzce'dir." },
];
const title = `Türkiye'nin 81 İli: Plaka Kodu, Nüfus ve Alan Kodu Listesi (${POPULATION_YEAR})`;
const description = `81 ilin tam listesi: plaka kodu, telefon alan kodu, bölge, TÜİK ${POPULATION_YEAR} nüfusu, yüzölçümü, nüfus yoğunluğu ve ilçe sayısı. Sıralanabilir tablo ve Türkiye haritası.`;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  schema={[
    webPageSchema({ name: title, path, description }),
    itemListSchema(sorted.map((p) => ({ name: p.name, href: provincePath(p.slug) }))),
    faqPageSchema(faqs),
  ]}
>
  <div class="container-page pt-4 sm:pt-6">
    <Breadcrumbs items={[{ label: "İller", href: path }]} />
    <div class="mt-5 grid items-start gap-10 lg:grid-cols-2">
      <header>
        <p class="section-eyebrow">81 il · 7 bölge</p>
        <h1 class="mt-2 text-4xl leading-[1.1] sm:text-5xl">Türkiye'nin 81 ili</h1>
        <p class="answer-box mt-6">
          Türkiye {provinces.length} ilden oluşur. TÜİK {POPULATION_YEAR} verilerine göre
          toplam nüfus {formatNumber(TOTAL_POPULATION)} kişidir. Aşağıdaki tabloda her
          ilin plaka kodu, alan kodu, nüfusu, yüzölçümü ve ilçe sayısı yer alır;
          sütun başlıklarına dokunarak sıralayabilirsiniz.
        </p>
        <label for="il-filter" class="sr-only">İl ara</label>
        <input
          id="il-filter"
          type="search"
          placeholder="Tabloda il ara…"
          class="mt-6 h-11 w-full max-w-sm rounded-lg border border-border-strong bg-surface px-3 text-base outline-none focus:border-text-primary"
        />
      </header>
      <ProvinceMap id="iller-map" />
    </div>

    <SortableTable
      class="mt-8"
      id="iller-tablosu"
      caption="Türkiye'nin 81 ili"
      columns={[
        { key: "plaka", label: "Plaka", numeric: true },
        { key: "il", label: "İl" },
        { key: "bolge", label: "Bölge" },
        { key: "alan", label: "Alan kodu" },
        { key: "nufus", label: "Nüfus", numeric: true },
        { key: "km2", label: "km²", numeric: true },
        { key: "yog", label: "Kişi/km²", numeric: true },
        { key: "ilce", label: "İlçe", numeric: true },
      ]}
      rows={rows}
    />
    <p class="mt-2 text-xs text-text-muted">
      Kaynak: TÜİK ADNKS {POPULATION_YEAR}, Harita Genel Müdürlüğü, Türk Telekom.
      <a href="/acik-veri/" class="link">CSV / JSON indir</a>
    </p>

    <AdSlot variant="leaderboard" />

    <div class="mt-12 max-w-3xl"><FAQAccordion faqs={faqs} /></div>
  </div>
</BaseLayout>

<script>
  const input = document.getElementById("il-filter") as HTMLInputElement | null;
  const norm = (s: string) => s.toLocaleLowerCase("tr-TR");
  input?.addEventListener("input", () => {
    const q = norm(input.value.trim());
    document.querySelectorAll<HTMLTableRowElement>("#iller-tablosu tbody tr").forEach((tr) => {
      tr.hidden = Boolean(q) && !norm(tr.textContent ?? "").includes(q);
    });
  });
</script>
