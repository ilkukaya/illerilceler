---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import ProvinceMap from "@/components/geography/ProvinceMap.astro";
import FAQAccordion from "@/components/content/FAQAccordion.astro";
import Icon from "@/components/Icon.astro";
import { regions } from "@/data/regions";
import { provinces } from "@/data/provinces";
import { mountains, rivers, lakes, neighboringCountries } from "@/data/geography";
import { webPageSchema, faqPageSchema } from "@/utils/seo";
import { formatNumber } from "@/utils/format";

const path = "/egitim/";
const tools = [
  { icon: "circle-help", title: "Türkiye coğrafyası testi", text: "İller, plakalar ve coğrafya üzerine çoktan seçmeli sorular.", href: "/egitim/quiz/" },
  { icon: "layers", title: "81 il ve plakaları çalışma kartları", text: "Plakayı gör, ili tahmin et; kendini sına.", href: "/egitim/81-il-ve-plakalari/" },
  { icon: "map", title: "Dilsiz harita yerine interaktif harita", text: "Bölgeleri ve illeri harita üzerinde keşfet.", href: "/haritalar/turkiye-haritasi/" },
  { icon: "bar-chart-3", title: "Ödevler için istatistikler", text: "Nüfus, yüzölçümü ve yoğunluk sıralamaları.", href: "/istatistikler/" },
];
const faqs = [
  { question: "Türkiye'nin 7 bölgesi hangileridir?", answer: `${regions.map((r) => r.name).join(", ")}.` },
  { question: "Türkiye'nin en yüksek dağı hangisidir?", answer: "Ağrı Dağı (5.137 m)." },
  { question: "Türkiye'nin en büyük gölü hangisidir?", answer: "Van Gölü, yaklaşık 3.700 km² yüzölçümüyle Türkiye'nin en büyük gölüdür." },
  { question: "Türkiye'nin en uzun nehri hangisidir?", answer: "Tamamı Türkiye sınırları içinde kalan en uzun nehir Kızılırmak'tır (yaklaşık 1.355 km)." },
  { question: "Türkiye'nin kaç komşu ülkesi vardır?", answer: `Türkiye'nin kara sınırı bulunan 8 komşusu vardır: Yunanistan, Bulgaristan, Gürcistan, Ermenistan, Azerbaycan (Nahçıvan), İran, Irak ve Suriye.` },
];
const title = "Eğitim Köşesi: Türkiye Coğrafyası, 81 İl ve Plakaları, Test";
const description = "Öğrenciler için Türkiye coğrafyası: 81 il ve plakaları çalışma kartları, coğrafya testi, 7 bölge, dağlar, göller, nehirler ve komşu ülkeler.";
---

<BaseLayout title={title} description={description} path={path} schema={[webPageSchema({ name: title, path, description }), faqPageSchema(faqs)]}>
  <div class="container-page pt-4 sm:pt-6">
    <Breadcrumbs items={[{ label: "Eğitim", href: path }]} />
    <header class="mt-5 max-w-3xl">
      <h1 class="text-4xl leading-[1.1] sm:text-5xl">Eğitim köşesi</h1>
      <p class="mt-3 text-lg text-text-secondary">
        Türkiye coğrafyasını çalışan öğrenciler ve öğretmenler için testler, çalışma kartları ve
        ödevlerde kullanılabilecek güncel veriler.
      </p>
    </header>
    <ul class="mt-8 grid gap-3 sm:grid-cols-2">
      {tools.map((t) => (
        <li>
          <a href={t.href} class="card card-hover flex h-full items-start gap-4 p-5">
            <Icon name={t.icon} size={22} class="mt-0.5 shrink-0 text-brand-primary" />
            <span><span class="block font-semibold">{t.title}</span><span class="mt-0.5 block text-sm text-text-secondary">{t.text}</span></span>
          </a>
        </li>
      ))}
    </ul>

    <section class="mt-14 grid items-start gap-10 lg:grid-cols-2">
      <div>
        <h2 class="text-2xl sm:text-3xl">Türkiye'nin 7 coğrafi bölgesi</h2>
        <ul class="mt-4 space-y-3">
          {regions.map((r) => (
            <li class="border-b border-border pb-3">
              <p class="flex items-center gap-2 font-semibold"><span class="h-3 w-3 rounded-sm" style={`background:${r.color}`}></span>{r.name} <span class="text-sm font-normal text-text-muted">· {provinces.filter((p) => p.region === r.slug).length} il</span></p>
              <p class="mt-1 text-sm text-text-secondary">{r.shortDescription}</p>
            </li>
          ))}
        </ul>
      </div>
      <ProvinceMap controls={false} id="egitim-map" />
    </section>

    <section class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {[
        { t: "Dağlar", items: [...mountains].sort((x, y) => y.elevationM - x.elevationM).map((m) => `${m.name} — ${formatNumber(m.elevationM)} m (${m.location})`) },
        { t: "Nehirler (toplam uzunluk)", items: rivers.map((r) => `${r.name} — ${formatNumber(r.lengthKm)} km`) },
        { t: "Göller", items: lakes.map((l) => `${l.name} — ${formatNumber(l.areaKm2)} km² (${l.location})`) },
        { t: "Komşu ülkeler", items: neighboringCountries },
      ].map((b) => (
        <div>
          <h2 class="font-sans text-base font-semibold">{b.t}</h2>
          <ul class="mt-2 space-y-1 text-sm text-text-secondary">
            {b.items.map((it) => <li>{it}</li>)}
          </ul>
        </div>
      ))}
    </section>

    <div class="mt-14 max-w-3xl"><FAQAccordion faqs={faqs} /></div>
  </div>
</BaseLayout>
