---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageContainer from "@/components/layout/PageContainer.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import Icon from "@/components/Icon.astro";
import { provinces } from "@/data/provinces";

const path = "/egitim/81-il-ve-plakalari/";
const sorted = [...provinces].sort((a, b) =>
  a.plateCode.localeCompare(b.plateCode),
);
---

<BaseLayout
  title="81 İl ve Plakaları — Eğitim Köşesi"
  description="Türkiye'nin 81 ilini ve plaka kodlarını öğren. Kartlara tıklayarak kendini test et."
  path={path}
>
  <PageContainer class="py-4">
    <Breadcrumbs
      items={[
        { label: "Eğitim", href: "/egitim/" },
        { label: "81 İl ve Plakaları", href: path },
      ]}
    />
  </PageContainer>

  <PageContainer class="pb-16">
    <h1 class="text-3xl font-extrabold text-text-primary sm:text-4xl">
      81 İl ve Plakaları
    </h1>
    <p class="prose-content mt-3 max-w-2xl">
      Türkiye'nin 81 ilini plaka koduyla eşleştirerek öğren. Kartın üzerine
      tıkla, il adını gizle veya göster; kendini test et!
    </p>

    <div class="mt-5 flex flex-wrap items-center gap-3">
      <button type="button" id="toggle-reveal-all" class="btn btn-secondary">
        <Icon name="eye-off" size={15} />
        Tümünü Gizle
      </button>
      <span class="text-xs text-text-muted"
        >Kartlara tıklayarak il adını gizleyip gösterebilirsin.</span
      >
    </div>

    <div
      class="mt-6 grid grid-cols-3 gap-2.5 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8"
      id="flashcard-grid"
    >
      {
        sorted.map((p) => (
          <button
            type="button"
            class="flashcard card card-hover flex flex-col items-center gap-1 p-3 text-center"
            data-name={p.name}
          >
            <span class="text-lg font-extrabold text-brand-primary">
              {p.plateCode}
            </span>
            <span class="flashcard-name text-xs font-semibold text-text-primary">
              {p.name}
            </span>
          </button>
        ))
      }
    </div>
  </PageContainer>
</BaseLayout>

<script>
  const toggleAllBtn = document.getElementById("toggle-reveal-all");
  const cards = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".flashcard"),
  );

  cards.forEach((card) => {
    card.addEventListener("click", () => {
      card.classList.toggle("is-hidden");
    });
  });

  let allHidden = false;
  toggleAllBtn?.addEventListener("click", () => {
    allHidden = !allHidden;
    cards.forEach((card) => card.classList.toggle("is-hidden", allHidden));
    toggleAllBtn.innerHTML = allHidden
      ? '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg> Tümünü Göster'
      : '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.7 5.1A9 9 0 0 1 21 12a1 1 0 0 1-2 0 7 7 0 0 0-7-7 1 1 0 0 1 0-2"/><path d="m2 2 20 20"/><path d="M6.6 6.6A9 9 0 0 0 3 12a1 1 0 0 0 2 0 7 7 0 0 1 1.6-4.4"/></svg> Tümünü Gizle';
  });
</script>

<style>
  .flashcard-name {
    transition: filter 0.15s ease;
  }
  .flashcard.is-hidden .flashcard-name {
    filter: blur(6px);
    user-select: none;
  }
</style>
