---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageContainer from "@/components/layout/PageContainer.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import Icon from "@/components/Icon.astro";
import { locationImageManifest } from "@/generated/locationImageManifest";
import { provinces, getProvinceBySlug } from "@/data/provinces";
import { districts } from "@/data/districts";

const path = "/gorsel-kaynaklari/";

const entries = Object.entries(locationImageManifest);
const counts = {
  realPhoto: entries.filter(([, v]) => v.type === "real-photo").length,
  aiPhoto: entries.filter(([, v]) => v.type === "ai-photorealistic").length,
  stylized: entries.filter(([, v]) => v.type === "stylized").length,
  fallback: entries.filter(([, v]) => v.type === "fallback").length,
};

const realEntries = entries
  .filter(([, v]) => v.type === "real-photo" || v.type === "ai-photorealistic")
  .map(([key, image]) => {
    const isProvince = image.locationKind === "province";
    if (isProvince) {
      const province = getProvinceBySlug(image.locationSlug);
      return { key, name: province?.name ?? image.locationSlug, href: `/iller/${image.locationSlug}/`, image };
    }
    const district = districts.find((d) => d.id === key);
    const province = getProvinceBySlug(image.provinceSlug ?? "");
    return {
      key,
      name: district ? `${district.name}, ${province?.name ?? ""}` : key,
      href: `/iller/${image.provinceSlug}/${image.locationSlug}/`,
      image,
    };
  });

const summaryStats = [
  { label: "Gerçek fotoğraf", value: counts.realPhoto, icon: "camera" },
  { label: "AI fotogerçekçi görsel", value: counts.aiPhoto, icon: "sparkles" },
  { label: "Premium stilize illüstrasyon", value: counts.stylized, icon: "palette" },
  { label: "Geçici (fallback) görsel", value: counts.fallback, icon: "clock" },
];
---

<BaseLayout
  title="Görsel Kaynakları"
  description="illerilceler.com'da il ve ilçe sayfalarında kullanılan görsellerin kaynağı, lisansı ve doğrulama durumu."
  path={path}
  noindex
>
  <PageContainer class="py-4">
    <Breadcrumbs items={[{ label: "Görsel Kaynakları", href: path }]} />
  </PageContainer>

  <PageContainer class="max-w-3xl pb-16">
    <h1 class="text-3xl font-extrabold text-text-primary">Görsel Kaynakları</h1>
    <p class="prose-content mt-4">
      İl ve ilçe sayfalarındaki görseller şu öncelik sırasına göre seçilir:
      lisansı doğrulanmış gerçek fotoğraf, kullanım hakkı bize ait gerçek
      fotoğraf, gerçek mekâna dayalı fotogerçekçi AI üretimi görsel, gerçek
      mekânın mimari ve coğrafi özelliklerine dayalı premium stilize
      illüstrasyon ve — hiçbiri yoksa — aynı ilin genel görselinden geçici bir
      uyarlama. Hiçbir görsel, gerçek bir fotoğrafmış gibi sunulmaz; her
      görselin türü aşağıdaki gibi açıkça etiketlenir.
    </p>

    <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
      {
        summaryStats.map((s) => (
          <div class="card p-3 text-center">
            <Icon name={s.icon} size={18} class="mx-auto text-brand-primary" />
            <p class="mt-1.5 text-lg font-extrabold text-text-primary">{s.value}</p>
            <p class="text-xs text-text-secondary">{s.label}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-2 text-xs text-text-muted">
      Toplam {entries.length} sayfa ({provinces.length} il, {districts.length}{" "}
      ilçe) için görsel kaydı bulunur.
    </p>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-text-primary">Gerçek ve AI Görsel Kredileri</h2>
      {
        realEntries.length === 0 ? (
          <div class="prose-content mt-3 rounded-2xl border border-border bg-surface-muted p-4 text-sm">
            <p>
              Şu anda hiçbir sayfada gerçek fotoğraf veya AI üretimi görsel
              kullanılmıyor — bu ortamda Wikimedia Commons, belediye/valilik
              arşivleri ve benzeri kaynaklara erişim mümkün olmadığı için
              lisansı doğrulanabilir bir fotoğraf indirilmedi. Tüm sayfalar
              şu an <strong>premium stilize illüstrasyon</strong> veya geçici
              bölgesel görsel kullanıyor (yukarıdaki dağılıma bakınız). Gerçek
              veya AI görsel eklendikçe kaynak, fotoğrafçı, lisans ve orijinal
              bağlantı bilgileri burada listelenecektir.
            </p>
          </div>
        ) : (
          <div class="mt-3 overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead>
                <tr class="border-b border-border text-xs text-text-muted">
                  <th class="py-2 pr-3">Sayfa</th>
                  <th class="py-2 pr-3">Tür</th>
                  <th class="py-2 pr-3">Fotoğrafçı / Kaynak</th>
                  <th class="py-2 pr-3">Lisans</th>
                  <th class="py-2">Orijinal Bağlantı</th>
                </tr>
              </thead>
              <tbody>
                {realEntries.map((e) => (
                  <tr class="border-b border-border/60">
                    <td class="py-2 pr-3 font-semibold">
                      <a href={e.href} class="text-brand-primary hover:underline">
                        {e.name}
                      </a>
                    </td>
                    <td class="py-2 pr-3 text-text-secondary">
                      {e.image.type === "real-photo" ? "Gerçek fotoğraf" : "AI fotogerçekçi"}
                    </td>
                    <td class="py-2 pr-3 text-text-secondary">
                      {e.image.credit?.author ?? e.image.credit?.sourceName ?? "—"}
                    </td>
                    <td class="py-2 pr-3 text-text-secondary">{e.image.credit?.license ?? "—"}</td>
                    <td class="py-2">
                      {e.image.credit?.originalFileUrl ? (
                        <a
                          href={e.image.credit.originalFileUrl}
                          target="_blank"
                          rel="noopener noreferrer nofollow"
                          class="text-brand-primary hover:underline"
                        >
                          Kaynağa git
                        </a>
                      ) : (
                        "—"
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-text-primary">Premium Stilize İllüstrasyonlar Hakkında</h2>
      <p class="prose-content mt-3">
        Gerçek fotoğraf bulunamayan sayfalarda kullanılan illüstrasyonlar,
        rastgele üretilmiş soyut şekiller değildir: her biri o il veya ilçenin
        gerçek coğrafi ve mimari özelliklerine (kıyı, dağ, ova, tarihi doku,
        bölgesel iklim) göre seçilmiş, o özelliklere uygun sahne motifleriyle
        çizilir — örneğin İstanbul için Boğaz köprüsü ve Kız Kulesi siluetleri,
        Mardin için taş teraslı yamaç evleri, Nevşehir için peri bacaları ve
        balonlar. Bu illüstrasyonlar hiçbir zaman gerçek fotoğraf olarak
        sunulmaz.
      </p>
      <p class="prose-content mt-3">
        Henüz özel illüstrasyonu bulunmayan ilçeler, geçici olarak bağlı
        olduğu ilin görselini devralır; bu sayfalar veri modelinde{" "}
        <code class="rounded bg-surface-muted px-1.5 py-0.5 text-xs">
          fallback
        </code>{" "}
        olarak işaretlenir ve kalıcı değildir.
      </p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-text-primary">Katkıda Bulunmak İster misiniz?</h2>
      <p class="prose-content mt-3">
        Bir il veya ilçeye ait kullanım hakkına sahip olduğunuz bir fotoğrafı
        paylaşmak isterseniz{" "}
        <a href="/iletisim/" class="font-semibold text-brand-primary hover:underline">
          İletişim
        </a>{" "}
        sayfamızdan bize ulaşabilirsiniz.
      </p>
    </section>
  </PageContainer>
</BaseLayout>
