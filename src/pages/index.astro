---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProvinceMap from "@/components/geography/ProvinceMap.astro";
import QuickLookups from "@/components/search/QuickLookups.astro";
import FAQAccordion from "@/components/content/FAQAccordion.astro";
import AdSlot from "@/components/content/AdSlot.astro";
import Icon from "@/components/Icon.astro";
import { siteConfig } from "@/config/site";
import { provinces } from "@/data/provinces";
import { regions, getRegion } from "@/data/regions";
import { districts } from "@/data/districts";
import { formatNumber } from "@/utils/format";
import {
  TOTAL_POPULATION,
  POPULATION_YEAR,
  provincesByPopulation,
  provincesByArea,
  provincesByDistrictCount,
  districtsByPopulation,
  density,
  provincesByDensity,
} from "@/utils/rankings";
import { copula } from "@/utils/turkish";
import { provincePath, districtPath } from "@/utils/links";
import {
  websiteSchema,
  organizationSchema,
  faqPageSchema,
  itemListSchema,
} from "@/utils/seo";

const alphabetical = [...provinces].sort((a, b) =>
  a.name.localeCompare(b.name, "tr"),
);
const topPop = provincesByPopulation.slice(0, 10);
const topArea = provincesByArea.slice(0, 10);
const maxPop = topPop[0].population ?? 1;
const maxArea = topArea[0].areaKm2 ?? 1;
const smallestArea = provincesByArea[provincesByArea.length - 1];
const leastPop = provincesByPopulation[provincesByPopulation.length - 1];
const mostDistricts = provincesByDistrictCount[0];
const topDistrict = districtsByPopulation[0];
const topDistrictProvince = provinces.find(
  (p) => p.slug === topDistrict.provinceSlug,
)!;
const densest = provincesByDensity[0];

const faqs = [
  {
    question: "Türkiye'de kaç il var?",
    answer: `Türkiye'de ${provinces.length} il vardır. Plaka kodları 01 (Adana) ile 81 (Düzce) arasında sıralanır; en son il olan Düzce 1999'da kurulmuştur.`,
  },
  {
    question: "Türkiye'de kaç ilçe var?",
    answer: `Türkiye'de ${districts.length} ilçe bulunur. En çok ilçesi olan il ${mostDistricts.districtCount} ilçeyle ${copula(mostDistricts.name)}.`,
  },
  {
    question: "Türkiye'nin nüfusu kaç?",
    answer: `TÜİK Adrese Dayalı Nüfus Kayıt Sistemi ${POPULATION_YEAR} sonuçlarına göre Türkiye'nin nüfusu ${formatNumber(TOTAL_POPULATION)} kişidir.`,
  },
  {
    question: "Türkiye'nin en kalabalık ili hangisi?",
    answer: `${formatNumber(topPop[0].population!)} kişiyle ${copula(topPop[0].name)}. Onu ${topPop[1].name} (${formatNumber(topPop[1].population!)}) ve ${topPop[2].name} (${formatNumber(topPop[2].population!)}) izler.`,
  },
  {
    question: "Yüzölçümü en büyük il hangisi?",
    answer: `${formatNumber(topArea[0].areaKm2!)} km² ile ${copula(topArea[0].name)}. En küçük il ise ${formatNumber(smallestArea.areaKm2!)} km² ile ${copula(smallestArea.name)}.`,
  },
  {
    question: "Nüfusu en az olan il hangisi?",
    answer: `${formatNumber(leastPop.population!)} kişiyle ${copula(leastPop.name)}.`,
  },
  {
    question: "Türkiye'nin en kalabalık ilçesi hangisi?",
    answer: `${topDistrictProvince.name} iline bağlı ${topDistrict.name}, ${formatNumber(topDistrict.population!)} kişiyle Türkiye'nin en kalabalık ilçesidir.`,
  },
  {
    question: "Nüfus yoğunluğu en yüksek il hangisi?",
    answer: `Kilometrekareye yaklaşık ${formatNumber(Math.round(density(densest.population, densest.areaKm2)!))} kişiyle ${copula(densest.name)}.`,
  },
];

const guides = [
  {
    icon: "car",
    title: "Plaka kodları",
    text: "01'den 81'e tüm il plakaları",
    href: "/plaka-kodlari/",
  },
  {
    icon: "phone",
    title: "Telefon alan kodları",
    text: "0212'den 0488'e sabit hat kodları",
    href: "/alan-kodlari/",
  },
  {
    icon: "route",
    title: "İller arası mesafe",
    text: "3.240 il çifti için kuş uçuşu mesafe",
    href: "/mesafe/",
  },
  {
    icon: "bar-chart-3",
    title: "İstatistikler",
    text: "Nüfus, yüzölçümü, yoğunluk sıralamaları",
    href: "/istatistikler/",
  },
  {
    icon: "graduation-cap",
    title: "Eğitim köşesi",
    text: "81 il ve plakaları, coğrafya testi",
    href: "/egitim/",
  },
  {
    icon: "database",
    title: "Açık veri",
    text: "İl ve ilçe verileri JSON / CSV",
    href: "/acik-veri/",
  },
];
---

<BaseLayout
  title={siteConfig.title}
  description={siteConfig.description}
  path="/"
  useTemplate={false}
  schema={[
    websiteSchema(),
    organizationSchema(),
    faqPageSchema(faqs),
    itemListSchema(
      alphabetical.map((p) => ({ name: p.name, href: provincePath(p.slug) })),
    ),
  ]}
>
  <!-- Hero -->
  <section class="border-b border-border">
    <div
      class="container-page grid items-center gap-10 py-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:py-16"
    >
      <div>
        <p class="section-eyebrow">
          TÜİK {POPULATION_YEAR} verileriyle güncellendi
        </p>
        <h1
          class="mt-3 text-[2.4rem] leading-[1.08] sm:text-5xl lg:text-[3.4rem]"
        >
          Türkiye'nin 81 ili ve 973 ilçesi, tek rehberde.
        </h1>
        <p class="mt-4 max-w-xl text-lg leading-relaxed text-text-secondary">
          Nüfus, yüzölçümü, plaka ve alan kodları, komşu iller ve mesafeler —
          resmî verilerle, sade ve hızlı.
        </p>

        <form action="/arama/" method="get" class="mt-7" role="search">
          <label for="hero-search" class="sr-only">Sitede ara</label>
          <div
            class="flex items-center gap-2 rounded-xl border border-border-strong bg-surface p-1.5 pl-4 focus-within:border-text-primary"
          >
            <Icon name="search" size={20} class="shrink-0 text-text-muted" />
            <input
              id="hero-search"
              name="q"
              type="search"
              autocomplete="off"
              enterkeyhint="search"
              placeholder="İl, ilçe, plaka veya alan kodu yazın"
              class="h-11 w-full min-w-0 bg-transparent text-base outline-none placeholder:text-text-muted"
            />
            <button class="btn btn-accent shrink-0">Ara</button>
          </div>
        </form>

        <div class="mt-4">
          <QuickLookups />
        </div>
      </div>

      <div class="min-w-0">
        <ProvinceMap />
      </div>
    </div>
  </section>

  <!-- National figures -->
  <section class="border-b border-border bg-surface">
    <dl
      class="container-page tabular grid grid-cols-2 divide-border py-6 sm:grid-cols-4 sm:divide-x"
    >
      {
        [
          { k: "İl", v: String(provinces.length) },
          { k: "İlçe", v: formatNumber(districts.length) },
          {
            k: `Nüfus (${POPULATION_YEAR})`,
            v: formatNumber(TOTAL_POPULATION),
          },
          { k: "Bölge", v: String(regions.length) },
        ].map((s) => (
          <div class="px-0 py-2 sm:px-6 first:sm:pl-0">
            <dt class="text-sm text-text-muted">{s.k}</dt>
            <dd class="mt-0.5 font-serif text-3xl font-semibold">{s.v}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <div class="container-page">
    <!-- A–Z provinces -->
    <section class="mt-14" id="iller" aria-labelledby="iller-heading">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 id="iller-heading" class="text-3xl">81 il, plaka kodlarıyla</h2>
          <p class="mt-1 text-text-secondary">
            Bir ile dokunun: nüfus, ilçeler, harita ve daha fazlası.
          </p>
        </div>
        <div
          class="scrollbar-none -mx-4 flex gap-1.5 overflow-x-auto px-4 sm:mx-0 sm:flex-wrap sm:px-0"
          role="group"
          aria-label="Bölgeye göre filtrele"
        >
          <button
            type="button"
            class="region-filter pmap-mode shrink-0"
            data-region=""
            aria-pressed="true">Tümü</button
          >
          {
            regions.map((r) => (
              <button
                type="button"
                class="region-filter pmap-mode shrink-0"
                data-region={r.slug}
                aria-pressed="false"
              >
                {r.name.replace(" Bölgesi", "")}
              </button>
            ))
          }
        </div>
      </div>
      <ul
        id="province-grid"
        class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5"
      >
        {
          alphabetical.map((p) => (
            <li data-region={p.region} class="bg-surface">
              <a
                href={provincePath(p.slug)}
                class="flex h-full items-center gap-3 px-3 py-2.5 transition-colors hover:bg-surface-muted sm:px-4"
              >
                <span class="tabular w-7 shrink-0 text-sm font-semibold text-brand-primary">
                  {p.plateCode}
                </span>
                <span class="min-w-0">
                  <span class="block truncate font-medium text-text-primary">
                    {p.name}
                  </span>
                  <span class="tabular block text-xs text-text-muted">
                    {p.population ? formatNumber(p.population) : ""} ·{" "}
                    {p.districtCount} ilçe
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <AdSlot variant="leaderboard" class="mt-12" />

    <!-- Rankings -->
    <section class="mt-14 grid gap-10 lg:grid-cols-2">
      {
        [
          {
            title: "En kalabalık 10 il",
            list: topPop,
            value: (p: (typeof topPop)[number]) => p.population ?? 0,
            max: maxPop,
            fmt: (v: number) => formatNumber(v),
            href: "/istatistikler/en-kalabalik-iller/",
          },
          {
            title: "Yüzölçümü en büyük 10 il",
            list: topArea,
            value: (p: (typeof topArea)[number]) => p.areaKm2 ?? 0,
            max: maxArea,
            fmt: (v: number) => `${formatNumber(v)} km²`,
            href: "/istatistikler/yuzolcumune-gore-en-buyuk-iller/",
          },
        ].map((block) => (
          <div>
            <div class="flex items-end justify-between gap-3">
              <h2 class="text-2xl">{block.title}</h2>
              <a href={block.href} class="link text-sm">
                Tüm liste
              </a>
            </div>
            <ol class="mt-4 space-y-2">
              {block.list.map((p, i) => (
                <li>
                  <a
                    href={provincePath(p.slug)}
                    class="group grid grid-cols-[1.5rem_7rem_1fr] items-center gap-3 text-sm sm:grid-cols-[1.5rem_8rem_1fr]"
                  >
                    <span class="tabular text-text-muted">{i + 1}</span>
                    <span class="truncate font-medium group-hover:text-brand-primary">
                      {p.name}
                    </span>
                    <span class="flex items-center gap-2">
                      <span
                        class="h-2.5 rounded-sm bg-[var(--data-4)] group-hover:bg-brand-primary"
                        style={`width:${Math.max(4, (block.value(p) / block.max) * 100)}%`}
                      />
                      <span class="tabular shrink-0 text-xs text-text-secondary">
                        {block.fmt(block.value(p))}
                      </span>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </section>

    <!-- Guides -->
    <section class="mt-16" aria-labelledby="rehber-heading">
      <h2 id="rehber-heading" class="text-3xl">Rehberler ve araçlar</h2>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          guides.map((g) => (
            <li>
              <a
                href={g.href}
                class="card card-hover flex h-full items-start gap-4 p-5"
              >
                <Icon name={g.icon} size={22} class="mt-0.5 shrink-0 text-brand-primary" />
                <span>
                  <span class="block font-semibold text-text-primary">
                    {g.title}
                  </span>
                  <span class="mt-0.5 block text-sm text-text-secondary">
                    {g.text}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Quick answers -->
    <section class="mt-16 grid gap-10 lg:grid-cols-[minmax(0,1fr)_320px]">
      <FAQAccordion faqs={faqs} title="Hızlı cevaplar" id="hizli-cevaplar" />
      <aside class="space-y-4">
        <div class="card p-5">
          <p class="section-eyebrow">Bölgeler</p>
          <ul class="mt-3 space-y-2 text-sm">
            {
              regions.map((r) => (
                <li class="flex items-center justify-between gap-3">
                  <span class="inline-flex items-center gap-2">
                    <span
                      class="h-2.5 w-2.5 rounded-sm"
                      style={`background:${r.color}`}
                    />
                    {r.name}
                  </span>
                  <span class="tabular text-text-muted">
                    {provinces.filter((p) => p.region === r.slug).length} il
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="card p-5 text-sm leading-relaxed text-text-secondary">
          <p class="section-eyebrow">Veri kaynağı</p>
          <p class="mt-2">
            Nüfus verileri TÜİK Adrese Dayalı Nüfus Kayıt Sistemi {
              POPULATION_YEAR
            } sonuçlarından, yüzölçümü Harita Genel Müdürlüğü'nden alınmıştır.
          </p>
          <a href="/rehber/" class="link mt-2 inline-block">Yöntemimiz</a>
        </div>
      </aside>
    </section>

    <section class="mt-16" aria-labelledby="kalabalik-ilceler">
      <h2 id="kalabalik-ilceler" class="text-2xl">
        Türkiye'nin en kalabalık ilçeleri
      </h2>
      <ol
        class="mt-4 grid gap-x-8 gap-y-1 text-sm sm:grid-cols-2 lg:grid-cols-3"
      >
        {
          districtsByPopulation.slice(0, 15).map((d, i) => {
            const p = getRegion(
              provinces.find((x) => x.slug === d.provinceSlug)?.region ?? "",
            );
            const prov = provinces.find((x) => x.slug === d.provinceSlug);
            return (
              <li class="flex items-baseline justify-between gap-3 border-b border-border py-2">
                <a
                  href={districtPath(d.provinceSlug, d.slug)}
                  class="hover:text-brand-primary"
                  title={p?.name}
                >
                  <span class="tabular mr-2 text-text-muted">{i + 1}</span>
                  {d.name}
                  <span class="text-text-muted">, {prov?.name}</span>
                </a>
                <span class="tabular text-text-secondary">
                  {formatNumber(d.population ?? 0)}
                </span>
              </li>
            );
          })
        }
      </ol>
    </section>
  </div>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".region-filter");
  const items = document.querySelectorAll<HTMLElement>("#province-grid > li");
  buttons.forEach((btn) =>
    btn.addEventListener("click", () => {
      const r = btn.dataset.region;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      items.forEach((li) => {
        li.hidden = Boolean(r) && li.dataset.region !== r;
      });
    }),
  );

  const heroInput = document.getElementById("hero-search") as HTMLInputElement | null;
  heroInput?.addEventListener("input", () => {
    if (heroInput.value.trim().length >= 2 && window.matchMedia("(min-width: 768px)").matches) {
      window.dispatchEvent(new CustomEvent("illerilceler:open-search", { detail: heroInput.value }));
      heroInput.value = "";
    }
  });
</script>
