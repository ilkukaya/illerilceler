---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageContainer from "@/components/layout/PageContainer.astro";
import SectionHeader from "@/components/layout/SectionHeader.astro";
import SearchBox from "@/components/search/SearchBox.astro";
import SearchSuggestionChips from "@/components/search/SearchSuggestionChips.astro";
import StatCard from "@/components/cards/StatCard.astro";
import CategoryCard from "@/components/cards/CategoryCard.astro";
import QuickToolCard from "@/components/cards/QuickToolCard.astro";
import FactCard from "@/components/cards/FactCard.astro";
import TurkeyMap from "@/components/geography/TurkeyMap.astro";
import RegionLegend from "@/components/geography/RegionLegend.astro";
import EducationIllustration from "@/components/education/EducationIllustration.astro";
import AdSlot from "@/components/content/AdSlot.astro";
import Icon from "@/components/Icon.astro";
import { siteConfig } from "@/config/site";
import { homeStatCards, dailyFacts } from "@/data/geography";
import { websiteSchema, organizationSchema } from "@/utils/seo";

const heroChips = [
  { label: "47 nerenin plakası?", href: "/plaka-kodlari/47/" },
  { label: "312 nerenin kodu?", href: "/alan-kodlari/312/" },
  { label: "İstanbul ilçeleri", href: "/iller/istanbul/ilceler/" },
  { label: "Kadıköy mahalleleri", href: "/iller/istanbul/kadikoy/" },
  { label: "34718 posta kodu", href: "/posta-kodlari/34718/" },
  { label: "Türkiye'nin en büyük ili", href: "/iller/konya/" },
];

const summaryCards = [
  {
    icon: "building-2",
    label: "İl",
    value: siteConfig.stats.provinces,
    color: "blue" as const,
    href: "/iller/",
    description: "Türkiye'nin tüm illeri",
  },
  {
    icon: "map",
    label: "İlçe",
    value: siteConfig.stats.districts,
    color: "purple" as const,
    href: "/ilceler/",
    description: "Tüm ilçeler listesi",
  },
  {
    icon: "users",
    label: "Mahalle",
    value: siteConfig.stats.neighborhoods,
    color: "green" as const,
    href: "/mahalleler/",
    description: "Mahalle ve semtler",
  },
  {
    icon: "home",
    label: "Köy",
    value: siteConfig.stats.villages,
    color: "pink" as const,
    href: "/koyler/",
    description: "Köylerimiz",
  },
  {
    icon: "car",
    label: "Plaka Kodu",
    value: siteConfig.stats.plateCodes,
    color: "orange" as const,
    href: "/plaka-kodlari/",
    description: "Tüm plaka kodları",
  },
  {
    icon: "phone",
    label: "Alan Kodu",
    value: siteConfig.stats.areaCodes,
    color: "cyan" as const,
    href: "/alan-kodlari/",
    description: "Telefon alan kodları",
  },
];

const categories = [
  {
    icon: "car",
    label: "Plaka Kodları",
    href: "/plaka-kodlari/",
    color: "orange" as const,
  },
  {
    icon: "phone",
    label: "Alan Kodları",
    href: "/alan-kodlari/",
    color: "cyan" as const,
  },
  {
    icon: "mail",
    label: "Posta Kodları",
    href: "/posta-kodlari/",
    color: "pink" as const,
  },
  {
    icon: "building-2",
    label: "İller",
    href: "/iller/",
    color: "blue" as const,
  },
  {
    icon: "map",
    label: "İlçeler",
    href: "/ilceler/",
    color: "purple" as const,
  },
  {
    icon: "home",
    label: "Mahalleler",
    href: "/mahalleler/",
    color: "green" as const,
  },
  {
    icon: "tractor",
    label: "Köyler",
    href: "/koyler/",
    color: "orange" as const,
  },
  {
    icon: "compass",
    label: "Türkiye Bölgeleri",
    href: "/haritalar/turkiye-haritasi/",
    color: "blue" as const,
  },
  {
    icon: "map-pinned",
    label: "Haritalar",
    href: "/haritalar/",
    color: "purple" as const,
  },
  {
    icon: "bar-chart-3",
    label: "Nüfus İstatistikleri",
    href: "/istatistikler/en-kalabalik-iller/",
    color: "green" as const,
  },
  {
    icon: "mountain",
    label: "Rakım Bilgileri",
    href: "/istatistikler/#rakim",
    color: "cyan" as const,
  },
  {
    icon: "ruler",
    label: "Yüzölçümü",
    href: "/istatistikler/yuzolcumune-gore-en-buyuk-iller/",
    color: "pink" as const,
  },
  {
    icon: "route",
    label: "Komşu İller",
    href: "/istatistikler/#komsu-iller",
    color: "orange" as const,
  },
  {
    icon: "plane",
    label: "Havalimanları",
    href: "/rehber/#ulasim",
    color: "blue" as const,
  },
  {
    icon: "graduation-cap",
    label: "Üniversiteler",
    href: "/rehber/#universiteler",
    color: "purple" as const,
  },
];

const mostSearched = [
  {
    rank: 1,
    label: "47 nerenin plakası?",
    meta: "Mardin",
    href: "/plaka-kodlari/47/",
  },
  {
    rank: 2,
    label: "34 nerenin plakası?",
    meta: "İstanbul",
    href: "/plaka-kodlari/34/",
  },
  {
    rank: 3,
    label: "312 nerenin alan kodu?",
    meta: "Ankara",
    href: "/alan-kodlari/312/",
  },
  {
    rank: 4,
    label: "İstanbul ilçeleri",
    meta: "39 ilçe",
    href: "/iller/istanbul/ilceler/",
  },
  {
    rank: 5,
    label: "Türkiye'nin en büyük ili hangisi?",
    meta: "Konya",
    href: "/iller/konya/",
  },
  {
    rank: 6,
    label: "0212 nerenin alan kodu?",
    meta: "İstanbul Avrupa",
    href: "/alan-kodlari/212/",
  },
  {
    rank: 7,
    label: "34718 posta kodu nereye ait?",
    meta: "Kadıköy / İstanbul",
    href: "/posta-kodlari/34718/",
  },
  {
    rank: 8,
    label: "Ankara posta kodları",
    meta: "Tüm liste",
    href: "/posta-kodlari/",
  },
  {
    rank: 9,
    label: "Kadıköy mahalleleri",
    meta: "21 mahalle",
    href: "/iller/istanbul/kadikoy/",
  },
  {
    rank: 10,
    label: "Türkiye'nin en kalabalık ilçesi?",
    meta: "Çankaya",
    href: "/iller/ankara/cankaya/",
  },
];

const quickTools = [
  {
    icon: "route",
    label: "İki Şehir Arası Mesafe",
    href: "/araclar/iki-sehir-arasi-mesafe/",
    color: "blue" as const,
  },
  {
    icon: "car",
    label: "Plaka Sorgulama",
    href: "/plaka-kodlari/",
    color: "orange" as const,
  },
  {
    icon: "phone",
    label: "Alan Kodu Sorgulama",
    href: "/alan-kodlari/",
    color: "pink" as const,
  },
  {
    icon: "mail",
    label: "Posta Kodu Sorgulama",
    href: "/posta-kodlari/",
    color: "cyan" as const,
  },
  {
    icon: "users",
    label: "Nüfus Sorgulama",
    href: "/istatistikler/en-kalabalik-iller/",
    color: "green" as const,
  },
  {
    icon: "mountain",
    label: "Rakım Sorgulama",
    href: "/istatistikler/#rakim",
    color: "purple" as const,
  },
  {
    icon: "sunrise",
    label: "Güneş Doğuşu ve Batışı",
    href: "/araclar/gunes-dogusu-batisi/",
    color: "orange" as const,
  },
];

const fact = dailyFacts[0];
---

<BaseLayout
  title={siteConfig.title}
  description={siteConfig.description}
  path="/"
  schema={[websiteSchema(), organizationSchema()]}
  useTemplate={false}
>
  <!-- Hero -->
  <section
    class="relative overflow-hidden border-b border-border bg-gradient-to-b from-brand-sky to-background"
  >
    <div
      class="pointer-events-none absolute right-6 top-6 hidden opacity-80 sm:block"
      aria-hidden="true"
    >
      <svg
        width="34"
        height="23"
        viewBox="0 0 34 23"
        class="rounded-sm shadow-sm"
      >
        <rect width="34" height="23" fill="#E30A17"></rect>
        <circle cx="13" cy="11.5" r="6" fill="#fff"></circle>
        <circle cx="14.6" cy="11.5" r="4.8" fill="#E30A17"></circle>
        <text
          x="21.5"
          y="14.7"
          font-size="7"
          fill="#fff"
          font-family="Arial, sans-serif">★</text
        >
      </svg>
    </div>
    <PageContainer class="relative py-12 sm:py-16 lg:py-20">
      <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2">
        <div>
          <h1
            class="text-4xl font-extrabold leading-[1.08] tracking-tight text-text-primary sm:text-5xl lg:text-[52px]"
          >
            Türkiye hakkında aradığın <span class="text-brand-primary"
              >her bilgi</span
            > tek yerde!
          </h1>
          <p class="prose-content mt-4 max-w-lg text-base sm:text-lg">
            Plakadan posta koduna, nüfustan rakıma, ilçelerden mahallelere kadar
            tüm bilgiler.
          </p>
          <SearchBox class="mt-7" />
          <SearchSuggestionChips items={heroChips} class="mt-4" />
        </div>
        <div class="relative hidden lg:block">
          <div class="overflow-hidden rounded-3xl shadow-popover">
            <svg
              viewBox="0 0 640 420"
              class="h-full w-full"
              role="img"
              aria-label="Boğaz ve Kız Kulesi'ni betimleyen illüstrasyon"
            >
              <defs>
                <linearGradient id="hero-sky" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#BFE0FF"></stop>
                  <stop offset="100%" stop-color="#EAF4FF"></stop>
                </linearGradient>
                <linearGradient id="hero-sea" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#3B82F6"></stop>
                  <stop offset="100%" stop-color="#1D4ED8"></stop>
                </linearGradient>
              </defs>
              <rect width="640" height="420" fill="url(#hero-sky)"></rect>
              <circle cx="500" cy="90" r="46" fill="#FFF4E6" opacity="0.9"
              ></circle>
              <path
                d="M0 210 Q160 170 320 205 T640 200 V420 H0 Z"
                fill="#93C5FD"
                opacity="0.5"></path>
              <path
                d="M0 250 Q160 220 320 245 T640 240 V420 H0 Z"
                fill="url(#hero-sea)"></path>
              <rect
                x="60"
                y="150"
                width="10"
                height="90"
                fill="#475569"
                opacity="0.55"></rect>
              <rect
                x="560"
                y="140"
                width="10"
                height="100"
                fill="#475569"
                opacity="0.55"></rect>
              <path
                d="M20 165 C 120 105, 500 105, 610 165"
                fill="none"
                stroke="#475569"
                stroke-width="6"
                opacity="0.55"
                stroke-linecap="round"></path>
              <!-- Kız Kulesi (Maiden's Tower) on a small islet -->
              <g transform="translate(330 172)">
                <ellipse
                  cx="0"
                  cy="80"
                  rx="32"
                  ry="9"
                  fill="#1E3A5F"
                  opacity="0.35"></ellipse>
                <path d="M-14 78 L-11 22 L11 22 L14 78 Z" fill="#64748B"></path>
                <rect
                  x="-4.5"
                  y="46"
                  width="9"
                  height="13"
                  rx="1.5"
                  fill="#1E293B"
                  opacity="0.55"></rect>
                <path d="M-17 22 L0 -8 L17 22 Z" fill="#B91C1C" opacity="0.88"
                ></path>
                <line
                  x1="0"
                  y1="-8"
                  x2="0"
                  y2="-25"
                  stroke="#334155"
                  stroke-width="1.5"></line>
                <path d="M0 -25 L11 -20 L0 -16 Z" fill="#EF4444"></path>
              </g>
              <!-- hot air balloons floating above the bridge -->
              <g opacity="0.9">
                <ellipse cx="128" cy="66" rx="19" ry="25" fill="#F04438"
                ></ellipse>
                <path
                  d="M111 74 Q128 84 145 74"
                  fill="none"
                  stroke="#17214A"
                  stroke-width="1.5"
                  opacity="0.5"></path>
                <rect
                  x="123"
                  y="94"
                  width="10"
                  height="8"
                  rx="1.5"
                  fill="#17214A"
                  opacity="0.6"></rect>
                <line
                  x1="115"
                  y1="88"
                  x2="123"
                  y2="96"
                  stroke="#17214A"
                  stroke-width="1.2"
                  opacity="0.5"></line>
                <line
                  x1="141"
                  y1="88"
                  x2="133"
                  y2="96"
                  stroke="#17214A"
                  stroke-width="1.2"
                  opacity="0.5"></line>
              </g>
              <g opacity="0.85">
                <ellipse cx="235" cy="48" rx="15" ry="20" fill="#F79009"
                ></ellipse>
                <path
                  d="M222 55 Q235 63 248 55"
                  fill="none"
                  stroke="#17214A"
                  stroke-width="1.3"
                  opacity="0.5"></path>
                <rect
                  x="230.5"
                  y="75"
                  width="9"
                  height="7"
                  rx="1.3"
                  fill="#17214A"
                  opacity="0.55"></rect>
                <line
                  x1="224"
                  y1="70"
                  x2="230.5"
                  y2="76"
                  stroke="#17214A"
                  stroke-width="1"
                  opacity="0.5"></line>
                <line
                  x1="246"
                  y1="70"
                  x2="239.5"
                  y2="76"
                  stroke="#17214A"
                  stroke-width="1"
                  opacity="0.5"></line>
              </g>
            </svg>
          </div>
        </div>
      </div>

      <!-- National summary cards -->
      <div
        class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:mt-14 lg:grid-cols-6"
      >
        {summaryCards.map((c) => <StatCard {...c} />)}
      </div>
    </PageContainer>
  </section>

  <PageContainer class="py-6">
    <AdSlot variant="leaderboard" />
  </PageContainer>

  <!-- Main grid -->
  <PageContainer class="pb-16">
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
      <!-- Left: categories -->
      <aside class="lg:col-span-3 lg:order-1">
        <div class="card sticky top-32 p-3">
          <h2
            class="px-2.5 py-2 text-xs font-bold uppercase tracking-wide text-text-muted"
          >
            Kategoriler
          </h2>
          <nav aria-label="Kategoriler" class="flex flex-col gap-0.5">
            {categories.map((c) => <CategoryCard {...c} />)}
          </nav>
        </div>
      </aside>

      <!-- Center -->
      <div class="lg:col-span-6 lg:order-2 flex flex-col gap-6">
        <div class="grid grid-cols-1 gap-6 xl:grid-cols-2">
          <section class="card p-5" aria-labelledby="most-searched-heading">
            <SectionHeader
              eyebrow="Trend"
              title="En Çok Aranan"
              href="/arama/"
              as="h2"
              size="md"
            />
            <ol class="mt-4 flex flex-col gap-1">
              {
                mostSearched.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="flex items-center gap-3 rounded-xl px-2 py-2.5 hover:bg-surface-muted min-h-11"
                    >
                      <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-purple-soft text-[11px] font-bold text-brand-primary">
                        {item.rank}
                      </span>
                      <span class="min-w-0 flex-1">
                        <span class="block truncate text-sm font-semibold text-text-primary">
                          {item.label}
                        </span>
                      </span>
                      <span class="shrink-0 text-xs text-text-muted">
                        {item.meta}
                      </span>
                    </a>
                  </li>
                ))
              }
            </ol>
          </section>

          <section class="card p-5" aria-labelledby="map-heading">
            <SectionHeader
              eyebrow="Harita"
              title="Türkiye Haritası"
              href="/haritalar/turkiye-haritasi/"
              linkLabel="Bölgelere Göre Keşfet"
              as="h2"
              size="md"
            />
            <div class="mt-4">
              <TurkeyMap compact />
            </div>
            <RegionLegend class="mt-4" />
          </section>
        </div>

        <section class="card p-5" aria-labelledby="stats-heading">
          <SectionHeader
            eyebrow="Veri"
            title="İstatistiklerle Türkiye"
            href="/istatistikler/"
            as="h2"
            size="md"
          />
          <div class="mt-4 grid grid-cols-2 gap-3">
            {
              homeStatCards.map((s) => (
                <StatCard
                  icon={s.icon}
                  label={s.label}
                  value={s.value}
                  color={s.color}
                  description={s.description}
                  compact
                />
              ))
            }
          </div>
        </section>
      </div>

      <!-- Right sidebar -->
      <aside class="lg:col-span-3 lg:order-3 flex flex-col gap-6">
        <section aria-labelledby="daily-fact-heading">
          <h2 id="daily-fact-heading" class="sr-only">Günün Bilgisi</h2>
          <p class="section-eyebrow mb-2">Günün Bilgisi</p>
          <FactCard fact={fact} />
        </section>

        <section
          class="overflow-hidden rounded-2xl border border-border bg-gradient-to-br from-brand-green-soft to-brand-cyan-soft p-5"
          aria-labelledby="edu-corner-heading"
        >
          <EducationIllustration class="mx-auto h-28 w-full max-w-[220px]" />
          <h2
            id="edu-corner-heading"
            class="mt-3 text-base font-extrabold text-text-primary"
          >
            Eğitim Köşesi
          </h2>
          <p class="mt-1.5 text-sm text-text-secondary">
            Ödevlerin için aradığın tüm bilgiler burada!
          </p>
          <a href="/egitim/" class="btn btn-primary mt-4 w-full">
            Keşfet
            <Icon name="arrow-right" size={16} />
          </a>
        </section>

        <section class="card p-5" aria-labelledby="social-heading">
          <h2 id="social-heading" class="text-sm font-bold text-text-primary">
            Bizi Takip Edin
          </h2>
          <p class="mt-1 text-xs text-text-secondary">
            Güncel bilgiler ve paylaşımlar için sosyal medya hesaplarımızı takip
            edin.
          </p>
          <div class="mt-4 flex items-center gap-2">
            {
              [
                {
                  label: "Instagram",
                  icon: "instagram",
                  href: siteConfig.social.instagram,
                },
                {
                  label: "Facebook",
                  icon: "facebook",
                  href: siteConfig.social.facebook,
                },
                {
                  label: "Twitter / X",
                  icon: "twitter",
                  href: siteConfig.social.twitter,
                },
                {
                  label: "YouTube",
                  icon: "youtube",
                  href: siteConfig.social.youtube,
                },
              ].map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={s.label}
                  class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-border text-text-secondary transition-colors hover:border-brand-primary hover:text-brand-primary"
                >
                  <Icon name={s.icon} size={17} />
                </a>
              ))
            }
          </div>
        </section>
      </aside>
    </div>

    <!-- Quick tools -->
    <section class="mt-10" aria-labelledby="quick-tools-heading">
      <SectionHeader title="Hızlı Araçlar" as="h2" id="quick-tools-heading" />
      <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-7">
        {quickTools.map((tool) => <QuickToolCard {...tool} />)}
      </div>
    </section>
  </PageContainer>
</BaseLayout>
