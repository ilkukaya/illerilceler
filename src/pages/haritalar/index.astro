---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import ProvinceMap from "@/components/geography/ProvinceMap.astro";

const path = "/haritalar/";
const maps = [
  { title: "Türkiye il haritası", text: "81 il, plaka kodları ve bölgeler", href: "/haritalar/turkiye-haritasi/" },
  { title: "Nüfus haritası", text: "İllerin nüfusa göre sıralaması ve haritası", href: "/istatistikler/en-kalabalik-iller/" },
  { title: "Nüfus yoğunluğu haritası", text: "Kişi/km² değerleri ve sıralama", href: "/istatistikler/nufus-yogunluguna-gore-iller/" },
  { title: "Plaka kodları haritası", text: "Her ilin plaka kodu harita üzerinde", href: "/plaka-kodlari/" },
];
---

<BaseLayout title="Haritalar — Türkiye İl, Bölge, Nüfus ve Plaka Haritaları" description="Türkiye'nin interaktif il haritası, bölge haritası, nüfus ve nüfus yoğunluğu haritaları ile plaka kodları haritası." path={path}>
  <div class="container-page pt-4 sm:pt-6">
    <Breadcrumbs items={[{ label: "Haritalar", href: path }]} />
    <h1 class="mt-5 text-4xl leading-[1.1] sm:text-5xl">Haritalar</h1>
    <div class="mt-8 grid items-start gap-10 lg:grid-cols-[1fr_1.4fr]">
      <ul class="space-y-3">
        {maps.map((m) => (
          <li><a href={m.href} class="card card-hover block p-5"><span class="block font-semibold">{m.title}</span><span class="text-sm text-text-secondary">{m.text}</span></a></li>
        ))}
      </ul>
      <ProvinceMap id="haritalar-map" />
    </div>
  </div>
</BaseLayout>
