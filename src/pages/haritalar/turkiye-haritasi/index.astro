---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import ProvinceMap from "@/components/geography/ProvinceMap.astro";
import FAQAccordion from "@/components/content/FAQAccordion.astro";
import AdSlot from "@/components/content/AdSlot.astro";
import { provinces } from "@/data/provinces";
import { regions } from "@/data/regions";
import { provincePath } from "@/utils/links";
import { webPageSchema, faqPageSchema } from "@/utils/seo";

const path = "/haritalar/turkiye-haritasi/";
const faqs = [
  { question: "Türkiye kaç coğrafi bölgeye ayrılır?", answer: "Türkiye 1941'deki Birinci Coğrafya Kongresi'nde 7 coğrafi bölgeye ayrılmıştır: Marmara, Ege, Akdeniz, İç Anadolu, Karadeniz, Doğu Anadolu ve Güneydoğu Anadolu." },
  { question: "En çok ili olan bölge hangisidir?", answer: `${[...regions].sort((a, b) => provinces.filter((p) => p.region === b.slug).length - provinces.filter((p) => p.region === a.slug).length)[0].name}.` },
  { question: "Haritadaki il sınırları resmî mi?", answer: "Harita, il sınırlarını bilgilendirme amacıyla sadeleştirilmiş olarak gösterir. Resmî sınırlar için Harita Genel Müdürlüğü kaynaklarını esas alın." },
];
const title = "Türkiye Haritası: İller, Plakalar ve Bölgeler (İnteraktif)";
const description = "İnteraktif Türkiye il haritası: 81 il sınırı, plaka kodları, 7 coğrafi bölge, nüfus ve nüfus yoğunluğu renklendirmesi. Bir ile tıklayın, bilgilerine ulaşın.";
---

<BaseLayout title={title} description={description} path={path} schema={[webPageSchema({ name: title, path, description }), faqPageSchema(faqs)]}>
  <div class="container-page pt-4 sm:pt-6">
    <Breadcrumbs items={[{ label: "Haritalar", href: "/haritalar/" }, { label: "Türkiye haritası", href: path }]} />
    <h1 class="mt-5 text-4xl leading-[1.1] sm:text-5xl">Türkiye il haritası</h1>
    <p class="mt-3 max-w-3xl text-lg text-text-secondary">
      81 ilin sınırları ve plaka kodları. Haritayı bölgelere, nüfusa veya nüfus yoğunluğuna göre
      renklendirin; bir ile dokunarak sayfasını açın.
    </p>
    <div class="mt-8"><ProvinceMap labels id="tr-full-map" /></div>
    <AdSlot variant="leaderboard" />
    <section class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {regions.map((r) => (
        <div>
          <h2 class="flex items-center gap-2 font-sans text-base font-semibold">
            <span class="h-3 w-3 rounded-sm" style={`background:${r.color}`}></span>{r.name}
          </h2>
          <p class="mt-1 text-sm text-text-secondary">{r.shortDescription}</p>
          <ul class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-sm">
            {provinces.filter((p) => p.region === r.slug).sort((a, b) => a.name.localeCompare(b.name, "tr")).map((p) => (
              <li><a href={provincePath(p.slug)} class="link">{p.name}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </section>
    <div class="mt-12 max-w-3xl"><FAQAccordion faqs={faqs} /></div>
  </div>
</BaseLayout>
