---
import SceneArt from "@/components/geography/SceneArt.astro";
import Icon from "@/components/Icon.astro";
import { formatNumber } from "@/utils/format";
import { getRegion } from "@/data/regions";
import type { Province } from "@/types";

interface Props {
  province: Province;
}

const { province } = Astro.props;
const region = getRegion(province.region);
const hues = ["blue", "purple", "teal", "sunset", "green"] as const;
const hue = hues[province.plateCode.charCodeAt(0) % hues.length];
---

<a
  href={`/iller/${province.slug}/`}
  class="card card-hover group flex flex-col overflow-hidden"
>
  <div class="relative h-32 w-full overflow-hidden">
    <SceneArt seed={province.slug} hue={hue} class="h-full w-full" />
    <span
      class="absolute left-3 top-3 inline-flex items-center gap-1 rounded-full bg-white/90 px-2.5 py-1 text-xs font-bold text-text-primary shadow-sm backdrop-blur"
    >
      <span class="text-brand-primary">{province.plateCode}</span>
    </span>
    {
      province.badge && (
        <span class="absolute right-3 top-3 rounded-full bg-black/40 px-2.5 py-1 text-[11px] font-semibold text-white backdrop-blur">
          {province.badge}
        </span>
      )
    }
    <span
      class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/55 to-transparent px-4 pb-2.5 pt-6 text-lg font-extrabold text-white"
    >
      {province.name}
    </span>
  </div>
  <div class="flex flex-1 flex-col gap-3 p-4">
    <div
      class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-text-secondary"
    >
      {
        region && (
          <span class="inline-flex items-center gap-1">
            <Icon name="compass" size={13} />
            {region.name}
          </span>
        )
      }
      <span class="inline-flex items-center gap-1"
        ><Icon name="phone" size={13} />0{province.areaCodes[0]}</span
      >
    </div>
    <div
      class="mt-auto grid grid-cols-2 gap-2 border-t border-border pt-3 text-sm"
    >
      <div>
        <p class="text-xs text-text-muted">Nüfus</p>
        <p class="font-bold text-text-primary">
          {province.population ? formatNumber(province.population) : "—"}
        </p>
      </div>
      <div>
        <p class="text-xs text-text-muted">İlçe Sayısı</p>
        <p class="font-bold text-text-primary">
          {province.districtCount ?? "—"}
        </p>
      </div>
    </div>
  </div>
</a>
