---
import SceneArt from "@/components/geography/SceneArt.astro";
import Icon from "@/components/Icon.astro";
import type { DailyFact } from "@/types";

interface Props {
  fact: DailyFact;
}

const { fact } = Astro.props;
---

<div class="card overflow-hidden">
  <div class="relative h-32 w-full overflow-hidden">
    <SceneArt seed={fact.slug} hue="sunset" class="h-full w-full" />
    <span
      class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/60 to-transparent px-4 pb-2.5 pt-8 text-base font-extrabold text-white"
    >
      {fact.title}
    </span>
  </div>
  <div class="p-4">
    <p
      class="inline-flex items-center gap-1 text-xs font-semibold text-brand-primary"
    >
      <Icon name="map-pin" size={13} />
      {fact.location}
    </p>
    <p class="prose-content mt-2 text-sm">{fact.excerpt}</p>
    {
      fact.href && (
        <a
          href={fact.href}
          class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-brand-primary hover:text-brand-primary-dark"
        >
          Tüm İlginç Bilgiler
          <Icon name="arrow-right" size={15} />
        </a>
      )
    }
  </div>
</div>
