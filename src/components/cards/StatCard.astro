---
import Icon from "@/components/Icon.astro";
import { accentClasses, type AccentColor } from "@/utils/colors";

interface Props {
  icon: string;
  label: string;
  value: string;
  description?: string;
  color?: AccentColor;
  href?: string;
  compact?: boolean;
}

const {
  icon,
  label,
  value,
  description,
  color = "purple",
  href,
  compact = false,
} = Astro.props;
const accent = accentClasses[color];
const Tag = href ? "a" : "div";
---

<Tag
  href={href}
  class:list={[
    "card card-hover flex items-start gap-2.5 p-3.5",
    compact ? "sm:gap-3" : "sm:gap-3.5 sm:p-5",
  ]}
>
  <span
    class:list={[
      "inline-flex shrink-0 items-center justify-center rounded-2xl",
      accent.bg,
      accent.text,
      compact ? "h-8 w-8 sm:h-9 sm:w-9" : "h-10 w-10 sm:h-11 sm:w-11",
    ]}
  >
    <Icon name={icon} size={compact ? 16 : 19} strokeWidth={2} />
  </span>
  <span class="min-w-0 flex-1">
    <span
      class:list={[
        "block break-words font-extrabold leading-tight text-text-primary",
        compact ? "text-base sm:text-lg" : "text-lg sm:text-xl md:text-2xl",
      ]}
    >
      {value}
    </span>
    <span class="block truncate text-sm font-medium text-text-secondary"
      >{label}</span
    >
    {
      description && (
        <span class="mt-0.5 block text-xs text-text-muted">{description}</span>
      )
    }
  </span>
</Tag>
