---
import Icon from "@/components/Icon.astro";

interface Props {
  label: string;
  href: string;
}

const { label, href } = Astro.props;
---

<a
  href={href}
  class="flex items-center justify-between gap-2 rounded-xl border border-border px-3.5 py-3 text-sm font-medium text-text-secondary transition-colors hover:border-brand-primary hover:text-brand-primary min-h-11"
>
  <span class="flex items-center gap-2 min-w-0">
    <Icon name="search" size={14} class="shrink-0 text-text-muted" />
    <span class="truncate">{label}</span>
  </span>
  <Icon name="arrow-up-right" size={14} class="shrink-0 text-text-muted" />
</a>
