---
/**
 * Card-sized thumbnail for list pages (iller, ilceler, search results…).
 * Same real→AI→stylized resolution as LocationHero, but requests the
 * smaller widths and always lazy-loads unless explicitly told it's above
 * the fold (first visible cards in a grid).
 */
import { Picture } from "astro:assets";
import LocationScene from "./LocationScene.astro";
import { resolveHeroAssetModule } from "@/generated/locationImageManifest";
import type { LocationImage } from "@/types";

interface Props {
  image: LocationImage;
  class?: string;
  priority?: boolean;
  sizes?: string;
}

const {
  image,
  class: className = "",
  priority = false,
  sizes = "(min-width: 1024px) 25vw, (min-width: 640px) 45vw, 90vw",
} = Astro.props;
const isRaster = image.type === "real-photo" || image.type === "ai-photorealistic";
const resolvedModule = isRaster ? resolveHeroAssetModule(image.hero) : undefined;
const seed =
  image.locationKind === "district" ? `${image.provinceSlug}-${image.locationSlug}` : image.locationSlug;
const objectPosition = `${image.focalPoint?.x ?? 50}% ${image.focalPoint?.y ?? 48}%`;
---

{
  resolvedModule ? (
    <Picture
      src={resolvedModule}
      formats={["avif", "webp"]}
      widths={[320, 480, 640]}
      sizes={sizes}
      alt={image.alt}
      loading={priority ? "eager" : "lazy"}
      decoding="async"
      class={`object-cover ${className}`}
      style={`object-position:${objectPosition}`}
    />
  ) : (
    <LocationScene sceneKey={image.sceneKey} seed={seed} class={className} />
  )
}
