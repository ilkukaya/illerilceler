---
import Icon from "@/components/Icon.astro";
import { regions } from "@/data/regions";
import { provinces } from "@/data/provinces";

interface Props {
  compact?: boolean;
  class?: string;
  highlightRegion?: string;
}

const { compact = false, class: className = "", highlightRegion } = Astro.props;

const provinceCounts = Object.fromEntries(
  regions.map((r) => [
    r.slug,
    provinces.filter((p) => p.region === r.slug).length,
  ]),
);

const gridAreaBySlug: Record<string, string> = {
  karadeniz: "karadeniz",
  marmara: "marmara",
  "ic-anadolu": "icanadolu",
  "dogu-anadolu": "dogu",
  ege: "ege",
  akdeniz: "akdeniz",
  "guneydogu-anadolu": "guneydogu",
};
---

<div
  class:list={["turkey-map", compact ? "turkey-map--compact" : "", className]}
>
  <div
    class="turkey-map__grid"
    role="img"
    aria-label="Türkiye'nin 7 coğrafi bölgesini gösteren şematik harita"
  >
    {
      regions.map((region) => (
        <a
          href={`/iller/?bolge=${region.slug}`}
          class:list={[
            "turkey-map__tile group",
            highlightRegion === region.slug && "turkey-map__tile--active",
          ]}
          style={`grid-area:${gridAreaBySlug[region.slug]}; --tile-color:${region.color};`}
        >
          <span class="block text-[13px] sm:text-sm font-extrabold text-white drop-shadow-sm">
            {region.name.replace(" Bölgesi", "")}
          </span>
          {!compact && (
            <span class="mt-1 hidden text-xs font-medium text-white/85 sm:block">
              {provinceCounts[region.slug]} il
            </span>
          )}
          {highlightRegion === region.slug ? (
            <Icon
              name="map-pin"
              size={20}
              class="absolute right-2.5 top-2.5 text-white drop-shadow"
            />
          ) : (
            <Icon
              name="arrow-up-right"
              size={14}
              class="absolute right-2.5 top-2.5 text-white/70 opacity-0 transition-opacity group-hover:opacity-100"
            />
          )}
        </a>
      ))
    }
  </div>
  <p class="mt-2 text-center text-[11px] text-text-muted sm:hidden">
    Şematik bölge gösterimi — bölgeye dokunarak illeri görüntüleyin.
  </p>
</div>

<style>
  .turkey-map__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-areas:
      "karadeniz karadeniz karadeniz karadeniz"
      "marmara icanadolu icanadolu dogu"
      "ege akdeniz guneydogu dogu";
    gap: 6px;
    height: 260px;
  }

  .turkey-map--compact .turkey-map__grid {
    height: 200px;
    gap: 4px;
  }

  .turkey-map__tile {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    border-radius: 14px;
    padding: 10px 12px;
    background-color: var(--tile-color);
    background-image: linear-gradient(
      160deg,
      rgb(255 255 255 / 0.16),
      rgb(0 0 0 / 0.08)
    );
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      filter 0.15s ease;
  }

  .turkey-map__tile:hover,
  .turkey-map__tile:focus-visible {
    transform: translateY(-2px) scale(1.015);
    filter: brightness(1.06);
    box-shadow: var(--shadow-card-hover);
    z-index: 1;
  }

  .turkey-map__tile--active {
    outline: 3px solid white;
    outline-offset: -3px;
    box-shadow: var(--shadow-card-hover);
  }

  @media (prefers-reduced-motion: reduce) {
    .turkey-map__tile {
      transition: none;
    }
  }
</style>
