---
/**
 * Reusable abstract gradient illustration used as a stand-in for
 * photography across hero banners and card thumbnails (no licensed photo
 * assets in this build — see README "Görseller"). Deterministic per
 * `seed` so the same place always renders the same scene.
 */
interface Props {
  seed?: string;
  hue?: "blue" | "purple" | "teal" | "sunset" | "green";
  class?: string;
}

const { seed = "default", hue = "blue", class: className = "" } = Astro.props;

let hash = 0;
for (let i = 0; i < seed.length; i++)
  hash = (hash * 31 + seed.charCodeAt(i)) >>> 0;

const palettes: Record<string, [string, string, string]> = {
  blue: ["#3B82F6", "#635BFF", "#0B1E4D"],
  purple: ["#7C6CF2", "#4F46E5", "#1D1B4B"],
  teal: ["#0AA8CB", "#3B82F6", "#0B2A3D"],
  sunset: ["#F79009", "#EE46BC", "#3A1550"],
  green: ["#12B76A", "#0AA8CB", "#0B2A26"],
};

const [c1, c2, c3] = palettes[hue];
const uid = `${hue}-${hash.toString(36)}`;
const peakCount = 3 + (hash % 3);
const buildings = Array.from({ length: 7 }, (_, i) => {
  const h = 20 + ((hash >> i) % 60);
  return h;
});
---

<svg
  viewBox="0 0 640 360"
  preserveAspectRatio="xMidYMax slice"
  class={className}
  role="img"
  aria-hidden="true"
>
  <defs>
    <linearGradient id={`sky-${uid}`} x1="0" y1="0" x2="0.3" y2="1">
      <stop offset="0%" stop-color={c1} stop-opacity="0.9"></stop>
      <stop offset="100%" stop-color={c3}></stop>
    </linearGradient>
    <linearGradient id={`hill-${uid}`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color={c2}></stop>
      <stop offset="100%" stop-color={c1}></stop>
    </linearGradient>
  </defs>
  <rect width="640" height="360" fill={`url(#sky-${uid})`}></rect>
  <circle cx={120 + (hash % 380)} cy="90" r="46" fill="#fff" opacity="0.16"
  ></circle>
  <circle cx={120 + (hash % 380)} cy="90" r="26" fill="#fff" opacity="0.35"
  ></circle>

  {
    Array.from({ length: peakCount }).map((_, i) => {
      const w = 640 / peakCount;
      const baseY = 260 + (i % 2) * 20;
      return (
        <path
          d={`M${i * w - 40} 360 L${i * w + w * 0.5} ${baseY} L${i * w + w + 40} 360 Z`}
          fill={`url(#hill-${uid})`}
          opacity={0.5 + i * 0.12}
        />
      );
    })
  }

  <rect x="0" y="300" width="640" height="60" fill={c3} opacity="0.85"></rect>
  {
    buildings.map((h, i) => (
      <rect
        x={20 + i * 88}
        y={300 - h}
        width="46"
        height={h + 60}
        rx="4"
        fill={c3}
        opacity="0.95"
      />
    ))
  }
  <rect x="0" y="336" width="640" height="24" fill={c3}></rect>
</svg>
