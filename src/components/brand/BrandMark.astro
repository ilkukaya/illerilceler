---
/** Brand mark: a red tile with a white location ring — reads at 16px favicons too. */
interface Props {
  size?: number;
  class?: string;
}

const { size = 28, class: className = "" } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  class={`shrink-0 ${className}`}
  aria-hidden="true"
>
  <rect width="32" height="32" rx="7" fill="var(--brand-primary)"></rect>
  <circle cx="16" cy="16" r="7.5" fill="none" stroke="#fff" stroke-width="3"
  ></circle>
  <circle cx="16" cy="16" r="2.6" fill="#fff"></circle>
</svg>
