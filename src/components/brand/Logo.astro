---
import BrandMark from "./BrandMark.astro";

interface Props {
  size?: "sm" | "md" | "lg";
  class?: string;
}

const { size = "md", class: className = "" } = Astro.props;

const markSize = size === "sm" ? 24 : size === "lg" ? 34 : 28;
const textSize =
  size === "sm" ? "text-[17px]" : size === "lg" ? "text-2xl" : "text-[19px]";
---

<a
  href="/"
  class={`inline-flex items-center gap-2 ${className}`}
  aria-label="İller İlçeler — ana sayfa"
>
  <BrandMark size={markSize} />
  <span
    class={`font-serif font-semibold tracking-tight text-text-primary ${textSize}`}
  >
    İller İlçeler
  </span>
</a>
