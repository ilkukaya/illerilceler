---
import EducationIllustration from "@/components/education/EducationIllustration.astro";
import SearchBox from "@/components/search/SearchBox.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Eğitim Köşesi",
  description = "Öğrenciler için eğlenceli ve öğretici içerikler: konu anlatımları, testler ve etkinlikler burada!",
} = Astro.props;
---

<section
  class="overflow-hidden rounded-3xl border border-border bg-gradient-to-br from-brand-lavender to-brand-sky"
>
  <div
    class="grid grid-cols-1 items-center gap-6 p-6 sm:p-10 lg:grid-cols-2 lg:gap-10"
  >
    <div>
      <p class="section-eyebrow">Eğitim</p>
      <h1
        class="mt-2 text-3xl font-extrabold tracking-tight text-text-primary sm:text-4xl"
      >
        {title}
      </h1>
      <p class="prose-content mt-3 max-w-md text-[15px]">{description}</p>
      <SearchBox
        size="md"
        class="mt-6 max-w-md"
        placeholder="Konu, il veya etkinlik ara..."
      />
    </div>
    <EducationIllustration class="mx-auto w-full max-w-sm" />
  </div>
</section>
