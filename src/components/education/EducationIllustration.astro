---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<svg
  viewBox="0 0 400 300"
  class={className}
  role="img"
  aria-label="Kitap, kalem ve yıldızlarla eğitim illüstrasyonu"
>
  <defs>
    <linearGradient id="edu-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#F5F1FF"></stop>
      <stop offset="100%" stop-color="#EAF4FF"></stop>
    </linearGradient>
  </defs>
  <rect width="400" height="300" rx="24" fill="url(#edu-sky)"></rect>
  <circle cx="335" cy="55" r="26" fill="#FFF4E6"></circle>
  <circle cx="335" cy="55" r="14" fill="#F79009" opacity="0.85"></circle>
  <g opacity="0.7" fill="#7C6CF2">
    <circle cx="55" cy="50" r="4"></circle>
    <circle cx="90" cy="35" r="3"></circle>
    <circle cx="75" cy="75" r="3"></circle>
  </g>
  <ellipse cx="200" cy="255" rx="140" ry="16" fill="#635BFF" opacity="0.08"
  ></ellipse>
  <g transform="translate(120 140)">
    <rect x="0" y="40" width="160" height="18" rx="4" fill="#635BFF"></rect>
    <path
      d="M0 40 C 0 20 30 10 80 10 C 130 10 160 20 160 40 L160 46 C160 30 130 22 80 22 C30 22 0 30 0 46 Z"
      fill="#7C6CF2"></path>
    <rect x="4" y="8" width="72" height="34" rx="4" fill="#ffffff"></rect>
    <rect x="84" y="8" width="72" height="34" rx="4" fill="#ffffff"></rect>
    <line x1="80" y1="8" x2="80" y2="42" stroke="#D8DDE8" stroke-width="2"
    ></line>
    <line
      x1="14"
      y1="18"
      x2="66"
      y2="18"
      stroke="#EAF4FF"
      stroke-width="3"
      stroke-linecap="round"></line>
    <line
      x1="14"
      y1="26"
      x2="58"
      y2="26"
      stroke="#EAF4FF"
      stroke-width="3"
      stroke-linecap="round"></line>
    <line
      x1="94"
      y1="18"
      x2="146"
      y2="18"
      stroke="#EAF4FF"
      stroke-width="3"
      stroke-linecap="round"></line>
    <line
      x1="94"
      y1="26"
      x2="138"
      y2="26"
      stroke="#EAF4FF"
      stroke-width="3"
      stroke-linecap="round"></line>
  </g>
  <g transform="translate(60 90) rotate(-18)">
    <rect x="0" y="0" width="10" height="80" rx="5" fill="#F79009"></rect>
    <path d="M0 80 L10 80 L5 96 Z" fill="#17214A"></path>
    <rect x="-1" y="-6" width="12" height="10" rx="2" fill="#EE46BC"></rect>
  </g>
  <g transform="translate(288 150) rotate(12)">
    <path
      d="M20 0 L26 14 L40 15 L29 24 L33 38 L20 30 L7 38 L11 24 L0 15 L14 14 Z"
      fill="#12B76A"></path>
  </g>
</svg>
