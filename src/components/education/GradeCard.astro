---
import Icon from "@/components/Icon.astro";
import { accentClasses, type AccentColor } from "@/utils/colors";

interface Props {
  icon: string;
  name: string;
  description: string;
  color?: AccentColor;
  href?: string;
}

const {
  icon,
  name,
  description,
  color = "blue",
  href = "/egitim/",
} = Astro.props;
const accent = accentClasses[color];
---

<a href={href} class="card card-hover flex flex-col gap-3 p-5">
  <span
    class:list={[
      "inline-flex h-12 w-12 items-center justify-center rounded-2xl",
      accent.bg,
      accent.text,
    ]}
  >
    <Icon name={icon} size={22} />
  </span>
  <span class="text-base font-extrabold text-text-primary">{name}</span>
  <span class="text-sm text-text-secondary">{description}</span>
</a>
