---
interface Row {
  label: string;
  value: string;
}

interface Props {
  rows: Row[];
  title?: string;
}

const { rows, title } = Astro.props;
const visibleRows = rows.filter((r) => r.value);
---

{
  visibleRows.length > 0 && (
    <div class="card overflow-hidden">
      {title && (
        <h3 class="border-b border-border px-4 py-3 text-sm font-bold text-text-primary sm:px-5">
          {title}
        </h3>
      )}
      <dl class="divide-y divide-border">
        {visibleRows.map((row) => (
          <div class="flex items-center justify-between gap-4 px-4 py-3 text-sm sm:px-5">
            <dt class="text-text-secondary">{row.label}</dt>
            <dd class="text-right font-semibold text-text-primary">
              {row.value}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  )
}
