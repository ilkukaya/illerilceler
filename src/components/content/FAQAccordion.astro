---
import type { FAQItem } from "@/types";

interface Props {
  faqs: FAQItem[];
  title?: string;
  id?: string;
}

const { faqs, title = "Sık Sorulan Sorular", id = "sss" } = Astro.props;
---

{
  faqs.length > 0 && (
    <section aria-labelledby={`${id}-heading`}>
      {title && (
        <h2
          id={`${id}-heading`}
          class="text-xl font-extrabold text-text-primary sm:text-2xl"
        >
          {title}
        </h2>
      )}
      <div class="mt-4 divide-y divide-border overflow-hidden rounded-2xl border border-border bg-surface">
        {faqs.map((faq, index) => (
          <details class="group faq-item" open={index === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-4 text-[15px] font-semibold text-text-primary marker:content-none hover:bg-surface-muted sm:px-5">
              {faq.question}
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="shrink-0 text-text-muted transition-transform duration-200 group-open:rotate-180"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <div class="px-4 pb-4 text-sm leading-relaxed text-text-secondary sm:px-5">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </section>
  )
}
