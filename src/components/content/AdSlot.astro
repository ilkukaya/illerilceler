---
/**
 * Non-intrusive ad placeholder with a fixed reserved height (no CLS once a
 * real ad network script is wired in). Swap the inner placeholder markup
 * for your ad network's slot code when ready — see README "Reklam Alanları".
 */
interface Props {
  variant?: "leaderboard" | "rectangle" | "sidebar" | "in-article";
  class?: string;
}

const { variant = "leaderboard", class: className = "" } = Astro.props;

const heights: Record<string, string> = {
  leaderboard: "min-h-[90px]",
  rectangle: "min-h-[250px] max-w-[300px] mx-auto",
  sidebar: "min-h-[400px]",
  "in-article": "min-h-[120px]",
};
---

<div
  class:list={[
    "flex w-full items-center justify-center rounded-xl border border-dashed border-border-strong bg-surface-muted text-center",
    heights[variant],
    className,
  ]}
  aria-label="Reklam alanı"
  role="complementary"
>
  <span class="px-4 text-xs font-medium text-text-muted">Reklam</span>
</div>
