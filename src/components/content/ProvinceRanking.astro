---
/**
 * Shared template for the province ranking pages under /istatistikler/.
 * One metric drives the sort order, answer box, FAQ and map colouring; the
 * full sortable table shows every metric so each page is a complete dataset.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import SortableTable from "@/components/content/SortableTable.astro";
import FAQAccordion from "@/components/content/FAQAccordion.astro";
import ProvinceMap from "@/components/geography/ProvinceMap.astro";
import AdSlot from "@/components/content/AdSlot.astro";
import { provinces } from "@/data/provinces";
import { getRegion } from "@/data/regions";
import { formatNumber } from "@/utils/format";
import { density, POPULATION_YEAR } from "@/utils/rankings";
import { provincePath } from "@/utils/links";
import { itemListSchema, webPageSchema, faqPageSchema } from "@/utils/seo";
import type { FAQItem, Province } from "@/types";

export type Metric = "population" | "area" | "density" | "elevation" | "districts";

interface Props {
  metric: Metric;
  path: string;
  title: string;
  h1: string;
  description: string;
  intro: string;
  faqs: FAQItem[];
  ascending?: boolean;
}

const { metric, path, title, h1, description, intro, faqs, ascending = false } = Astro.props;

const value: Record<Metric, (p: Province) => number> = {
  population: (p) => p.population ?? 0,
  area: (p) => p.areaKm2 ?? 0,
  density: (p) => density(p.population, p.areaKm2) ?? 0,
  elevation: (p) => p.elevationM ?? 0,
  districts: (p) => p.districtCount ?? 0,
};

const ranked = [...provinces].sort((a, b) =>
  ascending ? value[metric](a) - value[metric](b) : value[metric](b) - value[metric](a),
);

const mapMode = metric === "density" ? "density" : metric === "population" ? "population" : "region";

const rows = ranked.map((p) => {
  const d = density(p.population, p.areaKm2);
  return {
    il: { text: p.name, sort: p.name, href: provincePath(p.slug) },
    plaka: { text: p.plateCode, sort: Number(p.plateCode) },
    bolge: { text: getRegion(p.region)?.name.replace(" Bölgesi", "") ?? "", sort: p.region },
    nufus: { text: p.population ? formatNumber(p.population) : "—", sort: p.population ?? 0 },
    alan: { text: p.areaKm2 ? formatNumber(p.areaKm2) : "—", sort: p.areaKm2 ?? 0 },
    yogunluk: { text: d ? formatNumber(Math.round(d)) : "—", sort: d ?? 0 },
    rakim: { text: p.elevationM !== undefined ? formatNumber(p.elevationM) : "—", sort: p.elevationM ?? 0 },
    ilce: { text: String(p.districtCount ?? "—"), sort: p.districtCount ?? 0 },
  };
});
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  schema={[
    webPageSchema({ name: h1, path, description }),
    itemListSchema(ranked.map((p) => ({ name: p.name, href: provincePath(p.slug) }))),
    faqPageSchema(faqs),
  ]}
>
  <div class="container-page pt-4 sm:pt-6">
    <Breadcrumbs
      items={[
        { label: "İstatistikler", href: "/istatistikler/" },
        { label: h1, href: path },
      ]}
    />
    <header class="mt-5 max-w-3xl">
      <p class="section-eyebrow">81 il · TÜİK {POPULATION_YEAR}</p>
      <h1 class="mt-2 text-4xl leading-[1.1] sm:text-5xl">{h1}</h1>
    </header>

    <div class="mt-6 grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <p class="answer-box h-fit">{intro}</p>
      <ProvinceMap mode={mapMode} id="rank-map" />
    </div>

    <AdSlot variant="leaderboard" />

    <SortableTable
      class="mt-8"
      id="siralama"
      rank
      caption={h1}
      columns={[
        { key: "il", label: "İl" },
        { key: "plaka", label: "Plaka", numeric: true },
        { key: "bolge", label: "Bölge" },
        { key: "nufus", label: "Nüfus", numeric: true },
        { key: "alan", label: "km²", numeric: true },
        { key: "yogunluk", label: "Kişi/km²", numeric: true },
        { key: "rakim", label: "Rakım (m)", numeric: true },
        { key: "ilce", label: "İlçe", numeric: true },
      ]}
      rows={rows}
    />
    <p class="mt-2 text-xs text-text-muted">
      Kaynak: TÜİK ADNKS {POPULATION_YEAR} (nüfus), Harita Genel Müdürlüğü
      (yüzölçümü, rakım). Veriyi <a href="/acik-veri/" class="link">JSON/CSV</a>
      olarak indirebilirsiniz.
    </p>

    <div class="mt-12 max-w-3xl">
      <FAQAccordion faqs={faqs} />
    </div>

    <nav class="mt-12 border-t border-border pt-6" aria-label="Diğer sıralamalar">
      <p class="section-eyebrow">Diğer sıralamalar</p>
      <ul class="mt-3 flex flex-wrap gap-2">
        {
          [
            ["En kalabalık iller", "/istatistikler/en-kalabalik-iller/"],
            ["Yüzölçümüne göre iller", "/istatistikler/yuzolcumune-gore-en-buyuk-iller/"],
            ["Nüfus yoğunluğuna göre iller", "/istatistikler/nufus-yogunluguna-gore-iller/"],
            ["Rakıma göre iller", "/istatistikler/rakima-gore-iller/"],
            ["En çok ilçesi olan iller", "/istatistikler/en-cok-ilcesi-olan-iller/"],
            ["En kalabalık ilçeler", "/istatistikler/en-kalabalik-ilceler/"],
          ]
            .filter(([, href]) => href !== path)
            .map(([label, href]) => (
              <li>
                <a class="pill" href={href}>
                  {label}
                </a>
              </li>
            ))
        }
      </ul>
    </nav>
  </div>
</BaseLayout>
