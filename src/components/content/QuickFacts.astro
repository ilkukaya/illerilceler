---
import Icon from "@/components/Icon.astro";

interface Fact {
  icon: string;
  label: string;
  value: string;
}

interface Props {
  title?: string;
  facts: Fact[];
}

const { title = "Hızlı Bilgiler", facts } = Astro.props;
const visible = facts.filter((f) => f.value);
---

{
  visible.length > 0 && (
    <div class="card p-4 sm:p-5">
      <h3 class="text-sm font-bold text-text-primary">{title}</h3>
      <ul class="mt-3 flex flex-col gap-3">
        {visible.map((fact) => (
          <li class="flex items-start gap-3 text-sm">
            <span class="mt-0.5 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-brand-purple-soft text-brand-primary">
              <Icon name={fact.icon} size={15} />
            </span>
            <span class="min-w-0">
              <span class="block text-text-primary">{fact.value}</span>
              <span class="block text-xs text-text-muted">{fact.label}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  )
}
