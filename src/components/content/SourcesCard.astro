---
import type { SourceRef } from "@/types";
import { dataDisclaimer } from "@/data/sources";

interface Props {
  sources?: SourceRef[];
  lastReviewed?: string;
  id?: string;
}

const { sources = [], lastReviewed, id = "kaynaklar" } = Astro.props;

const formatted = lastReviewed
  ? new Intl.DateTimeFormat("tr-TR", { dateStyle: "long" }).format(
      new Date(lastReviewed),
    )
  : undefined;
---

<section
  aria-labelledby={`${id}-heading`}
  id={id}
  class="scroll-mt-24 border-t border-border pt-6 text-sm"
>
  <h2 id={`${id}-heading`} class="font-sans text-base font-semibold">
    Kaynaklar ve yöntem
  </h2>
  {
    sources.length > 0 && (
      <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
        {sources.map((s) =>
          s.url ? (
            <li>
              <a
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                class="link"
              >
                {s.name}
              </a>
            </li>
          ) : (
            <li class="text-text-secondary">{s.name}</li>
          ),
        )}
      </ul>
    )
  }
  <p class="mt-2 max-w-3xl leading-relaxed text-text-muted">
    {dataDisclaimer}
    <a href="/rehber/" class="link ml-1">Yöntemimiz</a>
  </p>
  {
    formatted && (
      <p class="mt-1.5 text-text-muted">
        Son kontrol:{" "}
        <time datetime={lastReviewed} class="text-text-secondary">
          {formatted}
        </time>
      </p>
    )
  }
</section>
