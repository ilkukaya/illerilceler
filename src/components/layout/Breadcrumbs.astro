---
import StructuredData from "@/components/seo/StructuredData.astro";
import { breadcrumbListSchema } from "@/utils/seo";

export interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items, class: className = "" } = Astro.props;
const full = [{ label: "Ana sayfa", href: "/" }, ...items];
---

<StructuredData schema={breadcrumbListSchema(full)} />
<nav aria-label="Konum" class={`text-[13px] ${className}`}>
  <ol
    class="scrollbar-none flex items-center gap-1.5 overflow-x-auto whitespace-nowrap text-text-muted"
  >
    {
      full.map((item, index) => (
        <li class="flex items-center gap-1.5">
          {index > 0 && <span aria-hidden="true">/</span>}
          {index === full.length - 1 ? (
            <span class="text-text-secondary" aria-current="page">
              {item.label}
            </span>
          ) : (
            <a href={item.href} class="hover:text-text-primary">
              {item.label}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
