---
import StructuredData from "@/components/seo/StructuredData.astro";
import { breadcrumbListSchema } from "@/utils/seo";

export interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items, class: className = "" } = Astro.props;
const full = [{ label: "Ana Sayfa", href: "/" }, ...items];
---

<StructuredData schema={breadcrumbListSchema(full)} />
<nav aria-label="Breadcrumb" class={`text-sm ${className}`}>
  <ol class="flex flex-wrap items-center gap-1.5 text-text-secondary">
    {
      full.map((item, index) => (
        <li class="flex items-center gap-1.5">
          {index > 0 && (
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-border-strong shrink-0"
              aria-hidden="true"
            >
              <path d="m9 18 6-6-6-6" />
            </svg>
          )}
          {index === full.length - 1 ? (
            <span
              class="font-medium text-text-primary truncate max-w-[200px]"
              aria-current="page"
            >
              {item.label}
            </span>
          ) : (
            <a
              href={item.href}
              class="hover:text-brand-primary truncate max-w-[160px] transition-colors"
            >
              {item.label}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
