---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
  as?: "h2" | "h3";
  id?: string;
  size?: "md" | "lg";
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  href,
  linkLabel = "Tümünü Gör",
  as: Tag = "h2",
  id,
  size = "lg",
  class: className = "",
} = Astro.props;
---

<div class={`flex items-end justify-between gap-4 ${className}`}>
  <div class="min-w-0">
    {eyebrow && <p class="section-eyebrow mb-1.5">{eyebrow}</p>}
    <Tag
      id={id}
      class:list={[
        "font-extrabold text-text-primary tracking-tight",
        size === "lg" ? "text-xl sm:text-2xl" : "text-lg",
      ]}
    >
      {title}
    </Tag>
    {
      description && (
        <p class="mt-1.5 text-sm text-text-secondary max-w-2xl">
          {description}
        </p>
      )
    }
  </div>
  {
    href && (
      <a
        href={href}
        class="hidden sm:inline-flex shrink-0 items-center gap-1 text-sm font-semibold text-brand-primary hover:text-brand-primary-dark whitespace-nowrap"
      >
        {linkLabel}
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m9 18 6-6-6-6" />
        </svg>
      </a>
    )
  }
</div>
