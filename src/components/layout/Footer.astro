---
import Logo from "@/components/brand/Logo.astro";
import { siteConfig } from "@/config/site";
import { provinces } from "@/data/provinces";

const columns = [
  {
    title: "Rehber",
    links: [
      { label: "81 il listesi", href: "/iller/" },
      { label: "973 ilçe listesi", href: "/ilceler/" },
      { label: "Türkiye haritası", href: "/haritalar/turkiye-haritasi/" },
      { label: "İller arası mesafe", href: "/mesafe/" },
      { label: "İstatistikler", href: "/istatistikler/" },
    ],
  },
  {
    title: "Kodlar",
    links: [
      { label: "Plaka kodları", href: "/plaka-kodlari/" },
      { label: "Telefon alan kodları", href: "/alan-kodlari/" },
      { label: "Posta kodları", href: "/posta-kodlari/" },
      { label: "Açık veri (JSON/CSV)", href: "/acik-veri/" },
    ],
  },
  {
    title: "Öğren",
    links: [
      { label: "Eğitim köşesi", href: "/egitim/" },
      { label: "81 il ve plakaları", href: "/egitim/81-il-ve-plakalari/" },
      { label: "Coğrafya testi", href: "/egitim/quiz/" },
      { label: "Araçlar", href: "/araclar/" },
    ],
  },
  {
    title: "Kurumsal",
    links: [
      { label: "Hakkımızda", href: "/hakkimizda/" },
      { label: "Veri kaynakları ve yöntem", href: "/rehber/" },
      { label: "İletişim", href: "/iletisim/" },
      { label: "Gizlilik", href: "/gizlilik/" },
      { label: "Çerez politikası", href: "/cerez-politikasi/" },
      { label: "Kullanım koşulları", href: "/kullanim-kosullari/" },
    ],
  },
];

const alphabetical = [...provinces].sort((a, b) =>
  a.name.localeCompare(b.name, "tr"),
);
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-border bg-surface">
  <div class="container-page py-10 lg:py-12">
    <div class="grid gap-10 lg:grid-cols-[1.2fr_2fr]">
      <div>
        <Logo size="md" />
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-text-secondary">
          Türkiye'nin 81 ili ve 973 ilçesi için TÜİK ve resmî kurum
          verilerine dayanan, bağımsız bilgi rehberi.
        </p>
        <button
          type="button"
          id="cookie-settings-open"
          class="mt-4 text-sm text-text-secondary underline underline-offset-4 hover:text-text-primary"
        >
          Çerez tercihleri
        </button>
      </div>
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
        {
          columns.map((col) => (
            <div>
              <h2 class="font-sans text-sm font-semibold text-text-primary">
                {col.title}
              </h2>
              <ul class="mt-3 space-y-2">
                {col.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-sm text-text-secondary hover:text-text-primary"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-10 border-t border-border pt-8">
      <h2 class="font-sans text-sm font-semibold text-text-primary">
        81 il — plaka kodlarıyla
      </h2>
      <ul
        class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1.5 text-sm sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8"
      >
        {
          alphabetical.map((p) => (
            <li>
              <a
                href={`/iller/${p.slug}/`}
                class="text-text-secondary hover:text-text-primary"
              >
                <span class="tabular mr-1 text-text-muted">{p.plateCode}</span>
                {p.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div
      class="mt-10 flex flex-col gap-2 border-t border-border pt-6 text-xs leading-relaxed text-text-muted sm:flex-row sm:justify-between"
    >
      <p>© {year} {siteConfig.name}. {siteConfig.disclaimer}</p>
      <p class="shrink-0">Nüfus: TÜİK ADNKS 2025 · Yüzölçümü: HGM</p>
    </div>
  </div>
</footer>
