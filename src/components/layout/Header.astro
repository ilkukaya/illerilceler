---
import Logo from "@/components/brand/Logo.astro";
import Icon from "@/components/Icon.astro";
import MobileMenu from "@/components/layout/MobileMenu.astro";
import GlobalSearch from "@/components/search/GlobalSearch.astro";

export const navItems = [
  { label: "Ana Sayfa", href: "/" },
  { label: "İller", href: "/iller/" },
  { label: "İlçeler", href: "/ilceler/" },
  { label: "Mahalleler", href: "/mahalleler/" },
  { label: "Köyler", href: "/koyler/" },
  { label: "Haritalar", href: "/haritalar/" },
  { label: "İstatistikler", href: "/istatistikler/" },
  { label: "Rehber", href: "/rehber/" },
  { label: "Eğitim", href: "/egitim/" },
];

const currentPath = Astro.url.pathname;
function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<header
  class="sticky top-0 z-40 border-b border-border bg-surface/85 backdrop-blur-md"
>
  <div class="container-page flex h-16 items-center justify-between gap-3">
    <Logo size="md" class="shrink-0" />

    <nav
      aria-label="Ana menü"
      class="hidden lg:flex items-center gap-0.5 text-[13px] font-semibold"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "px-2.5 py-2 rounded-lg transition-colors whitespace-nowrap",
              isActive(item.href)
                ? "text-brand-primary bg-brand-purple-soft"
                : "text-text-secondary hover:text-text-primary hover:bg-surface-muted",
            ]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1 shrink-0">
      <button
        type="button"
        id="search-trigger"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full text-text-secondary transition-colors hover:bg-surface-muted hover:text-text-primary"
        aria-label="Sitede ara"
        aria-haspopup="dialog"
      >
        <Icon name="search" size={19} />
      </button>
      <button
        type="button"
        id="favorite-toggle"
        class="hidden sm:inline-flex h-10 w-10 items-center justify-center rounded-full text-text-secondary transition-colors hover:bg-surface-muted hover:text-text-primary"
        aria-label="Bu sayfayı favorilere ekle"
        aria-pressed="false"
      >
        <Icon name="heart" size={19} />
      </button>
      <button
        type="button"
        id="theme-toggle"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full text-text-secondary transition-colors hover:bg-surface-muted hover:text-text-primary"
        aria-label="Karanlık ve aydınlık temayı değiştir"
      >
        <Icon name="sun" size={19} class="theme-icon-light" />
        <Icon name="moon" size={19} class="theme-icon-dark" />
      </button>
      <span
        class="hidden sm:inline-flex items-center rounded-full border border-border px-2.5 py-1.5 text-xs font-semibold text-text-secondary"
        aria-label="Site dili: Türkçe"
      >
        TR
      </span>
      <button
        type="button"
        id="mobile-menu-trigger"
        class="inline-flex lg:hidden h-10 w-10 items-center justify-center rounded-full text-text-secondary hover:bg-surface-muted"
        aria-label="Menüyü aç"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" size={20} />
      </button>
    </div>
  </div>
</header>

<MobileMenu navItems={navItems} />
<GlobalSearch />

<script>
  const THEME_KEY = "illerilceler-theme";

  function applyTheme(theme: string) {
    document.documentElement.dataset.theme = theme;
    localStorage.setItem(THEME_KEY, theme);
    const toggle = document.getElementById("theme-toggle");
    toggle?.setAttribute("aria-pressed", String(theme === "dark"));
  }

  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const current =
      document.documentElement.dataset.theme === "dark" ? "dark" : "light";
    applyTheme(current === "dark" ? "light" : "dark");
  });

  const favBtn = document.getElementById("favorite-toggle");
  if (favBtn) {
    const key = `illerilceler-fav-${window.location.pathname}`;
    const isFav = localStorage.getItem(key) === "1";
    favBtn.setAttribute("aria-pressed", String(isFav));
    favBtn.classList.toggle("text-brand-primary", isFav);
    favBtn.addEventListener("click", () => {
      const nowFav = favBtn.getAttribute("aria-pressed") !== "true";
      favBtn.setAttribute("aria-pressed", String(nowFav));
      favBtn.classList.toggle("text-brand-primary", nowFav);
      if (nowFav) localStorage.setItem(key, "1");
      else localStorage.removeItem(key);
    });
  }

  const menuTrigger = document.getElementById("mobile-menu-trigger");
  const mobileMenu = document.getElementById("mobile-menu");
  menuTrigger?.addEventListener("click", () => {
    const isOpen = mobileMenu?.classList.toggle("is-open");
    menuTrigger.setAttribute("aria-expanded", String(Boolean(isOpen)));
    document.body.classList.toggle("overflow-hidden", Boolean(isOpen));
  });

  const searchTrigger = document.getElementById("search-trigger");
  searchTrigger?.addEventListener("click", () => {
    window.dispatchEvent(new CustomEvent("illerilceler:open-search"));
  });
</script>
