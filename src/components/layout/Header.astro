---
import Logo from "@/components/brand/Logo.astro";
import Icon from "@/components/Icon.astro";
import MobileMenu from "@/components/layout/MobileMenu.astro";
import GlobalSearch from "@/components/search/GlobalSearch.astro";

export const navItems = [
  { label: "İller", href: "/iller/" },
  { label: "İlçeler", href: "/ilceler/" },
  { label: "Plaka Kodları", href: "/plaka-kodlari/" },
  { label: "Alan Kodları", href: "/alan-kodlari/" },
  { label: "Posta Kodları", href: "/posta-kodlari/" },
  { label: "Harita", href: "/haritalar/turkiye-haritasi/" },
  { label: "İstatistikler", href: "/istatistikler/" },
  { label: "Mesafe", href: "/mesafe/" },
];

export const secondaryNav = [
  { label: "Eğitim", href: "/egitim/" },
  { label: "Araçlar", href: "/araclar/" },
  { label: "Açık Veri", href: "/acik-veri/" },
  { label: "Hakkımızda", href: "/hakkimizda/" },
];

const currentPath = Astro.url.pathname;
function isActive(href: string) {
  return currentPath.startsWith(href);
}
---

<header
  class="sticky top-0 z-40 border-b border-border bg-background/90 backdrop-blur-md supports-[backdrop-filter]:bg-background/80"
>
  <div class="container-page flex h-14 items-center gap-4 lg:h-16">
    <Logo size="md" class="shrink-0" />

    <nav
      aria-label="Ana menü"
      class="ml-2 hidden items-center gap-0.5 text-sm font-medium xl:flex"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "relative whitespace-nowrap rounded-md px-2.5 py-2 transition-colors",
              isActive(item.href)
                ? "text-text-primary after:absolute after:inset-x-2.5 after:-bottom-[13px] after:h-0.5 after:bg-brand-primary lg:after:-bottom-[17px]"
                : "text-text-secondary hover:text-text-primary",
            ]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-1.5">
      <button
        type="button"
        id="search-trigger"
        class="hidden h-9 w-64 items-center gap-2 rounded-lg border border-border bg-surface px-3 text-sm text-text-muted transition-colors hover:border-border-strong md:inline-flex"
        aria-label="Sitede ara"
        aria-haspopup="dialog"
      >
        <Icon name="search" size={16} />
        <span>İl, ilçe veya kod ara…</span>
        <kbd
          class="ml-auto rounded border border-border px-1.5 text-[11px] font-medium"
          >/</kbd
        >
      </button>
      <button
        type="button"
        id="search-trigger-mobile"
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-text-primary hover:bg-surface-muted md:hidden"
        aria-label="Sitede ara"
        aria-haspopup="dialog"
      >
        <Icon name="search" size={20} />
      </button>
      <button
        type="button"
        id="theme-toggle"
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-text-secondary transition-colors hover:bg-surface-muted hover:text-text-primary"
        aria-label="Koyu / açık tema"
      >
        <Icon name="moon" size={18} class="theme-icon-light" />
        <Icon name="sun" size={18} class="theme-icon-dark" />
      </button>
      <button
        type="button"
        id="mobile-menu-trigger"
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-text-primary hover:bg-surface-muted xl:hidden"
        aria-label="Menüyü aç"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" size={21} />
      </button>
    </div>
  </div>
</header>

<MobileMenu navItems={navItems} secondary={secondaryNav} />
<GlobalSearch />

<script>
  const THEME_KEY = "illerilceler-theme";

  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const next =
      document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem(THEME_KEY, next);
    } catch {}
  });

  const menuTrigger = document.getElementById("mobile-menu-trigger");
  const mobileMenu = document.getElementById("mobile-menu");
  menuTrigger?.addEventListener("click", () => {
    const isOpen = mobileMenu?.classList.toggle("is-open");
    menuTrigger.setAttribute("aria-expanded", String(Boolean(isOpen)));
    document.body.classList.toggle("overflow-hidden", Boolean(isOpen));
  });

  ["search-trigger", "search-trigger-mobile"].forEach((id) =>
    document.getElementById(id)?.addEventListener("click", () => {
      window.dispatchEvent(new CustomEvent("illerilceler:open-search"));
    }),
  );
</script>
