---
import Icon from "@/components/Icon.astro";

interface NavItem {
  label: string;
  href: string;
}

interface Props {
  navItems: NavItem[];
}

const { navItems } = Astro.props;
---

<div
  id="mobile-menu"
  class="fixed inset-0 z-50 hidden lg:!hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Ana menü"
>
  <div
    id="mobile-menu-backdrop"
    class="absolute inset-0 bg-[#0B1020]/50 backdrop-blur-[2px]"
  >
  </div>
  <div
    class="absolute inset-y-0 right-0 flex w-[86%] max-w-sm flex-col bg-surface shadow-popover"
  >
    <div
      class="flex items-center justify-between border-b border-border px-5 py-4"
    >
      <span class="text-sm font-bold text-text-primary">Menü</span>
      <button
        type="button"
        id="mobile-menu-close"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full text-text-secondary hover:bg-surface-muted"
        aria-label="Menüyü kapat"
      >
        <Icon name="x" size={20} />
      </button>
    </div>
    <nav aria-label="Mobil ana menü" class="flex-1 overflow-y-auto px-3 py-4">
      <ul class="flex flex-col gap-1">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="flex items-center justify-between rounded-xl px-3.5 py-3 text-[15px] font-semibold text-text-primary hover:bg-surface-muted min-h-11"
              >
                {item.label}
                <Icon name="chevron-right" size={16} class="text-text-muted" />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="border-t border-border px-5 py-4 text-xs text-text-muted">
      <p>illerilceler.com — Türkiye Bilgi Merkezi</p>
    </div>
  </div>
</div>

<style>
  #mobile-menu.is-open {
    display: block;
  }
</style>

<script>
  const menu = document.getElementById("mobile-menu");
  const trigger = document.getElementById("mobile-menu-trigger");
  const closeBtn = document.getElementById("mobile-menu-close");
  const backdrop = document.getElementById("mobile-menu-backdrop");

  function closeMenu() {
    menu?.classList.remove("is-open");
    trigger?.setAttribute("aria-expanded", "false");
    document.body.classList.remove("overflow-hidden");
  }

  closeBtn?.addEventListener("click", closeMenu);
  backdrop?.addEventListener("click", closeMenu);
  menu
    ?.querySelectorAll("a")
    .forEach((link) => link.addEventListener("click", closeMenu));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMenu();
  });
</script>
