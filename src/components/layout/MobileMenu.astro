---
import Icon from "@/components/Icon.astro";

interface NavItem {
  label: string;
  href: string;
}

interface Props {
  navItems: NavItem[];
  secondary?: NavItem[];
}

const { navItems, secondary = [] } = Astro.props;
---

<div
  id="mobile-menu"
  class="fixed inset-0 z-50 hidden xl:!hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Menü"
>
  <div id="mobile-menu-backdrop" class="absolute inset-0 bg-black/40"></div>
  <div
    class="absolute inset-y-0 right-0 flex w-[88%] max-w-sm flex-col bg-background shadow-popover"
  >
    <div
      class="flex h-14 items-center justify-between border-b border-border px-4"
    >
      <span class="text-sm font-semibold text-text-primary">Menü</span>
      <button
        type="button"
        id="mobile-menu-close"
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-text-secondary hover:bg-surface-muted"
        aria-label="Menüyü kapat"
      >
        <Icon name="x" size={20} />
      </button>
    </div>
    <nav aria-label="Mobil menü" class="flex-1 overflow-y-auto px-2 py-3">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="flex min-h-12 items-center justify-between rounded-lg px-3 text-[16px] font-medium text-text-primary hover:bg-surface-muted"
              >
                {item.label}
                <Icon name="chevron-right" size={16} class="text-text-muted" />
              </a>
            </li>
          ))
        }
      </ul>
      {
        secondary.length > 0 && (
          <ul class="mt-3 border-t border-border pt-3">
            {secondary.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="flex min-h-11 items-center rounded-lg px-3 text-[15px] text-text-secondary hover:bg-surface-muted"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </nav>
  </div>
</div>

<style>
  #mobile-menu.is-open {
    display: block;
  }
</style>

<script>
  const menu = document.getElementById("mobile-menu");
  const trigger = document.getElementById("mobile-menu-trigger");
  const closeBtn = document.getElementById("mobile-menu-close");
  const backdrop = document.getElementById("mobile-menu-backdrop");

  function closeMenu() {
    menu?.classList.remove("is-open");
    trigger?.setAttribute("aria-expanded", "false");
    document.body.classList.remove("overflow-hidden");
  }

  closeBtn?.addEventListener("click", closeMenu);
  backdrop?.addEventListener("click", closeMenu);
  menu
    ?.querySelectorAll("a")
    .forEach((link) => link.addEventListener("click", closeMenu));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMenu();
  });
</script>
