---
interface Props {
  code: string;
  label: string;
  prefix?: string;
  class?: string;
}

const { code, label, prefix, class: className = "" } = Astro.props;
---

<div
  class:list={[
    "flex w-full max-w-[320px] flex-col items-center justify-center rounded-3xl px-6 py-8 text-center text-white",
    className,
  ]}
  style="background: linear-gradient(135deg, var(--brand-primary), var(--brand-secondary));"
>
  {prefix && <span class="text-sm font-semibold text-white/75">{prefix}</span>}
  <span class="text-5xl font-extrabold tracking-tight sm:text-6xl">{code}</span>
  <span class="mt-2 text-sm font-semibold text-white/85">{label}</span>
</div>
