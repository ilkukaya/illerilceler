---
interface Suggestion {
  label: string;
  href: string;
}

interface Props {
  label?: string;
  items: Suggestion[];
  class?: string;
}

const {
  label = "Popüler Aramalar:",
  items,
  class: className = "",
} = Astro.props;
---

<div class:list={["flex flex-wrap items-center gap-2", className]}>
  {
    label && (
      <span class="text-xs font-semibold text-text-secondary sm:text-sm">
        {label}
      </span>
    )
  }
  {
    items.map((item) => (
      <a href={item.href} class="pill !py-1.5">
        {item.label}
      </a>
    ))
  }
</div>
