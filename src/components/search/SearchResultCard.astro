---
import Icon from "@/components/Icon.astro";
import { accentClasses } from "@/utils/colors";
import type { SearchIndexEntry, SearchResultType } from "@/types";

interface Props {
  result: SearchIndexEntry;
}

const { result } = Astro.props;

const typeMeta: Record<
  SearchResultType,
  { label: string; icon: string; color: keyof typeof accentClasses }
> = {
  province: { label: "İl", icon: "building-2", color: "blue" },
  district: { label: "İlçe", icon: "map", color: "purple" },
  neighborhood: { label: "Mahalle", icon: "home", color: "green" },
  plate: { label: "Plaka Kodu", icon: "car", color: "orange" },
  "area-code": { label: "Alan Kodu", icon: "phone", color: "pink" },
  "postal-code": { label: "Posta Kodu", icon: "mail", color: "cyan" },
  page: { label: "Sayfa", icon: "file-text", color: "purple" },
};

const meta = typeMeta[result.type];
const accent = accentClasses[meta.color];
---

<a href={result.href} class="card card-hover flex items-center gap-4 p-4">
  <span
    class:list={[
      "inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl",
      accent.bg,
      accent.text,
    ]}
  >
    <Icon name={meta.icon} size={20} />
  </span>
  <span class="min-w-0 flex-1">
    <span class="flex items-center gap-2">
      <span class="truncate text-[15px] font-bold text-text-primary"
        >{result.title}</span
      >
      <span
        class="shrink-0 rounded-full bg-surface-muted px-2 py-0.5 text-[11px] font-semibold text-text-muted"
        >{meta.label}</span
      >
    </span>
    {
      result.subtitle && (
        <span class="mt-0.5 block truncate text-sm text-text-secondary">
          {result.subtitle}
        </span>
      )
    }
  </span>
  <Icon name="chevron-right" size={18} class="shrink-0 text-text-muted" />
</a>
